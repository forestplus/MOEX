<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тепловая карта облигаций Мосбиржи — онлайн</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f0f0;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 1200px;
            background: #fff;
            padding: 16px;
            box-shadow: 0 2px 10px rgba(0,0,0,.1);
        }
        .nav { display: flex; gap: 8px; margin-bottom: 10px; font-size: 14px; }
        .nav a {
            padding: 4px 14px; border: 1px solid #ccc; border-radius: 16px;
            color: #333; text-decoration: none; background: #fff;
        }
        .nav a.active { background: #2e7d32; color: #fff; border-color: #2e7d32; }
        .nav a.logout { margin-left: auto; color: #777; }
        .header {
            display: flex; align-items: center; margin-bottom: 10px; font-size: 14px;
            color: #333; flex-wrap: wrap; gap: 10px;
        }
        .header select, .header button, .header input {
            padding: 4px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; background: #fff;
        }
        .header select, .header button { cursor: pointer; }
        .header input[type=search] { width: 150px; }
        .header button:hover { background: #f5f5f5; }
        .status { font-size: 12px; color: #666; }
        .status.error { color: #c00; font-weight: bold; }
        .status.ok { color: #2e7d32; }
        .status.warn { color: #b26a00; }
        .status.loading { color: #f57c00; }

        .sorts { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; align-items: center; }
        .sorts button {
            padding: 6px 12px; border: 1px solid #bbb; border-radius: 16px; background: #fff;
            font-size: 13px; cursor: pointer; color: #333;
        }
        .sorts button.active { background: #1565c0; border-color: #1565c0; color: #fff; }
        .sorts label { font-size: 13px; color: #333; display: flex; align-items: center; gap: 4px; }

        .summary {
            margin: 0 0 10px; padding: 8px 10px; background: #fafafa;
            border: 1px solid #eee; border-radius: 4px; font-size: 12px; color: #333; line-height: 1.5;
        }
        .summary .pos { color: #2e7d32; font-weight: bold; }
        .summary .neg { color: #c62828; font-weight: bold; }
        .breadth { display: flex; height: 6px; margin: 4px 0; border-radius: 3px; overflow: hidden; background: #ddd; }
        .breadth span { display: block; height: 100%; }

        .grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; background: #fff; }
        .card {
            padding: 6px 8px; display: flex; justify-content: space-between; align-items: stretch;
            min-height: 76px; color: #fff; font-size: 12px; line-height: 1.2;
            transition: background-color .3s ease, transform .1s ease, filter .1s ease;
            cursor: pointer; -webkit-tap-highlight-color: transparent;
        }
        @media (hover: hover) {
            .card:hover { transform: scale(1.02); filter: brightness(1.1); z-index: 1; }
        }
        .card:focus-visible { outline: 2px solid #1565c0; outline-offset: -2px; }
        .card-left {
            display: flex; flex-direction: column; justify-content: space-between;
            flex: 1; min-width: 0; padding-right: 6px; overflow: hidden;
        }
        .card-right {
            display: flex; flex-direction: column; justify-content: space-between;
            align-items: flex-end; text-align: right; white-space: nowrap;
        }
        .name { font-weight: bold; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .price { font-size: 11px; opacity: .95; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .change { font-size: 13px; font-weight: bold; font-variant-numeric: tabular-nums; }
        .delta { font-size: 10px; opacity: .9; font-variant-numeric: tabular-nums; }

        .block-title { font-size: 14px; font-weight: bold; color: #333; margin: 18px 0 4px; }
        .block-note { font-size: 12px; color: #666; margin: 0 0 6px; }
        .more { margin: 10px 0 0; text-align: center; }
        .more button {
            padding: 8px 18px; border: 1px solid #bbb; border-radius: 6px; background: #fff; font-size: 14px; cursor: pointer;
        }

        .bg-pos-5 { background-color: #2e7d32; }
        .bg-pos-4 { background-color: #388e3c; }
        .bg-pos-3 { background-color: #43a047; }
        .bg-pos-2 { background-color: #81c784; color: #1a1a1a; }
        .bg-pos-1 { background-color: #c8e6c9; color: #1a1a1a; }
        .bg-neg-1 { background-color: #ef9a9a; color: #1a1a1a; }
        .bg-neg-2 { background-color: #e57373; color: #1a1a1a; }
        .bg-neg-3 { background-color: #d32f2f; }
        .bg-neg-4 { background-color: #c62828; }
        .bg-neg-5 { background-color: #8e0000; }
        .bg-neutral { background-color: #9e9e9e; color: #fff; }

        /* карточка бумаги */
        .modal {
            position: fixed; inset: 0; background: rgba(0,0,0,.55);
            display: flex; align-items: flex-end; justify-content: center; z-index: 100;
        }
        .modal[hidden] { display: none; }
        .sheet {
            background: #fff; width: 100%; max-width: 560px; max-height: 92vh; overflow-y: auto;
            border-radius: 14px 14px 0 0; padding: 14px 16px 28px; -webkit-overflow-scrolling: touch;
            color: #222;
        }
        @media (min-width: 700px) { .modal { align-items: center; } .sheet { border-radius: 14px; } }
        .sheet-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
        .sheet-title { font-size: 17px; font-weight: bold; }
        .sheet-sub { font-size: 12px; color: #777; margin-top: 2px; }
        .sheet-close {
            border: none; background: #eee; border-radius: 50%; width: 34px; height: 34px;
            font-size: 18px; cursor: pointer; flex: none;
        }
        .sec { margin-top: 14px; }
        .sec h4 { margin: 0 0 6px; font-size: 12px; color: #555; text-transform: uppercase; letter-spacing: .3px; }
        .row {
            display: flex; justify-content: space-between; gap: 12px; padding: 5px 0;
            border-bottom: 1px solid #f0f0f0; font-size: 13px;
        }
        .row span:first-child { color: #666; }
        .row span:last-child { font-weight: bold; text-align: right; font-variant-numeric: tabular-nums; }
        .hist-box { border: 2px solid #f9a825; background: #fffde7; border-radius: 8px; padding: 8px 10px; }
        .note { font-size: 11px; color: #777; margin-top: 6px; line-height: 1.4; }
        .forecast-form { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
        .forecast-form input, .forecast-form select, .forecast-form button, .btn {
            padding: 6px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 13px; background: #fff;
        }
        .forecast-form input { width: 110px; }
        .btn { display: inline-block; text-decoration: none; color: #1565c0; cursor: pointer; margin: 4px 6px 0 0; }
        .btn.primary { background: #1565c0; color: #fff; border-color: #1565c0; }

        /* ---- свечной график ---- */
        .cp { margin-top: 6px; background: #fff; }
        .cp-head, .cp-tools { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
        .cp-btn {
            padding: 5px 9px; border: 1px solid #ccc; border-radius: 6px; background: #fff;
            font-size: 13px; cursor: pointer; color: #333; min-width: 34px;
        }
        .cp-btn.active { background: #1565c0; border-color: #1565c0; color: #fff; }
        .cp-stage { position: relative; width: 100%; height: 300px; background: #fff; border: 1px solid #e5e5e5; border-radius: 6px; overflow: hidden; }
        .cp-canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
        .cp-tip {
            position: absolute; top: 8px; z-index: 5; width: 172px; padding: 6px 8px; pointer-events: none;
            background: rgba(255,255,255,.86); border: 1px solid rgba(0,0,0,.18); border-radius: 6px;
            font-size: 11px; line-height: 1.45; color: #222; box-shadow: 0 2px 8px rgba(0,0,0,.12);
        }
        .cp-tip[hidden] { display: none; }
        .cp-tip b { display: block; margin-bottom: 2px; }
        .cp-tip .r { display: flex; justify-content: space-between; gap: 8px; }
        .cp-tip .up { color: #2e7d32; font-weight: bold; }
        .cp-tip .down { color: #c62828; font-weight: bold; }
        .cp.cp-full {
            position: fixed; inset: 0; z-index: 300; margin: 0; padding: 10px; display: flex; flex-direction: column;
        }
        .cp.cp-full .cp-stage { flex: 1; height: auto; min-height: 0; }

        table.dt { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 4px; }
        table.dt th { text-align: right; color: #555; font-weight: bold; padding: 4px 3px; border-bottom: 1px solid #ddd; }
        table.dt th:first-child, table.dt td:first-child { text-align: left; }
        table.dt td { text-align: right; padding: 4px 3px; border-bottom: 1px solid #f0f0f0; font-variant-numeric: tabular-nums; }
        /* ---- свечной график ---- */
        .cp { margin-top: 6px; background: #fff; }
        .cp-head, .cp-tools { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
        .cp-btn {
            padding: 5px 9px; border: 1px solid #ccc; border-radius: 6px; background: #fff;
            font-size: 13px; cursor: pointer; color: #333; min-width: 34px;
        }
        .cp-btn.active { background: #1565c0; border-color: #1565c0; color: #fff; }
        .cp-stage { position: relative; width: 100%; height: 300px; background: #fff; border: 1px solid #e5e5e5; border-radius: 6px; overflow: hidden; }
        .cp-canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
        .cp-tip {
            position: absolute; top: 8px; z-index: 5; width: 172px; padding: 6px 8px; pointer-events: none;
            background: rgba(255,255,255,.86); border: 1px solid rgba(0,0,0,.18); border-radius: 6px;
            font-size: 11px; line-height: 1.45; color: #222; box-shadow: 0 2px 8px rgba(0,0,0,.12);
        }
        .cp-tip[hidden] { display: none; }
        .cp-tip b { display: block; margin-bottom: 2px; }
        .cp-tip .r { display: flex; justify-content: space-between; gap: 8px; }
        .cp-tip .up { color: #2e7d32; font-weight: bold; }
        .cp-tip .down { color: #c62828; font-weight: bold; }
        .cp.cp-full {
            position: fixed; inset: 0; z-index: 300; margin: 0; padding: 10px; display: flex; flex-direction: column;
        }
        .cp.cp-full .cp-stage { flex: 1; height: auto; min-height: 0; }
        .sheet .pos { color: #2e7d32; font-weight: bold; }
        .sheet .neg { color: #c62828; font-weight: bold; }
        table.dt { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 4px; }
        table.dt th { text-align: right; color: #555; font-weight: bold; padding: 4px 3px; border-bottom: 1px solid #ddd; }
        table.dt th:first-child, table.dt td:first-child { text-align: left; }
        table.dt td { text-align: right; padding: 4px 3px; border-bottom: 1px solid #f0f0f0; font-variant-numeric: tabular-nums; }
        @media (max-width: 1000px) { .grid { grid-template-columns: repeat(4, 1fr); } }
        @media (max-width: 768px) {
            body { padding: 8px; }
            .grid { grid-template-columns: repeat(3, 1fr); }
            .card { min-height: 70px; padding: 5px 6px; }
            .name { font-size: 10px; }
            .price { font-size: 9px; }
            .change { font-size: 12px; }
            .delta { font-size: 9px; }
        }
        @media (max-width: 480px) { .grid { grid-template-columns: repeat(2, 1fr); } }
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="index.html" id="stocksLink">Акции</a>
        <a href="#" class="active">Облигации</a>
        <a href="news.html" id="newsLink">Новости</a>
        <a href="#" id="logoutLink" class="logout">Выйти</a>
    </div>
    <div class="header">
        <span>Изменение цены:</span>
        <select id="periodSelect">
            <option value="day">за день</option>
            <option value="week">за неделю</option>
            <option value="month">за месяц</option>
        </select>
        <button id="refreshBtn" title="Обновить сейчас">↻ Обновить</button>
        <input id="searchInput" type="search" placeholder="Поиск: название или код" autocomplete="off">
        <span id="status" class="status">Загрузка данных...</span>
    </div>
    <div class="sorts" id="sorts"></div>
    <div id="summary" class="summary" hidden></div>
    <div class="grid" id="grid"></div>
    <div class="more" id="more"></div>
    <div id="blocks"></div>
</div>

<div id="modal" class="modal" hidden>
    <div class="sheet" role="dialog" aria-modal="true">
        <div class="sheet-head">
            <div>
                <div class="sheet-title" id="modalTitle"></div>
                <div class="sheet-sub" id="modalSub"></div>
            </div>
            <button class="sheet-close" id="modalClose" aria-label="Закрыть">✕</button>
        </div>
        <div class="sec" id="modalLive"></div>
        <div class="sec" id="modalCoupons"></div>
        <div class="sec" id="modalLinks"></div>
        <div class="sec" id="modalChart"></div>
    </div>
</div>

<script>
'use strict';

/*
 * MOEX Bonds Heatmap b2 (облигации)
 *
 *  • Данные: MOEX ISS, доски TQOB (ОФЗ и гособлигации) и TQCB (корпоративные), рублёвые облигации.
 *  • Цвет плитки — изменение ЧИСТОЙ цены (% от номинала), без учёта купонов и НКД.
 *  • Сортировки: цвет, доходность, цена (% номинала), частота купонов, «надёжность», только ОФЗ.
 *  • «Надёжность» — НЕ кредитный рейтинг (его нет в открытых данных MOEX): ОФЗ → уровень листинга 1 → 2 → 3.
 *  • Нижние блоки: изменение цены за день > 1 %, за неделю > 2 %, за месяц > 4 % (константы BLOCKS).
 */

const VERSION = 'b2';
const STOCKS_PAGE = 'index.html';
const NEWS_PAGE = 'news.html';

const MOEX_ISS = 'https://iss.moex.com/iss';
const BOARDS = [
    { id: 'TQOB', label: 'ОФЗ и гособлигации' },
    { id: 'TQCB', label: 'Корпоративные' }
];

const REQUEST_INTERVAL = 30000;
const MIN_REQUEST_GAP = 2000;
const FETCH_TIMEOUT = 25000;
const FETCH_RETRIES = 2;
const START_RETRY_DELAY = 10000;
const HISTORY_RETRY_DELAY = 120000;
const MAX_BACK_DAYS = 10;
const PAGE_BATCH = 5;
const PAGE_SIZE = 120;
const BLOCK_LIMIT = 100;

const BLOCKS = [
    { key: 'day',   period: 'day',   threshold: 1, label: 'за день' },
    { key: 'week',  period: 'week',  threshold: 2, label: 'за неделю' },
    { key: 'month', period: 'month', threshold: 4, label: 'за месяц' }
];
const PERIOD_LABEL = { day: 'за день', week: 'за неделю', month: 'за месяц' };
const COLOR_SCALE = { day: 0.2, week: 0.5, month: 1 };

const SORT_BUTTONS = [
    ['color', 'Цвет'],
    ['yield', 'Доходность'],
    ['price', 'Цена, % номинала'],
    ['freq', 'Частота купонов'],
    ['rel', 'Надёжность'],
    ['mat', 'Дата погашения']
];
const SORT_DEFAULT_DIR = { color: -1, yield: -1, price: -1, freq: -1, rel: 1, mat: 1 }; // -1 убывание, +1 возрастание (для даты погашения: ↑ — раньше, ↓ — позже)

let allBonds = [];
const bondById = {};
let currentPeriod = document.getElementById('periodSelect').value || 'day';
const bases = { week: null, month: null };
const basisPromises = { week: null, month: null };
const basisFailedAt = { week: 0, month: 0 };
const blockEls = {};

let sortKey = 'color';
let sortDir = -1;
let ofzOnly = false;
let searchQuery = '';
let shown = PAGE_SIZE;

let updateTimer = null;
let retryTimer = null;
let lastRequestTime = 0;
let activeToken = null;
let periodToken = 0;
let isStarting = false;
let isInitialized = false;
let lastSnapshot = null;
let partialNote = '';

/* ---------- network ---------- */

const sleep = ms => new Promise(r => setTimeout(r, ms));

async function fetchWithTimeout(url, timeout) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);
    try {
        return await fetch(url, { cache: 'no-store', signal: controller.signal });
    } catch (e) {
        if (e && e.name === 'AbortError') throw new Error('MOEX не ответил вовремя');
        throw new Error('нет связи с MOEX (сеть или блокировка)');
    } finally {
        clearTimeout(timer);
    }
}

async function fetchJson(url, { timeout = FETCH_TIMEOUT, retries = FETCH_RETRIES } = {}) {
    let lastErr;
    for (let attempt = 1; attempt <= retries; attempt++) {
        try {
            const response = await fetchWithTimeout(url, timeout);
            if (!response.ok) {
                const err = new Error(`HTTP ${response.status}`);
                err.status = response.status;
                throw err;
            }
            try {
                return await response.json();
            } catch (_) {
                throw new Error('MOEX вернул некорректный ответ');
            }
        } catch (e) {
            lastErr = e;
            const clientErr = e.status >= 400 && e.status < 500 && e.status !== 429;
            if (clientErr || attempt === retries) break;
            await sleep(1000 * attempt);
        }
    }
    throw lastErr;
}

/* ---------- utilities ---------- */

function num(v) {
    if (v === null || v === undefined || v === '') return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
}

function mk(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    return e;
}

function setStatus(cls, text) {
    const box = document.getElementById('status');
    box.className = 'status' + (cls ? ' ' + cls : '');
    box.textContent = text;
}

function showProgress(label) {
    const t0 = Date.now();
    const tick = () => setStatus('loading', `${label}... ${Math.round((Date.now() - t0) / 1000)} с`);
    tick();
    const id = setInterval(tick, 1000);
    return () => clearInterval(id);
}

function moscowDateStr(date) {
    return new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Moscow' }).format(date);
}

function shiftDateStr(dateStr, { days = 0, months = 0 } = {}) {
    const [y, m, d] = dateStr.split('-').map(Number);
    let dt;
    if (months) {
        const total = y * 12 + (m - 1) + months;
        const ny = Math.floor(total / 12);
        const nm = total % 12;
        const lastDay = new Date(Date.UTC(ny, nm + 1, 0)).getUTCDate();
        dt = new Date(Date.UTC(ny, nm, Math.min(d, lastDay)));
    } else {
        dt = new Date(Date.UTC(y, m - 1, d));
    }
    if (days) dt.setUTCDate(dt.getUTCDate() + days);
    return dt.toISOString().slice(0, 10);
}

function humanDate(dateStr) {
    if (!dateStr) return '—';
    const [y, m, d] = String(dateStr).slice(0, 10).split('-');
    return `${d}.${m}.${y}`;
}

/* ---------- formatting ---------- */

const nfCache = {};

function nf(decimals) {
    if (!nfCache[decimals]) {
        nfCache[decimals] = new Intl.NumberFormat('ru-RU', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
        });
    }
    return nfCache[decimals];
}

function formatChange(change) {
    if (change === null || change === undefined || isNaN(change)) return '—';
    const rounded = Math.round(change * 100) / 100;
    if (rounded === 0) return '0,00 %';
    return (rounded > 0 ? '+' : '−') + nf(2).format(Math.abs(rounded)) + ' %';
}

function formatPct(v, dec = 2) {
    if (v === null || v === undefined || isNaN(v)) return '—';
    return nf(dec).format(v) + ' %';
}

function formatPunits(delta) {
    // изменение цены в процентных пунктах номинала
    if (delta === null || delta === undefined || isNaN(delta)) return '—';
    const r = Math.round(delta * 100) / 100;
    if (r === 0) return '0,00 п.п.';
    return (r > 0 ? '+' : '−') + nf(2).format(Math.abs(r)) + ' п.п.';
}

function signCls(v) {
    if (v === null || v === undefined || isNaN(v)) return '';
    const r = Math.round(v * 100) / 100;
    return r > 0 ? 'pos' : r < 0 ? 'neg' : '';
}

/* ---------- color ---------- */

function getBgClass(change, period = currentPeriod) {
    if (change === null || change === undefined || isNaN(change)) return 'bg-neutral';
    if (Math.round(change * 100) / 100 === 0) return 'bg-neutral';

    const k = COLOR_SCALE[period] || 1;
    const abs = Math.abs(change) / k;

    let level;
    if (abs >= 5) level = 5;
    else if (abs >= 2) level = 4;
    else if (abs >= 1) level = 3;
    else if (abs >= 0.5) level = 2;
    else level = 1;

    return (change > 0 ? 'bg-pos-' : 'bg-neg-') + level;
}

/* ---------- bond model ---------- */

function bondPrice(b) {
    return b.last ?? b.prevPrice ?? b.prevLegal ?? null;
}

function bondYield(b) {
    return b.yld ?? b.yieldWap ?? null;
}

function perYear(b) {
    return b.couponPeriod && b.couponPeriod > 0 ? 365 / b.couponPeriod : null;
}

function freqText(b) {
    const p = perYear(b);
    if (p === null) return 'без купона';
    const r = Math.round(p * 10) / 10;
    return `${Number.isInteger(r) ? r : nf(1).format(r)}×/год`;
}

function relScore(b) {
    if (b.isOfz) return 0;
    if (b.listLevel === 1) return 1;
    if (b.listLevel === 2) return 2;
    if (b.listLevel === 3) return 3;
    return 4;
}

function relLabel(b) {
    if (b.isOfz) return 'ОФЗ';
    return b.listLevel ? `Листинг ${b.listLevel}` : 'Листинг —';
}

function makeResult(price, base) {
    if (price === null || base === null || base === undefined || base <= 0) {
        return { price, base: null, delta: null, change: null };
    }
    const delta = price - base;
    return { price, base, delta, change: (delta / base) * 100 };
}

function basisKey(period) {
    return `${period}:${moscowDateStr(new Date())}`;
}

function basisFresh(period) {
    if (period === 'day') return true;
    const b = bases[period];
    return !!b && b.key === basisKey(period);
}

function computeFor(b, period) {
    const price = bondPrice(b);
    if (price === null) return { price: null, base: null, delta: null, change: null };
    if (period === 'day') return makeResult(price, b.prevPrice ?? b.prevLegal);
    if (!basisFresh(period)) return makeResult(price, null);
    return makeResult(price, bases[period].map[b.secid] ?? null);
}

/* ---------- snapshot ---------- */

async function fetchBoard(board) {
    const url =
        `${MOEX_ISS}/engines/stock/markets/bonds/boards/${board.id}/securities.json?iss.meta=off&iss.only=securities,marketdata` +
        `&securities.columns=SECID,SHORTNAME,SECNAME,PREVPRICE,PREVLEGALCLOSEPRICE,COUPONPERIOD,COUPONVALUE,COUPONPERCENT,NEXTCOUPON,MATDATE,FACEVALUE,FACEUNIT,LISTLEVEL,ACCRUEDINT` +
        `&marketdata.columns=SECID,LAST,WAPRICE,YIELD,YIELDATWAP,DURATION,VALTODAY,NUMTRADES,OPEN,LOW,HIGH`;

    const data = await fetchJson(url);
    const sec = data.securities;
    const md = data.marketdata;
    if (!sec || !Array.isArray(sec.data)) throw new Error(`${board.id}: пустой список`);

    const idx = cols => Object.fromEntries(cols.map((c, i) => [String(c).toUpperCase(), i]));
    const si = idx(sec.columns);
    const mi = md && md.columns ? idx(md.columns) : {};

    const map = new Map();
    sec.data.forEach(row => {
        const secid = row[si.SECID];
        if (!secid) return;
        const name = row[si.SHORTNAME] || secid;
        map.set(secid, {
            secid,
            board: board.id,
            name,
            secname: row[si.SECNAME] || null,
            isOfz: /^ОФЗ/i.test(name),
            prevPrice: num(row[si.PREVPRICE]),
            prevLegal: num(row[si.PREVLEGALCLOSEPRICE]),
            couponPeriod: num(row[si.COUPONPERIOD]),
            couponValue: num(row[si.COUPONVALUE]),
            couponPercent: num(row[si.COUPONPERCENT]),
            nextCoupon: row[si.NEXTCOUPON] || null,
            matDate: row[si.MATDATE] || null,
            faceValue: num(row[si.FACEVALUE]),
            faceUnit: row[si.FACEUNIT] || null,
            listLevel: num(row[si.LISTLEVEL]),
            last: null, waPrice: null, yld: null, yieldWap: null, duration: null,
            valToday: null, numTrades: null
        });
    });

    if (md && Array.isArray(md.data)) {
        md.data.forEach(row => {
            const b = map.get(row[mi.SECID]);
            if (!b) return;
            b.last = num(row[mi.LAST]);
            b.waPrice = num(row[mi.WAPRICE]);
            b.yld = num(row[mi.YIELD]);
            b.yieldWap = num(row[mi.YIELDATWAP]);
            b.duration = num(row[mi.DURATION]);
            b.valToday = num(row[mi.VALTODAY]);
            b.numTrades = num(row[mi.NUMTRADES]);
        });
    }

    return Array.from(map.values());
}

async function fetchSnapshot() {
    const results = await Promise.allSettled(BOARDS.map(fetchBoard));
    const ok = results.filter(r => r.status === 'fulfilled');
    if (!ok.length) throw results[0].reason;

    const failed = results
        .map((r, i) => (r.status === 'rejected' ? BOARDS[i].label : null))
        .filter(Boolean);
    partialNote = failed.length ? `Не загрузились: ${failed.join(', ')}.` : '';

    const today = moscowDateStr(new Date());
    const snapshot = new Map();
    ok.forEach(r => r.value.forEach(b => {
        const rub = !b.faceUnit || b.faceUnit === 'SUR' || b.faceUnit === 'RUB';
        const alive = !b.matDate || String(b.matDate).slice(0, 10) >= today;
        if (!rub || !alive || bondPrice(b) === null) return;
        snapshot.set(b.secid, b);
    }));

    if (!snapshot.size) throw new Error('не найдено ни одной облигации');
    return snapshot;
}

/* ---------- history (базы недели и месяца) ---------- */

async function fetchBoardHistoryDay(boardId, dateStr) {
    const pageUrl = start =>
        `${MOEX_ISS}/history/engines/stock/markets/bonds/boards/${boardId}/securities.json?date=${dateStr}&start=${start}` +
        `&iss.meta=off&iss.only=history,history.cursor&history.columns=SECID,TRADEDATE,CLOSE,LEGALCLOSEPRICE,WAPRICE`;

    const map = {};
    const parse = data => {
        const h = data.history;
        if (!h || !Array.isArray(h.data)) return 0;
        const iSec = col(h.columns, 'SECID');
        const iClose = col(h.columns, 'CLOSE');
        const iLegal = col(h.columns, 'LEGALCLOSEPRICE');
        const iWap = col(h.columns, 'WAPRICE');
        h.data.forEach(row => {
            const value = [num(row[iClose]), num(row[iLegal]), num(row[iWap])].find(v => v !== null && v > 0);
            if (row[iSec] && value !== undefined) map[row[iSec]] = value;
        });
        return h.data.length;
    };

    const first = await fetchJson(pageUrl(0));
    const rowsOnFirst = parse(first);
    if (rowsOnFirst === 0) return null;

    const cursor = first['history.cursor'];
    if (cursor && cursor.data && cursor.data.length) {
        const ci = cursor.columns;
        const total = num(cursor.data[0][col(ci, 'TOTAL')]) || rowsOnFirst;
        const pageSize = num(cursor.data[0][col(ci, 'PAGESIZE')]) || rowsOnFirst;
        const starts = [];
        for (let s = pageSize; pageSize > 0 && s < total; s += pageSize) starts.push(s);
        for (let i = 0; i < starts.length; i += PAGE_BATCH) {
            const pages = await Promise.all(starts.slice(i, i + PAGE_BATCH).map(s => fetchJson(pageUrl(s))));
            pages.forEach(parse);
        }
    }
    return map;
}

async function fetchBondsHistoryDay(dateStr) {
    const results = await Promise.all(BOARDS.map(b => fetchBoardHistoryDay(b.id, dateStr).catch(() => null)));
    if (results.every(r => !r)) return null; // нерабочий день (или обе доски не ответили)
    const merged = {};
    results.forEach(r => { if (r) Object.assign(merged, r); });
    return Object.keys(merged).length ? merged : null;
}

async function loadBasis(period) {
    const today = moscowDateStr(new Date());
    const startDate = period === 'month'
        ? shiftDateStr(shiftDateStr(today, { months: -1 }), { days: -1 })
        : shiftDateStr(today, { days: -7 });

    for (let i = 0; i <= MAX_BACK_DAYS; i++) {
        const dateStr = shiftDateStr(startDate, { days: -i });
        const map = await fetchBondsHistoryDay(dateStr);
        if (map) return { period, key: `${period}:${today}`, date: dateStr, map };
    }
    return null;
}

function canTryBasis(period, force) {
    return force || !basisFailedAt[period] || Date.now() - basisFailedAt[period] > HISTORY_RETRY_DELAY;
}

function ensureBasis(period) {
    if (period === 'day' || basisFresh(period)) return Promise.resolve(true);
    if (basisPromises[period]) return basisPromises[period];

    basisPromises[period] = (async () => {
        try {
            const loaded = await loadBasis(period);
            if (loaded) {
                bases[period] = loaded;
                basisFailedAt[period] = 0;
                return true;
            }
            basisFailedAt[period] = Date.now();
            return false;
        } catch (e) {
            console.error(e);
            basisFailedAt[period] = Date.now();
            return false;
        } finally {
            basisPromises[period] = null;
        }
    })();

    return basisPromises[period];
}

function kickBackgroundBases() {
    ['week', 'month'].forEach(period => {
        if (basisFresh(period) || basisPromises[period] || !canTryBasis(period, false)) return;
        ensureBasis(period).then(() => {
            if (lastSnapshot) applySnapshot(lastSnapshot);
        });
    });
}

/* ---------- cards ---------- */

function openBcsPage(b) {
    window.open(
        `https://lk.bcs.ru/catalog?popup=/catalog/instrument/${encodeURIComponent(b.secid)}/${b.board}`,
        '_blank',
        'noopener'
    );
}

function shortDate(dateStr) {
    if (!dateStr) return '—';
    const [y, m, d] = String(dateStr).slice(0, 10).split('-');
    return `${d}.${m}.${y.slice(2)}`;
}

function yearsToMat(b) {
    if (!b.matDate) return null;
    return (Date.parse(String(b.matDate).slice(0, 10)) - Date.parse(moscowDateStr(new Date()))) / (365.25 * 86400000);
}

function matText(b) {
    return b.matDate ? `Погаш. ${shortDate(b.matDate)}` : 'Без срока погашения';
}

/* Размер купона (% годовых, а если ставки нет — рубли за выплату) и периодичность. */
function cpnText(b) {
    const p = perYear(b);
    if (p === null) return 'Без купона';
    const size = b.couponPercent !== null ? `${nf(2).format(b.couponPercent)} %`
        : b.couponValue !== null ? `${nf(2).format(b.couponValue)} ₽` : '—';
    const r = Math.round(p * 10) / 10;
    return `Куп. ${size} · ${Number.isInteger(r) ? r : nf(1).format(r)}×/г`;
}

function createCard(b) {
    const card = mk('div', 'card bg-neutral');
    card.dataset.secid = b.secid;
    card.tabIndex = 0;
    card.setAttribute('role', 'button');

    const left = mk('div', 'card-left');
    const nameEl = mk('div', 'name', b.name);
    nameEl.title = `${b.secname || b.name} (${b.secid})`;
    const matEl = mk('div', 'price', '—');
    const cpnEl = mk('div', 'price', '—');
    left.append(nameEl, matEl, cpnEl);

    const right = mk('div', 'card-right');
    const changeEl = mk('div', 'change', '—');
    const priceEl = mk('div', 'price', '—');
    const metricEl = mk('div', 'delta', '—');
    right.append(changeEl, priceEl, metricEl);
    card.append(left, right);

    card.addEventListener('click', () => openBond(b.secid));
    card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openBond(b.secid);
        }
    });

    return { card, mat: matEl, cpn: cpnEl, price: priceEl, change: changeEl, metric: metricEl };
}

function metricText(b) {
    switch (sortKey) {
        case 'freq': return freqText(b);
        case 'rel': return relLabel(b);
        case 'mat': {
            const y = yearsToMat(b);
            return y === null ? '—' : `ещё ${nf(1).format(Math.max(0, y))} г.`;
        }
        default: {
            const y = bondYield(b);
            return y === null ? 'Дох. —' : `Дох. ${formatPct(y)}`;
        }
    }
}

function fillCard(els, b, result, period) {
    els.mat.textContent = matText(b);
    els.cpn.textContent = cpnText(b);
    els.price.textContent = result.price !== null ? `${nf(2).format(result.price)} %` : '—';
    els.change.textContent = formatChange(result.change);
    els.metric.textContent = metricText(b);
    els.card.className = 'card ' + getBgClass(result.change, period);
    els.card.title = `${b.secname || b.name}\n${matText(b)}\n${cpnText(b)} (${freqText(b)})`;
}

/* ====== СВЕЧНОЙ ГРАФИК (общий код акций и облигаций) ====== */

/* Поиск колонки без учёта регистра: MOEX отдаёт имена то строчными, то заглавными. */
function col(columns, name) {
    const n = String(name).toLowerCase();
    return (columns || []).findIndex(c => String(c).toLowerCase() === n);
}

/* ISS умеет свечи 1 / 10 / 60 мин, день, неделя, месяц. 5 и 15 минут собираем из минутных. */
const CHART_TF = [
    { key: '1m',  label: '1м',      kind: 'intra',  agg: 1,  days: 1 },
    { key: '5m',  label: '5м',      kind: 'intra',  agg: 5,  days: 2 },
    { key: '15m', label: '15м',     kind: 'intra',  agg: 15, days: 3 },
    { key: '1h',  label: '1ч',      kind: 'native', interval: 60 },
    { key: '1d',  label: 'День',    kind: 'native', interval: 24 },
    { key: '1w',  label: 'Неделя',  kind: 'native', interval: 7 },
    { key: '1M',  label: 'Месяц',   kind: 'native', interval: 31 }
];
const CHART_TF_MAP = Object.fromEntries(CHART_TF.map(t => [t.key, t]));
const CHART_DEFAULT_VISIBLE = { '1m': 120, '5m': 90, '15m': 80, '1h': 80, '1d': 90, '1w': 104, '1M': 60 };
const tradesCache = {};

async function fetchCandlePages(base, query) {
    const out = [];
    let start = 0;
    for (let page = 0; page < 14; page++) {
        const url = `${base}/candles.json?${query}&start=${start}&iss.meta=off&iss.only=candles` +
            `&candles.columns=begin,open,close,high,low,value,volume`;
        const data = await fetchJson(url, { retries: 2, timeout: 20000 });
        const c = data.candles;
        if (!c || !Array.isArray(c.data)) break;
        const iB = col(c.columns, 'begin');
        const iO = col(c.columns, 'open');
        const iC = col(c.columns, 'close');
        const iH = col(c.columns, 'high');
        const iL = col(c.columns, 'low');
        const iV = col(c.columns, 'volume');
        const iVal = col(c.columns, 'value');
        c.data.forEach(r => {
            const o = num(r[iO]);
            const cl = num(r[iC]);
            const h = num(r[iH]);
            const l = num(r[iL]);
            if (o === null || cl === null || h === null || l === null) return;
            out.push({ t: String(r[iB]).replace('T', ' '), o, c: cl, h, l, v: num(r[iV]), val: num(r[iVal]) });
        });
        if (c.data.length < 500) break; // ISS отдаёт максимум 500 свечей за запрос
        start += c.data.length;
    }
    return out;
}

function aggregateCandles(rows, agg) {
    const out = [];
    let cur = null;
    let curKey = null;
    rows.forEach(r => {
        const day = r.t.slice(0, 10);
        const mins = Number(r.t.slice(11, 13)) * 60 + Number(r.t.slice(14, 16));
        const bucket = Math.floor(mins / agg);
        const key = `${day}#${bucket}`;
        if (key !== curKey) {
            const bm = bucket * agg;
            const hh = String(Math.floor(bm / 60)).padStart(2, '0');
            const mm = String(bm % 60).padStart(2, '0');
            cur = { t: `${day} ${hh}:${mm}:00`, o: r.o, c: r.c, h: r.h, l: r.l, v: r.v || 0, val: r.val || 0 };
            out.push(cur);
            curKey = key;
        } else {
            cur.h = Math.max(cur.h, r.h);
            cur.l = Math.min(cur.l, r.l);
            cur.c = r.c;
            cur.v += r.v || 0;
            cur.val += r.val || 0;
        }
    });
    return out;
}

async function loadChartData(cfg, tf) {
    const today = moscowDateStr(new Date());
    const enc = encodeURIComponent;

    if (tf.kind === 'intra') {
        const chunks = [];
        let found = 0;
        for (let i = 0; i < 10 && found < tf.days; i++) {
            const d = shiftDateStr(today, { days: -i });
            const rows = await fetchCandlePages(cfg.candlesBase,
                `interval=1&from=${enc(d + ' 00:00:00')}&till=${enc(d + ' 23:59:59')}`);
            if (rows.length) {
                chunks.unshift(rows);
                found++;
            }
        }
        let rows = chunks.flat();
        if (tf.agg > 1) rows = aggregateCandles(rows, tf.agg);
        const what = tf.agg > 1 ? `Свечи ${tf.agg} мин собраны из минутных` : 'Минутные свечи';
        return { candles: rows, note: `${what}: ${found} торг. дн. (последние). Время московское.` };
    }

    let from;
    let span;
    if (tf.key === '1h') { from = shiftDateStr(today, { days: -30 }); span = '30 дней'; }
    else if (tf.key === '1d') { from = shiftDateStr(today, { months: -36 }); span = '3 года'; }
    else if (tf.key === '1w') { from = shiftDateStr(today, { months: -120 }); span = '10 лет'; }
    else { from = '1990-01-01'; span = 'вся история'; }

    const rows = await fetchCandlePages(cfg.candlesBase,
        `interval=${tf.interval}&from=${from}&till=${enc(today + ' 23:59:59')}`);
    return { candles: rows, note: `Свечи MOEX (${span}). Время московское.` };
}

/* Число сделок ISS отдаёт только в дневных итогах — подтягиваем для дневных, недельных и месячных свечей (последние 2 года). */
async function fetchTradesMap(cfg) {
    if (tradesCache[cfg.historyBase]) return tradesCache[cfg.historyBase];

    const from = shiftDateStr(moscowDateStr(new Date()), { months: -24 });
    const url = start =>
        `${cfg.historyBase}.json?iss.meta=off&iss.only=history,history.cursor` +
        `&history.columns=TRADEDATE,NUMTRADES&from=${from}&start=${start}`;
    const map = {};
    const eat = data => {
        const h = data.history;
        if (!h || !Array.isArray(h.data)) return 0;
        const iD = col(h.columns, 'TRADEDATE');
        const iN = col(h.columns, 'NUMTRADES');
        h.data.forEach(r => { const n = num(r[iN]); if (n !== null) map[String(r[iD]).slice(0, 10)] = n; });
        return h.data.length;
    };

    const first = await fetchJson(url(0), { retries: 1 });
    const n = eat(first);
    const cur = first['history.cursor'];
    let total = n;
    let pageSize = n;
    if (cur && cur.data && cur.data.length) {
        total = num(cur.data[0][col(cur.columns, 'TOTAL')]) || n;
        pageSize = num(cur.data[0][col(cur.columns, 'PAGESIZE')]) || n;
    }
    const starts = [];
    for (let s = pageSize; pageSize > 0 && s < total; s += pageSize) starts.push(s);
    for (let i = 0; i < starts.length; i += 6) {
        const pages = await Promise.all(starts.slice(i, i + 6).map(s => fetchJson(url(s), { retries: 1 }).catch(() => null)));
        pages.forEach(p => { if (p) eat(p); });
    }
    const res = { map, from };
    tradesCache[cfg.historyBase] = res;
    return res;
}

function chartDec(price, cfg) {
    if (cfg && Number.isInteger(cfg.decimals)) return cfg.decimals;
    const a = Math.abs(price);
    return a < 1 ? 4 : a < 10 ? 3 : 2;
}

function formatVolume(v) {
    if (v === null || v === undefined || isNaN(v)) return '—';
    if (v >= 1e9) return nf(2).format(v / 1e9) + ' млрд';
    if (v >= 1e6) return nf(2).format(v / 1e6) + ' млн';
    return nf(0).format(v);
}

function chartTimeLabel(t, key, prevT) {
    const day = t.slice(0, 10);
    if (key === '1m' || key === '5m' || key === '15m') {
        const hm = t.slice(11, 16);
        return !prevT || prevT.slice(0, 10) !== day ? `${t.slice(8, 10)}.${t.slice(5, 7)} ${hm}` : hm;
    }
    if (key === '1h') return `${t.slice(8, 10)}.${t.slice(5, 7)} ${t.slice(11, 16)}`;
    if (key === '1M') return `${t.slice(5, 7)}.${t.slice(0, 4)}`;
    return `${t.slice(8, 10)}.${t.slice(5, 7)}.${t.slice(2, 4)}`;
}

function chartTipTitle(t, key) {
    const d = `${t.slice(8, 10)}.${t.slice(5, 7)}.${t.slice(0, 4)}`;
    if (key === '1m' || key === '5m' || key === '15m' || key === '1h') return `${d} ${t.slice(11, 16)}`;
    if (key === '1w') return `Неделя с ${d}`;
    if (key === '1M') return `Месяц ${t.slice(5, 7)}.${t.slice(0, 4)}`;
    return d;
}

function createCandleChart(stage, cfg) {
    const canvas = document.createElement('canvas');
    canvas.className = 'cp-canvas';
    const tip = mk('div', 'cp-tip');
    tip.hidden = true;
    stage.append(canvas, tip);

    const M = { l: 6, r: 62, t: 10, b: 22 };
    const UP = '#2e7d32';
    const DOWN = '#c62828';
    const raf = typeof requestAnimationFrame === 'function' ? requestAnimationFrame : f => setTimeout(f, 0);

    let data = [];
    let tfKey = '1d';
    let visible = 80;
    let end = 0;
    let hover = -1;
    let drag = null;
    let pinch = null;
    let pending = false;

    function dims() {
        const dpr = (typeof window !== 'undefined' && window.devicePixelRatio) || 1;
        const w = stage.clientWidth || 320;
        const h = stage.clientHeight || 280;
        const pw = Math.round(w * dpr);
        const ph = Math.round(h * dpr);
        if (canvas.width !== pw || canvas.height !== ph) {
            canvas.width = pw;
            canvas.height = ph;
        }
        return { w, h, dpr };
    }

    function clampView() {
        const n = data.length;
        visible = Math.max(8, Math.min(visible, Math.max(n + 6, 16)));
        const lo = visible - 4;
        const hi = n + 4;
        end = Math.min(Math.max(end, Math.min(lo, hi)), hi);
    }

    function schedule() {
        if (pending) return;
        pending = true;
        raf(() => { pending = false; draw(); });
    }

    function geometry() {
        const { w, h, dpr } = dims();
        const volH = Math.round((h - M.t - M.b) * 0.2);
        const priceH = h - M.t - M.b - volH - 6;
        const plotW = w - M.l - M.r;
        return { w, h, dpr, volH, priceH, plotW, bw: plotW / visible, start: end - visible };
    }

    function draw() {
        const g = geometry();
        const ctx = canvas.getContext('2d');
        ctx.setTransform(g.dpr, 0, 0, g.dpr, 0, 0);
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, g.w, g.h);

        const n = data.length;
        if (!n) {
            ctx.fillStyle = '#888';
            ctx.font = '13px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('Нет данных для графика', g.w / 2, g.h / 2);
            return;
        }

        const i0 = Math.max(0, Math.floor(g.start));
        const i1 = Math.min(n - 1, Math.ceil(end) - 1);
        let lo = Infinity;
        let hi = -Infinity;
        let vmax = 0;
        for (let i = i0; i <= i1; i++) {
            const d = data[i];
            if (d.l < lo) lo = d.l;
            if (d.h > hi) hi = d.h;
            if (d.v > vmax) vmax = d.v;
        }
        if (!isFinite(lo) || !isFinite(hi)) return;
        const pad = ((hi - lo) || Math.abs(hi) * 0.01 || 1) * 0.07;
        lo -= pad;
        hi += pad;

        const py = p => M.t + ((hi - p) / (hi - lo)) * g.priceH;
        const vy = v => M.t + g.priceH + 6 + g.volH - (vmax ? (v / vmax) * g.volH : 0);
        const px = i => M.l + (i + 0.5 - g.start) * g.bw;
        const dec = chartDec(data[Math.min(n - 1, i1)].c, cfg);

        // сетка и подписи цены
        ctx.font = '11px Arial';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.lineWidth = 1;
        for (let k = 0; k <= 4; k++) {
            const p = lo + ((hi - lo) * k) / 4;
            const y = Math.round(py(p)) + 0.5;
            ctx.strokeStyle = '#eee';
            ctx.beginPath(); ctx.moveTo(M.l, y); ctx.lineTo(g.w - M.r, y); ctx.stroke();
            ctx.fillStyle = '#666';
            ctx.fillText(nf(dec).format(p), g.w - M.r + 4, y);
        }

        // свечи и объёмы
        const body = Math.max(1, Math.min(g.bw * 0.72, 22));
        for (let i = i0; i <= i1; i++) {
            const d = data[i];
            const x = px(i);
            const up = d.c >= d.o;
            ctx.strokeStyle = ctx.fillStyle = up ? UP : DOWN;
            ctx.beginPath(); ctx.moveTo(Math.round(x) + 0.5, py(d.h)); ctx.lineTo(Math.round(x) + 0.5, py(d.l)); ctx.stroke();
            const y1 = py(Math.max(d.o, d.c));
            const y2 = py(Math.min(d.o, d.c));
            ctx.fillRect(x - body / 2, y1, body, Math.max(1, y2 - y1));
            if (d.v) {
                ctx.globalAlpha = 0.45;
                ctx.fillRect(x - body / 2, vy(d.v), body, M.t + g.priceH + 6 + g.volH - vy(d.v));
                ctx.globalAlpha = 1;
            }
        }

        // ось времени
        ctx.fillStyle = '#666';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const step = Math.max(1, Math.ceil(84 / g.bw));
        for (let i = i0 - (i0 % step); i <= i1; i += step) {
            if (i < 0) continue;
            const x = px(i);
            if (x < M.l + 20 || x > g.w - M.r - 20) continue;
            ctx.fillText(chartTimeLabel(data[i].t, tfKey, i > 0 ? data[i - 1].t : null), x, g.h - M.b + 5);
        }

        // перекрестие
        if (hover >= 0 && hover < n) {
            const d = data[hover];
            const x = Math.round(px(hover)) + 0.5;
            ctx.strokeStyle = 'rgba(0,0,0,.35)';
            ctx.setLineDash([4, 3]);
            ctx.beginPath(); ctx.moveTo(x, M.t); ctx.lineTo(x, g.h - M.b); ctx.stroke();
            const y = Math.round(py(d.c)) + 0.5;
            ctx.beginPath(); ctx.moveTo(M.l, y); ctx.lineTo(g.w - M.r, y); ctx.stroke();
            ctx.setLineDash([]);
            ctx.fillStyle = d.c >= d.o ? UP : DOWN;
            ctx.fillRect(g.w - M.r, y - 8, M.r - 2, 16);
            ctx.fillStyle = '#fff';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(nf(dec).format(d.c), g.w - M.r + 3, y);
        }
    }

    function showTip(i, xPix) {
        if (i < 0 || i >= data.length) { tip.hidden = true; return; }
        const d = data[i];
        const dec = chartDec(d.c, cfg);
        const ch = d.o ? ((d.c / d.o - 1) * 100) : null;
        const line = (a, b, cls) => {
            const r = mk('div', 'r');
            r.append(mk('span', null, a), mk('span', cls || null, b));
            return r;
        };
        const rows = [
            mk('b', null, chartTipTitle(d.t, tfKey)),
            line('Открытие', nf(dec).format(d.o)),
            line('Закрытие', nf(dec).format(d.c), d.c >= d.o ? 'up' : 'down'),
            line('Минимум', nf(dec).format(d.l)),
            line('Максимум', nf(dec).format(d.h)),
            line('Объём', d.v ? `${formatVolume(d.v)} шт.` : '—'),
            line('Сделок', d.n !== undefined && d.n !== null ? nf(0).format(d.n) : '—')
        ];
        if (ch !== null) rows.push(line('Изменение', (ch >= 0 ? '+' : '−') + nf(2).format(Math.abs(ch)) + ' %', ch >= 0 ? 'up' : 'down'));
        tip.replaceChildren(...rows);
        const sw = stage.clientWidth || 320;
        tip.style.left = (xPix > sw / 2 ? 8 : Math.max(8, sw - 180)) + 'px';
        tip.hidden = false;
    }

    function idxAtX(xPix) {
        const g = geometry();
        return Math.floor(g.start + (xPix - M.l) / g.bw);
    }

    function relX(clientX) {
        const r = canvas.getBoundingClientRect();
        return clientX - r.left;
    }

    function zoomAt(factor, xPix) {
        const g = geometry();
        const frac = Math.max(0, Math.min(1, (xPix - M.l) / g.plotW));
        const anchor = g.start + frac * visible;
        visible = visible * factor;
        const n = data.length;
        visible = Math.max(8, Math.min(visible, Math.max(n + 6, 16)));
        end = anchor - frac * visible + visible;
        clampView();
        schedule();
    }

    function panBy(dxPix) {
        const g = geometry();
        end -= dxPix / g.bw;
        clampView();
        schedule();
    }

    // мышь
    canvas.addEventListener('mousemove', e => {
        const x = relX(e.clientX);
        if (drag && drag.mouse) {
            panBy(x - drag.x);
            drag.x = x;
            drag.moved = true;
            return;
        }
        hover = idxAtX(x);
        showTip(hover, x);
        schedule();
    });
    canvas.addEventListener('mouseleave', () => { hover = -1; tip.hidden = true; drag = null; schedule(); });
    canvas.addEventListener('mousedown', e => { drag = { mouse: true, x: relX(e.clientX), moved: false }; });
    canvas.addEventListener('mouseup', () => { drag = null; });
    canvas.addEventListener('wheel', e => {
        if (e.preventDefault) e.preventDefault();
        zoomAt(e.deltaY < 0 ? 0.85 : 1 / 0.85, relX(e.clientX));
    }, { passive: false });

    // касания: один палец — сдвиг (горизонтально) или тап = подсказка; два пальца — масштаб
    const dist = ts => Math.hypot(ts[0].clientX - ts[1].clientX, ts[0].clientY - ts[1].clientY);
    canvas.addEventListener('touchstart', e => {
        if (e.touches.length === 2) {
            pinch = { d: dist(e.touches), v: visible };
            drag = null;
        } else if (e.touches.length === 1) {
            const t = e.touches[0];
            drag = { x: t.clientX, y: t.clientY, sx: t.clientX, sy: t.clientY, moved: false };
        }
    }, { passive: true });
    canvas.addEventListener('touchmove', e => {
        if (e.touches.length === 2 && pinch) {
            const g = geometry();
            const mid = relX((e.touches[0].clientX + e.touches[1].clientX) / 2);
            const target = Math.max(8, pinch.v * (pinch.d / Math.max(1, dist(e.touches))));
            zoomAt(target / visible, mid);
            if (e.preventDefault) e.preventDefault();
            return;
        }
        if (drag && e.touches.length === 1) {
            const t = e.touches[0];
            const dx = t.clientX - drag.x;
            const horizontal = Math.abs(t.clientX - drag.sx) > Math.abs(t.clientY - drag.sy);
            if (Math.abs(t.clientX - drag.sx) > 6 || Math.abs(t.clientY - drag.sy) > 6) drag.moved = true;
            if (horizontal) {
                panBy(dx);
                tip.hidden = true;
                hover = -1;
                if (e.preventDefault) e.preventDefault();
            }
            drag.x = t.clientX;
            drag.y = t.clientY;
        }
    }, { passive: false });
    canvas.addEventListener('touchend', () => {
        if (drag && !drag.moved) {
            const x = relX(drag.sx);
            hover = idxAtX(x);
            showTip(hover, x);
            schedule();
        }
        drag = null;
        pinch = null;
    });

    let ro = null;
    const onResize = () => schedule();
    if (typeof ResizeObserver !== 'undefined') {
        ro = new ResizeObserver(onResize);
        ro.observe(stage);
    } else if (typeof window !== 'undefined' && window.addEventListener) {
        window.addEventListener('resize', onResize);
    }

    return {
        setData(candles, key) {
            data = candles || [];
            tfKey = key;
            hover = -1;
            tip.hidden = true;
            visible = Math.min(Math.max(data.length, 10), CHART_DEFAULT_VISIBLE[key] || 80);
            end = data.length + 2;
            clampView();
            schedule();
        },
        redraw: schedule,
        zoom(factor) { zoomAt(factor, M.l + geometry().plotW / 2); },
        reset() {
            visible = Math.min(Math.max(data.length, 10), CHART_DEFAULT_VISIBLE[tfKey] || 80);
            end = data.length + 2;
            clampView();
            schedule();
        },
        hoverAt(i) { hover = i; showTip(i, 0); schedule(); }, // для тестов и программного вызова
        view() { return { visible, end, n: data.length }; },
        destroy() {
            if (ro) ro.disconnect();
            else if (typeof window !== 'undefined' && window.removeEventListener) window.removeEventListener('resize', onResize);
        }
    };
}

/* Панель: кнопки таймфреймов, масштаб, полный экран, график, сноска. cfg: { candlesBase, historyBase, decimals } */
function makeChartPanel(cfg) {
    const root = mk('div', 'cp');
    const head = mk('div', 'cp-head');
    const tools = mk('div', 'cp-tools');
    const stage = mk('div', 'cp-stage');
    const note = mk('div', 'note', '');

    const tfBtns = {};
    CHART_TF.forEach(tf => {
        const b = mk('button', 'cp-btn', tf.label);
        b.addEventListener('click', () => select(tf.key));
        tfBtns[tf.key] = b;
        head.append(b);
    });

    const bMinus = mk('button', 'cp-btn', '−');
    const bPlus = mk('button', 'cp-btn', '+');
    const bReset = mk('button', 'cp-btn', '⟲');
    const bFull = mk('button', 'cp-btn', '⛶');
    bMinus.title = 'Уменьшить';
    bPlus.title = 'Увеличить';
    bReset.title = 'Сбросить масштаб';
    bFull.title = 'На весь экран';
    tools.append(bMinus, bPlus, bReset, bFull);
    root.append(head, tools, stage, note);

    const chart = createCandleChart(stage, cfg);
    const cache = {};
    let token = 0;
    let full = false;
    let destroyed = false;

    bMinus.addEventListener('click', () => chart.zoom(1.3));
    bPlus.addEventListener('click', () => chart.zoom(1 / 1.3));
    bReset.addEventListener('click', () => chart.reset());

    function setFull(on) {
        full = on;
        root.className = 'cp' + (on ? ' cp-full' : '');
        bFull.textContent = on ? '✕' : '⛶';
        bFull.title = on ? 'Свернуть' : 'На весь экран';
        try {
            if (on && root.requestFullscreen) root.requestFullscreen().catch(() => {});
            else if (!on && document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
        } catch (_) { /* на iPhone Fullscreen API нет — работает режим «поверх страницы» */ }
        chart.redraw();
    }
    bFull.addEventListener('click', () => setFull(!full));

    const onKey = e => {
        if (e.key === 'Escape' && full) {
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
            setFull(false);
        }
    };
    document.addEventListener('keydown', onKey, true);

    async function attachTrades(key, candles) {
        if (!cfg.historyBase || (key !== '1d' && key !== '1w' && key !== '1M')) return;
        try {
            const res = await fetchTradesMap(cfg);
            if (destroyed || !res) return;
            const dates = Object.keys(res.map).sort();
            candles.forEach((c, i) => {
                const d0 = c.t.slice(0, 10);
                if (d0 < res.from) return;
                if (key === '1d') {
                    if (res.map[d0] !== undefined) c.n = res.map[d0];
                    return;
                }
                const d1 = i + 1 < candles.length ? candles[i + 1].t.slice(0, 10) : '9999-12-31';
                let sum = 0;
                let any = false;
                dates.forEach(d => { if (d >= d0 && d < d1) { sum += res.map[d]; any = true; } });
                if (any) c.n = sum;
            });
            chart.redraw();
        } catch (e) {
            console.error(e);
        }
    }

    async function select(key) {
        Object.keys(tfBtns).forEach(k => { tfBtns[k].className = 'cp-btn' + (k === key ? ' active' : ''); });
        const my = ++token;
        note.textContent = 'Загрузка свечей...';
        try {
            let res = cache[key];
            if (!res || Date.now() - res.t > 60000) {
                res = await loadChartData(cfg, CHART_TF_MAP[key]);
                res.t = Date.now();
                cache[key] = res;
            }
            if (my !== token || destroyed) return;
            chart.setData(res.candles, key);
            note.textContent = res.candles.length
                ? `${res.note} Свечей: ${res.candles.length}. Колесо / щипок — масштаб, перетаскивание — сдвиг, наведение или тап — подробности.` +
                  (key === '1d' || key === '1w' || key === '1M' ? ' Число сделок — только за последние 2 года.' : ' Число сделок для этого таймфрейма MOEX не публикует.')
                : 'Свечей за этот период нет (возможно, торги не проводились).';
            attachTrades(key, res.candles);
        } catch (e) {
            console.error(e);
            if (my === token) note.textContent = `Не удалось загрузить свечи: ${e.message}`;
        }
    }

    select('1d');

    return {
        el: root,
        select,
        chart,
        destroy() {
            destroyed = true;
            document.removeEventListener('keydown', onKey, true);
            chart.destroy();
            try { if (full && document.fullscreenElement && document.exitFullscreen) document.exitFullscreen(); } catch (_) { /* ignore */ }
        }
    };
}


/* ---------- карточка облигации ---------- */

let modalSecid = null;
let chartPanel = null;
const couponData = {};

function rowEl(label, value, cls) {
    const r = mk('div', 'row');
    r.append(mk('span', null, label), mk('span', cls || null, value));
    return r;
}

function formatInt(v) {
    return v === null || v === undefined || isNaN(v) ? '—' : nf(0).format(v);
}

function formatMoney(v) {
    if (v === null || v === undefined || isNaN(v)) return '—';
    if (v >= 1e9) return nf(2).format(v / 1e9) + ' млрд ₽';
    if (v >= 1e6) return nf(1).format(v / 1e6) + ' млн ₽';
    return nf(0).format(v) + ' ₽';
}

function bondUrl(b) {
    return `https://lk.bcs.ru/catalog?popup=/catalog/instrument/${encodeURIComponent(b.secid)}/${b.board}`;
}

async function loadCoupons(secid) {
    if (couponData[secid]) return couponData[secid];
    const today = moscowDateStr(new Date());
    const enc = encodeURIComponent(secid);
    const res = { coupons: [], amort: [], error: null };
    try {
        let start = 0;
        for (let page = 0; page < 6; page++) {
            const data = await fetchJson(
                `${MOEX_ISS}/securities/${enc}/bondization.json?iss.meta=off&iss.only=coupons&limit=100&start=${start}`,
                { retries: 1, timeout: 15000 });
            const blk = data.coupons;
            if (!blk || !Array.isArray(blk.data)) break;
            const iD = col(blk.columns, 'coupondate');
            const iV = col(blk.columns, 'value');
            const iP = col(blk.columns, 'valueprc');
            blk.data.forEach(r => {
                if (r[iD]) res.coupons.push({ date: String(r[iD]).slice(0, 10), value: num(r[iV]), pct: num(r[iP]) });
            });
            if (blk.data.length < 100) break;
            start += blk.data.length;
        }
    } catch (e) {
        console.error(e);
        res.error = e.message;
    }
    try {
        const data = await fetchJson(
            `${MOEX_ISS}/securities/${enc}/bondization.json?iss.meta=off&iss.only=amortizations&limit=100`,
            { retries: 1, timeout: 15000 });
        const blk = data.amortizations;
        if (blk && Array.isArray(blk.data)) {
            const iD = col(blk.columns, 'amortdate');
            const iV = col(blk.columns, 'value');
            const iP = col(blk.columns, 'valueprc');
            blk.data.forEach(r => {
                if (r[iD]) res.amort.push({ date: String(r[iD]).slice(0, 10), value: num(r[iV]), pct: num(r[iP]) });
            });
        }
    } catch (e) {
        console.error(e);
    }
    res.coupons.sort((a, c) => a.date.localeCompare(c.date));
    res.amort.sort((a, c) => a.date.localeCompare(c.date));
    couponData[secid] = res;
    return res;
}

function openBond(secid) {
    const b = bondById[secid];
    if (!b) return;
    modalSecid = secid;
    document.getElementById('modal').hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('modalTitle').textContent = `${b.name} (${b.secid})`;
    document.getElementById('modalSub').textContent = b.secname || '';

    renderBondLive();
    renderBondCoupons();
    renderBondLinks();

    if (chartPanel) chartPanel.destroy();
    const enc = encodeURIComponent(secid);
    chartPanel = makeChartPanel({
        candlesBase: `${MOEX_ISS}/engines/stock/markets/bonds/boards/${b.board}/securities/${enc}`,
        historyBase: `${MOEX_ISS}/history/engines/stock/markets/bonds/boards/${b.board}/securities/${enc}`,
        decimals: 2
    });
    document.getElementById('modalChart').replaceChildren(mk('h4', null, 'График цены, % от номинала (японские свечи)'), chartPanel.el);

    loadCoupons(secid).then(() => { if (modalSecid === secid) renderBondCoupons(); });
}

function closeBond() {
    if (chartPanel) {
        chartPanel.destroy();
        chartPanel = null;
    }
    document.getElementById('modalChart').replaceChildren();
    modalSecid = null;
    document.getElementById('modal').hidden = true;
    document.body.style.overflow = '';
}

function renderBondLive() {
    const box = document.getElementById('modalLive');
    const b = modalSecid && bondById[modalSecid];
    if (!b) return;
    const day = computeFor(b, 'day');
    const price = day.price;
    const rows = [mk('h4', null, 'Сводка')];

    rows.push(rowEl('Цена, % от номинала', price !== null ? `${nf(2).format(price)} %` : '—'));
    if (price !== null && b.faceValue) {
        const rub = (price / 100) * b.faceValue;
        rows.push(rowEl('Цена в рублях (без НКД)', `${nf(2).format(rub)} ₽`));
    }
    rows.push(rowEl('Изменение цены за день', `${formatChange(day.change)} (${formatPunits(day.delta)})`, signCls(day.change)));
    ['week', 'month'].forEach(p => {
        if (!basisFresh(p)) return;
        const r = computeFor(b, p);
        rows.push(rowEl(`Изменение цены ${PERIOD_LABEL[p]}`, formatChange(r.change), signCls(r.change)));
    });
    rows.push(rowEl('Номинал', b.faceValue !== null ? `${nf(2).format(b.faceValue)} ₽` : '—'));
    const y = bondYield(b);
    rows.push(rowEl('Доходность к погашению', y === null ? '—' : formatPct(y), y === null ? '' : 'pos'));
    if (b.duration !== null) rows.push(rowEl('Дюрация', `${nf(2).format(b.duration / 365)} г. (${formatInt(b.duration)} дн.)`));

    rows.push(rowEl('Купон', b.couponPercent !== null ? `${nf(2).format(b.couponPercent)} % годовых` : '—'));
    rows.push(rowEl('Размер купона', b.couponValue !== null ? `${nf(2).format(b.couponValue)} ₽` : '—'));
    rows.push(rowEl('Периодичность купона', perYear(b) === null ? 'без купона' : `${freqText(b)} (каждые ${formatInt(b.couponPeriod)} дн.)`));
    rows.push(rowEl('Ближайший купон', b.nextCoupon ? humanDate(b.nextCoupon) : '—'));
    rows.push(rowEl('Дата погашения', b.matDate ? `${humanDate(b.matDate)}${yearsToMat(b) !== null ? ` (через ${nf(1).format(Math.max(0, yearsToMat(b)))} г.)` : ''}` : 'без срока'));
    rows.push(rowEl('Надёжность (уровень листинга)', relLabel(b)));
    rows.push(rowEl('Объём торгов сегодня', formatMoney(b.valToday)));
    rows.push(rowEl('Сделок сегодня', formatInt(b.numTrades)));
    rows.push(mk('div', 'note',
        'Цена — чистая (без накопленного купонного дохода), в % от номинала. Данные MOEX идут с задержкой около 15 минут. ' +
        '«Надёжность» — уровень листинга, а не кредитный рейтинг.'));
    box.replaceChildren(...rows);
}

function renderBondCoupons() {
    const box = document.getElementById('modalCoupons');
    const secid = modalSecid;
    if (!secid) return;
    const cd = couponData[secid];
    const parts = [mk('h4', null, 'Ближайшие купоны и погашения')];

    if (!cd) {
        parts.push(mk('div', 'note', 'Загрузка графика выплат...'));
        box.replaceChildren(...parts);
        return;
    }

    const today = moscowDateStr(new Date());
    const next = cd.coupons.filter(c => c.date >= today).slice(0, 8);
    if (next.length) {
        const table = mk('table', 'dt');
        const head = mk('tr');
        ['Дата', 'Купон, ₽', 'Ставка'].forEach(h => head.append(mk('th', null, h)));
        table.append(head);
        next.forEach(c => {
            const tr = mk('tr');
            tr.append(mk('td', null, shortDate(c.date)), mk('td', null, c.value !== null ? nf(2).format(c.value) : '—'),
                mk('td', null, c.pct !== null ? formatPct(c.pct) : '—'));
            table.append(tr);
        });
        parts.push(table);
    } else {
        parts.push(mk('div', 'note', cd.error ? `Не удалось загрузить купоны: ${cd.error}` : 'Будущих купонов в данных MOEX нет.'));
    }

    const am = cd.amort.filter(a => a.date >= today).slice(0, 6);
    if (cd.amort.length) {
        parts.push(mk('div', 'sub-h', 'Облигация амортизируемая: частичное погашение номинала'));
        am.forEach(a => parts.push(rowEl(humanDate(a.date),
            `${a.value !== null ? nf(2).format(a.value) + ' ₽' : ''}${a.pct !== null ? ' · ' + formatPct(a.pct) : ''}`)));
        if (!am.length) parts.push(mk('div', 'note', 'Будущих амортизационных выплат нет.'));
    }
    box.replaceChildren(...parts);
}

function renderBondLinks() {
    const box = document.getElementById('modalLinks');
    const b = modalSecid && bondById[modalSecid];
    if (!b) return;
    const mkLink = (text, href, cls) => {
        const a = mk('a', 'btn' + (cls ? ' ' + cls : ''), text);
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener';
        return a;
    };
    box.replaceChildren(
        mk('h4', null, 'Открыть'),
        mkLink('Карточка в БКС', bondUrl(b), 'primary'),
        mkLink('Страница на MOEX', `https://www.moex.com/ru/issue.aspx?code=${encodeURIComponent(b.secid)}&board=${b.board}`)
    );
}


/* ---------- sorting / filtering ---------- */

function sortValue(b, key) {
    switch (key) {
        case 'yield': return bondYield(b);
        case 'price': return bondPrice(b);
        case 'freq': return perYear(b);
        case 'rel': return relScore(b);
        case 'mat': return b.matDate ? Date.parse(String(b.matDate).slice(0, 10)) : null;
        default: {
            const c = computeFor(b, currentPeriod).change;
            if (c === null || isNaN(c) || Math.round(c * 100) / 100 === 0) return null; // нули — в конец
            return c;
        }
    }
}

function sortBonds(list) {
    const dir = sortDir;
    const decorated = list.map(b => ({
        b,
        v: sortValue(b, sortKey),
        y: bondYield(b)
    }));

    decorated.sort((a, c) => {
        if (a.v === null && c.v === null) {
            // обе без значения — по доходности, затем по коду
        } else if (a.v === null) {
            return 1;
        } else if (c.v === null) {
            return -1;
        } else if (a.v !== c.v) {
            return dir * (a.v - c.v);
        }
        if (a.y !== c.y) {
            if (a.y === null) return 1;
            if (c.y === null) return -1;
            return c.y - a.y;
        }
        return a.b.secid.localeCompare(c.b.secid);
    });

    return decorated.map(d => d.b);
}

function visibleBonds() {
    return allBonds.filter(b => {
        if (ofzOnly && !b.isOfz) return false;
        if (searchQuery) {
            const hay = `${b.name} ${b.secid} ${b.secname || ''}`.toLowerCase();
            if (!hay.includes(searchQuery)) return false;
        }
        return true;
    });
}

function renderList() {
    const grid = document.getElementById('grid');
    const more = document.getElementById('more');
    const list = sortBonds(visibleBonds());
    const slice = list.slice(0, shown);

    grid.replaceChildren(...slice.map(b => {
        const els = createCard(b);
        fillCard(els, b, computeFor(b, currentPeriod), currentPeriod);
        return els.card;
    }));

    if (list.length > slice.length) {
        const btn = mk('button', null, `Показать ещё ${Math.min(PAGE_SIZE, list.length - slice.length)} (всего ${list.length})`);
        btn.addEventListener('click', () => {
            shown += PAGE_SIZE;
            renderList();
        });
        more.replaceChildren(btn);
    } else {
        more.replaceChildren(mk('div', 'block-note', `Показано ${slice.length} из ${list.length}`));
    }
}

/* ---------- controls ---------- */

function renderSorts() {
    const box = document.getElementById('sorts');
    const parts = SORT_BUTTONS.map(([key, label]) => {
        const active = key === sortKey;
        const btn = mk('button', active ? 'active' : null, label + (active ? (sortDir < 0 ? ' ↓' : ' ↑') : ''));
        btn.addEventListener('click', () => {
            if (sortKey === key) {
                sortDir = -sortDir;
            } else {
                sortKey = key;
                sortDir = SORT_DEFAULT_DIR[key];
            }
            shown = PAGE_SIZE;
            renderSorts();
            renderList();
        });
        return btn;
    });

    const ofz = mk('button', ofzOnly ? 'active' : null, 'Только ОФЗ');
    ofz.addEventListener('click', () => {
        ofzOnly = !ofzOnly;
        if (ofzOnly) {          // ОФЗ — по стоимости (цене), от дорогих к дешёвым
            sortKey = 'price';
            sortDir = -1;
        }
        shown = PAGE_SIZE;
        renderSorts();
        renderList();
        renderSummary();
    });
    parts.push(ofz);

    box.replaceChildren(...parts);
}

/* ---------- summary & blocks ---------- */

function median(values) {
    if (!values.length) return null;
    const v = [...values].sort((a, b) => a - b);
    return v.length % 2 ? v[(v.length - 1) / 2] : (v[v.length / 2 - 1] + v[v.length / 2]) / 2;
}

function renderSummary() {
    const box = document.getElementById('summary');
    if (!allBonds.length) {
        box.hidden = true;
        return;
    }
    box.hidden = false;

    const list = ofzOnly ? allBonds.filter(b => b.isOfz) : allBonds;
    let up = 0;
    let down = 0;
    let flat = 0;
    list.forEach(b => {
        const c = computeFor(b, currentPeriod).change;
        if (c === null || isNaN(c)) return;
        const r = Math.round(c * 100) / 100;
        if (r > 0) up++;
        else if (r < 0) down++;
        else flat++;
    });
    const total = up + down + flat;

    const ofzYields = allBonds.filter(b => b.isOfz).map(bondYield).filter(v => v !== null && v > 0 && v < 100);
    const corpYields = allBonds.filter(b => !b.isOfz).map(bondYield).filter(v => v !== null && v > 0 && v < 100);
    const mo = median(ofzYields);
    const mc = median(corpYields);

    const l1 = mk('div');
    l1.append(`Цена ${PERIOD_LABEL[currentPeriod]}: `);
    l1.append(mk('span', 'pos', `растут ${up}`), ' · ', mk('span', 'neg', `падают ${down}`), ` · без изм. ${flat}`);

    const bar = mk('div', 'breadth');
    if (total) {
        [[up, '#43a047'], [flat, '#9e9e9e'], [down, '#c62828']].forEach(([n, color]) => {
            const s = mk('span');
            s.style.width = `${(n / total) * 100}%`;
            s.style.background = color;
            bar.append(s);
        });
    }

    const l2 = mk('div', null,
        `Облигаций: ${allBonds.length} (ОФЗ: ${allBonds.filter(b => b.isOfz).length}). ` +
        `Медианная доходность: ОФЗ ${mo === null ? '—' : formatPct(mo)}, корпоративные ${mc === null ? '—' : formatPct(mc)}` +
        (mo !== null && mc !== null ? ` (спред ${formatPct(mc - mo)})` : '') + '.');

    const l3 = mk('div', 'block-note',
        'Цвет — изменение чистой цены, без купонов и НКД. «Надёжность» — это уровень листинга, а не кредитный рейтинг. ' +
        partialNote);

    box.replaceChildren(l1, bar, l2, l3);
}

function initBlocks() {
    const container = document.getElementById('blocks');
    BLOCKS.forEach(cfg => {
        const title = mk('div', 'block-title');
        const note = mk('div', 'block-note');
        const grid = mk('div', 'grid');
        container.append(title, note, grid);
        blockEls[cfg.key] = { title, note, grid };
    });
}

function renderBlock(cfg) {
    const els = blockEls[cfg.key];
    els.title.textContent = `Изменение цены ${cfg.label} более ${cfg.threshold} % (от красного к зелёному)`;

    if (!basisFresh(cfg.period)) {
        els.grid.replaceChildren();
        els.note.textContent = basisPromises[cfg.period] || !basisFailedAt[cfg.period]
            ? 'Загрузка исторических данных (облигаций много, это может занять до минуты)...'
            : 'Не удалось загрузить исторические данные. Нажмите «Обновить».';
        return;
    }

    let rows = [];
    allBonds.forEach(b => {
        const result = computeFor(b, cfg.period);
        if (result.change !== null && Math.abs(result.change) > cfg.threshold) rows.push({ b, result });
    });

    const found = rows.length;
    if (rows.length > BLOCK_LIMIT) {
        rows.sort((a, c) => Math.abs(c.result.change) - Math.abs(a.result.change));
        rows = rows.slice(0, BLOCK_LIMIT);
    }
    rows.sort((a, c) => a.result.change - c.result.change); // от красного к зелёному

    const baseNote = cfg.period === 'day' ? 'база: вчерашняя цена закрытия' : `база: ${humanDate(bases[cfg.period].date)}`;
    els.note.textContent = found
        ? `Найдено: ${found}${found > BLOCK_LIMIT ? ` (показаны ${BLOCK_LIMIT} с наибольшим изменением)` : ''}. ${baseNote}`
        : `Сейчас нет таких облигаций (${baseNote}).`;

    els.grid.replaceChildren(...rows.map(({ b, result }) => {
        const c = createCard(b);
        fillCard(c, b, result, cfg.period);
        return c.card;
    }));
}

/* ---------- quotes ---------- */

function applySnapshot(snapshot) {
    lastSnapshot = snapshot;
    allBonds = Array.from(snapshot.values());
    allBonds.forEach(b => { bondById[b.secid] = b; });

    renderList();
    renderSummary();
    BLOCKS.forEach(renderBlock);
    if (modalSecid) renderBondLive();
    kickBackgroundBases();

    let updated = 0;
    allBonds.forEach(b => { if (computeFor(b, currentPeriod).change !== null) updated++; });
    return updated;
}

function okStatusText(updated) {
    let text = `Обновлено ${updated} облигаций в ${new Date().toLocaleTimeString('ru-RU')} ` +
        `(MOEX, задержка ~15 мин) · ${VERSION}`;
    const b = bases[currentPeriod];
    if (currentPeriod !== 'day' && b) text += `. База: ${humanDate(b.date)}`;
    return text;
}

async function fetchQuotes(force = false) {
    if (!isInitialized) return;

    const now = Date.now();
    if (!force && now - lastRequestTime < MIN_REQUEST_GAP) return;

    const token = periodToken;
    if (activeToken === token) return;

    activeToken = token;
    lastRequestTime = now;

    try {
        setStatus('loading', 'Обновление...');

        if (currentPeriod !== 'day' && !basisFresh(currentPeriod) && canTryBasis(currentPeriod, force)) {
            setStatus('loading', 'Загрузка исторической базы (может занять до минуты)...');
            await ensureBasis(currentPeriod);
            if (token !== periodToken) return;
        }

        const snapshot = await fetchSnapshot();
        if (token !== periodToken) return;

        const updated = applySnapshot(snapshot);

        if (currentPeriod !== 'day' && !basisFresh(currentPeriod)) {
            setStatus('error', 'Не удалось загрузить историю — показаны только цены. Нажмите «Обновить».');
        } else {
            setStatus(partialNote ? 'warn' : 'ok', okStatusText(updated) + (partialNote ? ` · ${partialNote}` : ''));
        }
    } catch (err) {
        console.error(err);
        if (token === periodToken) setStatus('error', `Ошибка загрузки облигаций: ${err.message}`);
    } finally {
        if (activeToken === token) activeToken = null;
    }
}

function startTimer() {
    stopTimer();
    updateTimer = setInterval(() => fetchQuotes(), REQUEST_INTERVAL);
}

function stopTimer() {
    if (updateTimer) clearInterval(updateTimer);
    updateTimer = null;
}

async function start() {
    if (isStarting || isInitialized) return;
    isStarting = true;
    clearTimeout(retryTimer);

    const stopProgress = showProgress('Загрузка списка облигаций');
    let snapshot = null;
    let err = null;
    try {
        snapshot = await fetchSnapshot();
    } catch (e) {
        console.error(e);
        err = e;
    } finally {
        stopProgress();
    }

    if (!snapshot) {
        setStatus('error',
            `Ошибка загрузки: ${err ? err.message : 'нет данных'}. ` +
            `Повтор через ${START_RETRY_DELAY / 1000} с или нажмите «Обновить».`);
        isStarting = false;
        retryTimer = setTimeout(start, START_RETRY_DELAY);
        return;
    }

    isInitialized = true;
    isStarting = false;

    const updated = applySnapshot(snapshot);
    if (currentPeriod === 'day') {
        setStatus(partialNote ? 'warn' : 'ok', okStatusText(updated) + (partialNote ? ` · ${partialNote}` : ''));
    } else {
        fetchQuotes(true);
    }
    startTimer();
}

/* ---------- events ---------- */

document.getElementById('stocksLink').href = STOCKS_PAGE;
document.getElementById('newsLink').href = NEWS_PAGE;
document.getElementById('logoutLink').addEventListener('click', e => {
    e.preventDefault();
    try { sessionStorage.removeItem('mx_k'); } catch (_) { /* ignore */ }
    location.reload();
});

document.getElementById('periodSelect').addEventListener('change', e => {
    currentPeriod = e.target.value;
    periodToken++;
    basisFailedAt.week = 0;
    basisFailedAt.month = 0;
    if (lastSnapshot) applySnapshot(lastSnapshot);
    fetchQuotes(true);
});

document.getElementById('refreshBtn').addEventListener('click', () => {
    if (!isInitialized) {
        start();
        return;
    }
    basisFailedAt.week = 0;
    basisFailedAt.month = 0;
    fetchQuotes(true);
});

document.getElementById('modalClose').addEventListener('click', closeBond);
document.getElementById('modal').addEventListener('click', e => {
    if (e.target === document.getElementById('modal')) closeBond();
});
document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modalSecid) closeBond();
});

document.getElementById('searchInput').addEventListener('input', e => {
    searchQuery = String(e.target.value || '').trim().toLowerCase();
    shown = PAGE_SIZE;
    if (isInitialized) renderList();
});

document.addEventListener('visibilitychange', () => {
    if (!isInitialized) return;
    if (document.hidden) {
        stopTimer();
    } else {
        fetchQuotes(true);
        startTimer();
    }
});

renderSorts();
initBlocks();
start();
</script>
</body>
</html>
