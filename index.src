<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тепловая карта акций Мосбиржи — онлайн</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f0f0;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 1200px;
            background: #fff;
            padding: 16px;
            box-shadow: 0 2px 10px rgba(0,0,0,.1);
        }
        .nav { display: flex; gap: 8px; margin-bottom: 10px; font-size: 14px; }
        .nav a {
            padding: 4px 14px; border: 1px solid #ccc; border-radius: 16px;
            color: #333; text-decoration: none; background: #fff;
        }
        .nav a.active { background: #2e7d32; color: #fff; border-color: #2e7d32; }
        .nav a.logout { margin-left: auto; color: #777; }
        .header button.toggle.active { background: #1565c0; border-color: #1565c0; color: #fff; }
        .tabs { display: flex; gap: 6px; margin-top: 12px; }
        .tab {
            flex: 1; padding: 8px 10px; border: 1px solid #ccc; border-radius: 8px;
            background: #fff; font-size: 14px; cursor: pointer; color: #333;
        }
        .tab.active { background: #1565c0; border-color: #1565c0; color: #fff; }
        .row.head span:first-child, .row.head span:last-child { font-weight: bold; color: #333; }
        .sub-h { font-size: 12px; font-weight: bold; color: #555; margin: 10px 0 2px; }
        .upcoming { border: 2px solid #43a047; background: #f1f8e9; border-radius: 8px; padding: 8px 10px; }
        .estimate { border: 2px dashed #f9a825; background: #fffde7; border-radius: 8px; padding: 8px 10px; }
        .header {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
            color: #333;
            flex-wrap: wrap;
            gap: 10px;
        }
        .header select, .header button, .header input {
            padding: 4px 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            background: #fff;
        }
        .header select, .header button { cursor: pointer; }
        .header input { width: 150px; }
        .header button:hover { background: #f5f5f5; }
        .status { font-size: 12px; color: #666; }
        .status.error { color: #c00; font-weight: bold; }
        .status.ok { color: #2e7d32; }
        .status.warn { color: #b26a00; }
        .status.loading { color: #f57c00; }

        .summary {
            margin: 0 0 10px; padding: 8px 10px; background: #fafafa;
            border: 1px solid #eee; border-radius: 4px; font-size: 12px; color: #333; line-height: 1.5;
        }
        .summary .pos, .sheet .pos { color: #2e7d32; font-weight: bold; }
        .summary .neg, .sheet .neg { color: #c62828; font-weight: bold; }
        .breadth { display: flex; height: 6px; margin: 4px 0; border-radius: 3px; overflow: hidden; background: #ddd; }
        .breadth span { display: block; height: 100%; }

        .debug {
            white-space: pre-wrap;
            margin-bottom: 8px;
            padding: 6px 8px;
            background: #f7f7f7;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 11px;
            line-height: 1.35;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 2px;
            background: #fff;
        }
        .card {
            padding: 6px 8px;
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            min-height: 58px;
            color: #fff;
            font-size: 12px;
            line-height: 1.2;
            transition: background-color .3s ease, transform .1s ease, filter .1s ease;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }
        @media (hover: hover) {
            .card:hover { transform: scale(1.02); filter: brightness(1.1); z-index: 1; }
        }
        .card:focus-visible { outline: 2px solid #1565c0; outline-offset: -2px; }
        .card-left {
            display: flex; flex-direction: column; justify-content: space-between;
            flex: 1; min-width: 0; padding-right: 6px; overflow: hidden;
        }
        .card-right {
            display: flex; flex-direction: column; justify-content: space-between;
            align-items: flex-end; text-align: right; white-space: nowrap;
        }
        .name { font-weight: bold; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .price { font-size: 11px; opacity: .95; font-variant-numeric: tabular-nums; }
        .change { font-size: 13px; font-weight: bold; font-variant-numeric: tabular-nums; }
        .delta { font-size: 10px; opacity: .9; font-variant-numeric: tabular-nums; }

        .block-title { font-size: 14px; font-weight: bold; color: #333; margin: 18px 0 4px; }
        .block-note { font-size: 12px; color: #666; margin: 0 0 6px; }

        .bg-pos-5 { background-color: #2e7d32; }
        .bg-pos-4 { background-color: #388e3c; }
        .bg-pos-3 { background-color: #43a047; }
        .bg-pos-2 { background-color: #81c784; color: #1a1a1a; }
        .bg-pos-1 { background-color: #c8e6c9; color: #1a1a1a; }
        .bg-neg-1 { background-color: #ef9a9a; color: #1a1a1a; }
        .bg-neg-2 { background-color: #e57373; color: #1a1a1a; }
        .bg-neg-3 { background-color: #d32f2f; }
        .bg-neg-4 { background-color: #c62828; }
        .bg-neg-5 { background-color: #8e0000; }
        .bg-neutral { background-color: #9e9e9e; color: #fff; }

        /* карточка бумаги */
        .modal {
            position: fixed; inset: 0; background: rgba(0,0,0,.55);
            display: flex; align-items: flex-end; justify-content: center; z-index: 100;
        }
        .modal[hidden] { display: none; }
        .sheet {
            background: #fff; width: 100%; max-width: 560px; max-height: 92vh; overflow-y: auto;
            border-radius: 14px 14px 0 0; padding: 14px 16px 28px; -webkit-overflow-scrolling: touch;
            color: #222;
        }
        @media (min-width: 700px) { .modal { align-items: center; } .sheet { border-radius: 14px; } }
        .sheet-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
        .sheet-title { font-size: 17px; font-weight: bold; }
        .sheet-sub { font-size: 12px; color: #777; margin-top: 2px; }
        .sheet-close {
            border: none; background: #eee; border-radius: 50%; width: 34px; height: 34px;
            font-size: 18px; cursor: pointer; flex: none;
        }
        .sec { margin-top: 14px; }
        .sec h4 { margin: 0 0 6px; font-size: 12px; color: #555; text-transform: uppercase; letter-spacing: .3px; }
        .row {
            display: flex; justify-content: space-between; gap: 12px; padding: 5px 0;
            border-bottom: 1px solid #f0f0f0; font-size: 13px;
        }
        .row span:first-child { color: #666; }
        .row span:last-child { font-weight: bold; text-align: right; font-variant-numeric: tabular-nums; }
        .hist-box { border: 2px solid #f9a825; background: #fffde7; border-radius: 8px; padding: 8px 10px; }
        .note { font-size: 11px; color: #777; margin-top: 6px; line-height: 1.4; }
        .forecast-form { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
        .forecast-form input, .forecast-form select, .forecast-form button, .btn {
            padding: 6px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 13px; background: #fff;
        }
        .forecast-form input { width: 110px; }
        .btn { display: inline-block; text-decoration: none; color: #1565c0; cursor: pointer; margin: 4px 6px 0 0; }
        .btn.primary { background: #1565c0; color: #fff; border-color: #1565c0; }

        /* ---- свечной график ---- */
        .cp { margin-top: 6px; background: #fff; }
        .cp-head, .cp-tools { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
        .cp-btn {
            padding: 5px 9px; border: 1px solid #ccc; border-radius: 6px; background: #fff;
            font-size: 13px; cursor: pointer; color: #333; min-width: 34px;
        }
        .cp-btn.active { background: #1565c0; border-color: #1565c0; color: #fff; }
        .cp-stage { position: relative; width: 100%; height: 300px; background: #fff; border: 1px solid #e5e5e5; border-radius: 6px; overflow: hidden; }
        .cp-canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
        .cp-tip {
            position: absolute; top: 8px; z-index: 5; width: 172px; padding: 6px 8px; pointer-events: none;
            background: rgba(255,255,255,.86); border: 1px solid rgba(0,0,0,.18); border-radius: 6px;
            font-size: 11px; line-height: 1.45; color: #222; box-shadow: 0 2px 8px rgba(0,0,0,.12);
        }
        .cp-tip[hidden] { display: none; }
        .cp-tip b { display: block; margin-bottom: 2px; }
        .cp-tip .r { display: flex; justify-content: space-between; gap: 8px; }
        .cp-tip .up { color: #2e7d32; font-weight: bold; }
        .cp-tip .down { color: #c62828; font-weight: bold; }
        .cp-close { display: none; }
        .cp.cp-full {
            position: fixed; inset: 0; z-index: 500; margin: 0; display: flex; flex-direction: column;
            padding: calc(env(safe-area-inset-top, 0px) + 56px) 10px calc(env(safe-area-inset-bottom, 0px) + 10px);
        }
        .cp.cp-full .cp-close {
            display: block; position: absolute; top: calc(env(safe-area-inset-top, 0px) + 8px); right: 10px; z-index: 2;
            padding: 11px 16px; font-size: 16px; font-weight: bold; color: #fff; background: #c62828;
            border: none; border-radius: 10px; cursor: pointer;
        }
        .cp.cp-full .cp-stage { flex: 1; height: auto; min-height: 0; }
        .ob-row { position: relative; display: flex; justify-content: space-between; padding: 4px 8px; font-size: 13px; font-variant-numeric: tabular-nums; overflow: hidden; }
        .ob-row span { position: relative; z-index: 1; }
        .ob-bar { position: absolute; top: 0; bottom: 0; right: 0; opacity: .22; }
        .ob-sell .ob-bar { background: #c62828; } .ob-sell span:first-child { color: #c62828; font-weight: bold; }
        .ob-buy .ob-bar { background: #2e7d32; } .ob-buy span:first-child { color: #2e7d32; font-weight: bold; }
        .ob-head { display: flex; justify-content: space-between; padding: 4px 8px; font-size: 11px; color: #777; }
        .ob-spread { text-align: center; padding: 6px; font-size: 12px; background: #f5f5f5; color: #555; margin: 2px 0; }
        .news-line { display: block; padding: 8px 2px; border-bottom: 1px solid #eee; text-decoration: none; color: #1a1a1a; }
        .news-line .t { font-size: 14px; line-height: 1.35; font-weight: bold; }
        .news-line .m { font-size: 11px; color: #777; margin-top: 2px; }
        .news-line .m b { color: #1565c0; }
        .star-btn { border: none; background: #eee; border-radius: 50%; width: 34px; height: 34px; font-size: 19px; cursor: pointer; flex: none; color: #9e9e9e; line-height: 1; }
        .star-btn.on { background: #fff8e1; color: #f9a825; }
        .rates { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
        .rate { border: 1px solid #ddd; border-radius: 8px; background: #fafafa; padding: 5px 9px; cursor: pointer; font-size: 11px; text-align: left; line-height: 1.25; color: #444; }
        .rate b { display: block; font-size: 14px; color: #111; }
        .rate .rc.up { color: #2e7d32; font-weight: bold; }
        .rate .rc.down { color: #c62828; font-weight: bold; }
        .head-btns { display: flex; gap: 8px; flex: none; }
        .tabs { flex-wrap: wrap; }
        .tab { flex: 1 1 auto; font-size: 13px; padding: 7px 8px; }
        .info-text { font-size: 13px; line-height: 1.45; margin: 4px 0 6px; }
        table.dt { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 4px; }
        table.dt th { text-align: right; color: #555; font-weight: bold; padding: 4px 3px; border-bottom: 1px solid #ddd; }
        table.dt th:first-child, table.dt td:first-child { text-align: left; }
        table.dt td { text-align: right; padding: 4px 3px; border-bottom: 1px solid #f0f0f0; font-variant-numeric: tabular-nums; }
        @media (max-width: 1000px) { .grid { grid-template-columns: repeat(4, 1fr); } }
        @media (max-width: 768px) {
            body { padding: 8px; }
            .grid { grid-template-columns: repeat(3, 1fr); }
            .card { min-height: 52px; padding: 5px 6px; }
            .name { font-size: 10px; }
            .price { font-size: 9px; }
            .change { font-size: 12px; }
            .delta { font-size: 9px; }
        }
        @media (max-width: 480px) { .grid { grid-template-columns: repeat(2, 1fr); } }
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="#" class="active">Акции</a>
        <a href="bonds.html" id="bondsLink">Облигации</a>
        <a href="favorites.html" id="favLink">Избранное</a>
        <a href="news.html" id="newsLink">Новости</a>
        <a href="#" id="logoutLink" class="logout">Выйти</a>
    </div>
    <div class="rates" id="rates"></div>
    <div class="header">
        <span>Доходность:</span>
        <select id="periodSelect">
            <option value="day">за день</option>
            <option value="week">за неделю</option>
            <option value="month">за месяц</option>
        </select>
        <button id="refreshBtn" title="Обновить сейчас">↻ Обновить</button>
        <button id="orderBtn" class="toggle" title="Порядок плиток: от зелёных к красным или наоборот">⇅ Зелёные → красные</button>
        <button id="divDateBtn" class="toggle" title="Сначала те, у кого ближайшая дата дивидендов">Ближайшие дивиденды</button>
        <button id="divYieldBtn" class="toggle" title="От максимальной дивидендной доходности к минимальной">Див. доходность</button>
        <input id="searchInput" type="search" placeholder="Поиск: тикер или имя" autocomplete="off">
        <span id="status" class="status">Загрузка данных...</span>
        <span id="divStatus" class="status"></span>
    </div>
    <div id="summary" class="summary" hidden></div>
    <div id="debugInfo" class="debug" hidden></div>
    <div class="grid" id="grid"></div>
    <div id="blocks"></div>
</div>

<div id="modal" class="modal" hidden>
    <div class="sheet" role="dialog" aria-modal="true">
        <div class="sheet-head">
            <div>
                <div class="sheet-title" id="modalTitle"></div>
                <div class="sheet-sub" id="modalSub"></div>
            </div>
            <div class="head-btns">
                <button class="star-btn" id="modalStar" aria-label="В избранное" title="В избранное">☆</button>
                <button class="sheet-close" id="modalClose" aria-label="Закрыть">✕</button>
            </div>
        </div>
        <div class="tabs">
            <button class="tab active" id="tabSummary">Сводка</button>
            <button class="tab" id="tabDiv">Дивиденды</button>
            <button class="tab" id="tabInfo">О компании</button>
            <button class="tab" id="tabBook">Стакан</button>
            <button class="tab" id="tabNews">Новости</button>
        </div>
        <div id="paneSummary">
            <div class="sec" id="modalLive"></div>
            <div class="sec" id="modalHist"></div>
            <div class="sec" id="modalForecast"></div>
            <div class="sec" id="modalLinks"></div>
        </div>
        <div id="paneDiv" hidden>
            <div class="sec" id="modalDivTab"></div>
        </div>
        <div id="paneInfo" hidden>
            <div class="sec" id="modalInfo"></div>
        </div>
        <div id="paneBook" hidden>
            <div class="sec" id="modalBook"></div>
        </div>
        <div id="paneNews" hidden>
            <div class="sec" id="modalNews"></div>
        </div>
        <div class="sec" id="modalChart"></div>
    </div>
</div>

<div id="rateModal" class="modal" hidden>
    <div class="sheet" role="dialog" aria-modal="true">
        <div class="sheet-head">
            <div>
                <div class="sheet-title" id="rateTitle"></div>
                <div class="sheet-sub" id="rateSub"></div>
            </div>
            <div class="head-btns">
                <button class="sheet-close" id="rateClose" aria-label="Закрыть">✕</button>
            </div>
        </div>
        <div class="sec" id="rateLive"></div>
        <div class="sec" id="rateHist"></div>
        <div class="sec" id="rateChart"></div>
    </div>
</div>

<script>
'use strict';

/*
 * MOEX Heatmap v21 (акции)
 *
 *  • Главная сетка: выбранный период (день / неделя / месяц), все акции TQBR.
 *  • Нули (0,00 %) уходят в конец списка.
 *  • Нижние блоки: изменение за день > 7 %, за неделю > 15 %, за месяц > 35 % (константы EXTREME_BLOCKS).
 *  • Сводка рынка: IMOEX, ширина рынка, оборот, топ-10 по обороту.
 *  • Тап по плитке — карточка бумаги: день, исторические min/max, дивиденды, свой прогноз.
 *  • Отладка:  ?debug=OZON  или  ?debug=OZON&bcs=34.22
 */

const VERSION = 'v21';
const BONDS_PAGE = 'bonds.html';
const NEWS_PAGE = 'news.html';
const FAV_PAGE = 'favorites.html';

const MOEX_ISS = 'https://iss.moex.com/iss';
const BOARD = 'TQBR';
const BOARD_PATH = `${MOEX_ISS}/engines/stock/markets/shares/boards/${BOARD}`;
const HISTORY_PATH = `${MOEX_ISS}/history/engines/stock/markets/shares/boards/${BOARD}`;

const REQUEST_INTERVAL = 15000;
const MIN_REQUEST_GAP = 2000;
const FETCH_TIMEOUT = 25000;
const FETCH_RETRIES = 2;
const START_RETRY_DELAY = 10000;
const HISTORY_RETRY_DELAY = 60000;
const MAX_BACK_DAYS = 10;
const HIST_BATCH = 6;
const HIST_TTL = 12 * 3600 * 1000;
const TOP_TURNOVER_COUNT = 10;
const CACHE_KEY = 'moexHeatmap.snapshot.v2';
const DIV_CACHE_KEY = 'moexHeatmap.div.v1';
const DIV_TTL = 6 * 3600 * 1000;
const DIV_CONCURRENCY = 8;

/* Кандидаты на разворот: формальный отбор по цифрам (не прогноз). */
const REVERSAL = {
    baseDate: '2022-02-23',      // точка отсчёта
    minDrop: 30,                 // падение к цене на baseDate не меньше, %
    minNewLowMonths: 3,          // сколько месяцев обновлялся абсолютный минимум после марта 2022
    maxMonthsSinceLow: 12,       // последний минимум не старше, месяцев
    minAvgTurnover: 50e6,        // средний дневной оборот, ₽
    maxCandidates: 150,
    concurrency: 8,
    cacheKey: 'moexHeatmap.rev.v1',
    baseKey: 'moexHeatmap.base2022.v1',
    ttl: 12 * 3600 * 1000
};

const EXTREME_BLOCKS = [
    { key: 'day',   period: 'day',   threshold: 5,  label: 'за день' },
    { key: 'week',  period: 'week',  threshold: 15, label: 'за неделю' },
    { key: 'month', period: 'month', threshold: 35, label: 'за месяц' }
];
const PERIOD_LABEL = { day: 'за день', week: 'за неделю', month: 'за месяц' };

const DEBUG_PARAMS = new URLSearchParams(location.search);
const DEBUG = DEBUG_PARAMS.has('debug');
const DEBUG_TICKER = (DEBUG_PARAMS.get('debug') || 'OZON').toUpperCase();
const DEBUG_BCS = parseFloat(String(DEBUG_PARAMS.get('bcs') || '').replace(',', '.'));

const ALLOWED_SECTYPES = new Set([1, 2]);
const COLOR_SCALE = { day: 1, week: 2.5, month: 5 };

let allStocks = [];
const stockByTicker = {};
let currentPeriod = document.getElementById('periodSelect').value || 'day'; // Safari восстанавливает select
const bases = { week: null, month: null };
const basisPromises = { week: null, month: null };
const basisFailedAt = { week: 0, month: 0 };
const currentChanges = {};
const cardEls = {};
const blockEls = {};
let topEls = null;

let updateTimer = null;
let retryTimer = null;
let lastRequestTime = 0;
let activeToken = null;
let periodToken = 0;
let isStarting = false;
let isInitialized = false;
let lastSnapshot = null;
let imoex = null;
let searchQuery = '';

let modalTicker = null;
const histStats = {};
const histPromises = {};
const histProgress = {};
const histErrors = {};
const divData = {};
const divPromises = {};

let sortMode = 'change';          // 'change' | 'divDate' | 'divYield'
let divAllLoaded = false;
let divAllPromise = null;
const divProgress = { done: 0, total: 0 };
let modalTab = 'summary';
const upcomingMap = {};          // тикер -> предстоящая выплата (календарь smart-lab)
let colorAsc = false;            // порядок плиток: false — зелёные → красные, true — красные → зелёные
try { colorAsc = localStorage.getItem('mx.pref.order') === 'asc'; } catch (_) { /* ignore */ }
let chartPanel = null;
let revEls = null;
const revState = { status: 'idle', scheduled: false, analysis: null, progress: { done: 0, total: 0 }, error: null };

let debugRows = null;
let debugRowsKey = null;

/* ---------- network ---------- */

const sleep = ms => new Promise(r => setTimeout(r, ms));

async function fetchWithTimeout(url, timeout) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);
    try {
        return await fetch(url, { cache: 'no-store', signal: controller.signal });
    } catch (e) {
        if (e && e.name === 'AbortError') throw new Error('MOEX не ответил вовремя');
        throw new Error('нет связи с MOEX (сеть или блокировка)');
    } finally {
        clearTimeout(timer);
    }
}

async function fetchJson(url, { timeout = FETCH_TIMEOUT, retries = FETCH_RETRIES } = {}) {
    let lastErr;
    for (let attempt = 1; attempt <= retries; attempt++) {
        try {
            const response = await fetchWithTimeout(url, timeout);
            if (!response.ok) {
                const err = new Error(`HTTP ${response.status}`);
                err.status = response.status;
                throw err;
            }
            try {
                return await response.json();
            } catch (_) {
                throw new Error('MOEX вернул некорректный ответ');
            }
        } catch (e) {
            lastErr = e;
            const clientErr = e.status >= 400 && e.status < 500 && e.status !== 429;
            if (clientErr || attempt === retries) break;
            await sleep(1000 * attempt);
        }
    }
    throw lastErr;
}

/* ---------- utilities ---------- */

function num(v) {
    if (v === null || v === undefined || v === '') return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
}

function setStatus(cls, text) {
    const box = document.getElementById('status');
    box.className = 'status' + (cls ? ' ' + cls : '');
    box.textContent = text;
}

function showProgress(label) {
    const t0 = Date.now();
    const tick = () => setStatus('loading', `${label}... ${Math.round((Date.now() - t0) / 1000)} с`);
    tick();
    const id = setInterval(tick, 1000);
    return () => clearInterval(id);
}

function moscowDateStr(date) {
    return new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Moscow' }).format(date);
}

/* Календарный сдвиг без переполнения: 31 окт − 1 мес = 30 сен. */
function shiftDateStr(dateStr, { days = 0, months = 0 } = {}) {
    const [y, m, d] = dateStr.split('-').map(Number);
    let dt;
    if (months) {
        const total = y * 12 + (m - 1) + months;
        const ny = Math.floor(total / 12);
        const nm = total % 12;
        const lastDay = new Date(Date.UTC(ny, nm + 1, 0)).getUTCDate();
        dt = new Date(Date.UTC(ny, nm, Math.min(d, lastDay)));
    } else {
        dt = new Date(Date.UTC(y, m - 1, d));
    }
    if (days) dt.setUTCDate(dt.getUTCDate() + days);
    return dt.toISOString().slice(0, 10);
}

function humanDate(dateStr) {
    if (!dateStr) return '—';
    const [y, m, d] = String(dateStr).slice(0, 10).split('-');
    return `${d}.${m}.${y}`;
}

function isValidStock(name, sectype) {
    if (!ALLOWED_SECTYPES.has(Number(sectype))) return false;
    const n = (name || '').toUpperCase();
    if (n.includes('ETF')) return false;
    if (n.includes('ПИФ')) return false;
    return true;
}

function readJson(key) {
    try { return JSON.parse(localStorage.getItem(key)); } catch (_) { return null; }
}

function writeJson(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch (_) { /* квота / приватный режим */ }
}

function mk(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    return e;
}

/* ---------- formatting ---------- */

const nfCache = {};

function nf(decimals) {
    if (!nfCache[decimals]) {
        nfCache[decimals] = new Intl.NumberFormat('ru-RU', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
        });
    }
    return nfCache[decimals];
}

function defaultDecimals(price) {
    const a = Math.abs(price);
    if (a < 1) return 4;
    if (a < 10) return 3;
    return 2;
}

function formatPrice(price, decimals) {
    if (price === null || price === undefined || isNaN(price)) return '—';
    const dec = Number.isInteger(decimals) ? decimals : defaultDecimals(price);
    return nf(dec).format(price);
}

function formatChange(change) {
    if (change === null || change === undefined || isNaN(change)) return '—';
    const rounded = Math.round(change * 100) / 100;
    if (rounded === 0) return '0,00 %';
    const sign = rounded > 0 ? '+' : '−';
    return sign + nf(2).format(Math.abs(rounded)) + ' %';
}

function formatRubDelta(delta, decimals, price) {
    if (delta === null || delta === undefined || isNaN(delta)) return '—';
    const dec = Number.isInteger(decimals) ? decimals : defaultDecimals(price ?? delta);
    const factor = Math.pow(10, dec);
    const rounded = Math.round(delta * factor) / factor;
    if (rounded === 0) return nf(dec).format(0) + ' ₽';
    const sign = rounded > 0 ? '+' : '−';
    return sign + nf(dec).format(Math.abs(rounded)) + ' ₽';
}

function formatMoney(v) {
    if (v === null || v === undefined || isNaN(v)) return '—';
    if (v >= 1e12) return nf(2).format(v / 1e12) + ' трлн ₽';
    if (v >= 1e9) return nf(2).format(v / 1e9) + ' млрд ₽';
    if (v >= 1e6) return nf(1).format(v / 1e6) + ' млн ₽';
    return nf(0).format(v) + ' ₽';
}

function formatInt(v) {
    if (v === null || v === undefined || isNaN(v)) return '—';
    return nf(0).format(v);
}

function signCls(v) {
    if (v === null || v === undefined || isNaN(v)) return '';
    const r = Math.round(v * 100) / 100;
    return r > 0 ? 'pos' : r < 0 ? 'neg' : '';
}

/* ---------- color ---------- */

function getBgClass(change, period = currentPeriod) {
    if (change === null || change === undefined || isNaN(change)) return 'bg-neutral';
    if (Math.round(change * 100) / 100 === 0) return 'bg-neutral';

    const k = COLOR_SCALE[period] || 1;
    const abs = Math.abs(change) / k;

    let level;
    if (abs >= 5) level = 5;
    else if (abs >= 2) level = 4;
    else if (abs >= 1) level = 3;
    else if (abs >= 0.5) level = 2;
    else level = 1;

    return (change > 0 ? 'bg-pos-' : 'bg-neg-') + level;
}

/* ---------- BCS ---------- */

function bcsUrl(ticker) {
    return `https://lk.bcs.ru/catalog?popup=/catalog/instrument/${encodeURIComponent(ticker)}/TQBR`;
}

function openBcsPage(ticker) {
    window.open(bcsUrl(ticker), '_blank', 'noopener');
}

/* ---------- cards ---------- */

function createCard(stock) {
    const card = mk('div', 'card bg-neutral');
    card.dataset.ticker = stock.ticker;
    card.dataset.search = `${stock.name} ${stock.ticker}`.toLowerCase();
    card.tabIndex = 0;
    card.setAttribute('role', 'button');

    const left = mk('div', 'card-left');
    const nameEl = mk('div', 'name', (FavStore.has('s', stock.ticker) ? '★ ' : '') + stock.name);
    nameEl.title = `${stock.name} (${stock.ticker})`;
    const priceEl = mk('div', 'price', '—');
    left.append(nameEl, priceEl);

    const right = mk('div', 'card-right');
    const changeEl = mk('div', 'change', '—');
    const deltaEl = mk('div', 'delta', '—');
    right.append(changeEl, deltaEl);
    card.append(left, right);

    card.addEventListener('click', () => openStock(stock.ticker));
    card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openStock(stock.ticker);
        }
    });

    return { card, name: nameEl, price: priceEl, change: changeEl, delta: deltaEl };
}

function fillCard(els, stock, result, period) {
    els.price.textContent = formatPrice(result.price, stock.decimals);
    els.change.textContent = formatChange(result.change);
    els.delta.textContent = formatRubDelta(result.delta, stock.decimals, result.price);
    els.card.className = 'card ' + getBgClass(result.change, period);
}

function renderCard(container, stock) {
    const els = createCard(stock);
    container.appendChild(els.card);
    cardEls[stock.ticker] = els;
}

function updateCard(stock, result) {
    const els = cardEls[stock.ticker];
    if (!els) return;
    fillCard(els, stock, result, currentPeriod);
    currentChanges[stock.ticker] = result.change;
}

function resetCard(ticker) {
    const els = cardEls[ticker];
    if (!els) return;
    els.change.textContent = '—';
    els.delta.textContent = '—';
    els.card.className = 'card bg-neutral';
    currentChanges[ticker] = null;
}

/* Порядок: рост → падение → без изменений (0,00 %) → нет данных. Нули уходят в самый конец.
   При включённой дивидендной сортировке порядок задаётся датой / доходностью дивидендов. */
function sortCards() {
    const isNum = c => c != null && !isNaN(c);
    const isZero = c => Math.round(c * 100) / 100 === 0;
    const group = c => (!isNum(c) ? 2 : isZero(c) ? 1 : 0);

    const entries = allStocks.map(s => ({ ticker: s.ticker, change: currentChanges[s.ticker] }));

    if (sortMode !== 'change' && divAllLoaded) {
        entries.forEach(e => { e.div = divSummary(e.ticker); });
        if (sortMode === 'divDate') {
            const key = e => {
                const d = e.div;
                if (d && d.upcoming) return { g: 0, d: String(d.upcoming.date).slice(0, 10) };
                if (d && d.est) return { g: 1, d: d.est.date };
                return { g: 2, d: '' };
            };
            entries.sort((a, b) => {
                const ka = key(a);
                const kb = key(b);
                if (ka.g !== kb.g) return ka.g - kb.g;
                if (ka.d !== kb.d) return ka.d.localeCompare(kb.d);
                return a.ticker.localeCompare(b.ticker);
            });
        } else {
            // сначала бумаги с объявленной выплатой (по её доходности), затем по доходности за 12 месяцев, затем остальные
            const key = e => {
                const d = e.div;
                if (d && d.upcoming && d.upYield !== null && d.upYield !== undefined) return { g: 0, y: d.upYield };
                if (d && d.yieldTtm > 0) return { g: 1, y: d.yieldTtm };
                return { g: 2, y: 0 };
            };
            entries.sort((a, b) => {
                const ka = key(a);
                const kb = key(b);
                if (ka.g !== kb.g) return ka.g - kb.g;
                if (ka.y !== kb.y) return kb.y - ka.y;
                return a.ticker.localeCompare(b.ticker);
            });
        }
    } else {
        entries.sort((a, b) => {
            const ga = group(a.change);
            const gb = group(b.change);
            if (ga !== gb) return ga - gb;
            if (ga === 0 && a.change !== b.change) return colorAsc ? a.change - b.change : b.change - a.change;
            return a.ticker.localeCompare(b.ticker);
        });
    }

    entries.forEach((entry, index) => {
        const els = cardEls[entry.ticker];
        if (els) els.card.style.order = index;
    });
}

function applySearch() {
    allStocks.forEach(stock => {
        const els = cardEls[stock.ticker];
        if (!els) return;
        const match = !searchQuery || els.card.dataset.search.includes(searchQuery);
        els.card.style.display = match ? '' : 'none';
    });
}

/* ---------- snapshot ---------- */

async function fetchSnapshot() {
    const url =
        `${BOARD_PATH}/securities.json?iss.meta=off&iss.only=securities,marketdata` +
        `&securities.columns=SECID,SHORTNAME,SECNAME,SECTYPE,DECIMALS,PREVPRICE,PREVLEGALCLOSEPRICE,LOTSIZE,ISIN` +
        `&marketdata.columns=SECID,LAST,MARKETPRICE,OPEN,LOW,HIGH,VOLTODAY,VALTODAY,NUMTRADES,WAPRICE,BID,OFFER,ISSUECAPITALIZATION`;

    const data = await fetchJson(url);
    const sec = data.securities;
    const md = data.marketdata;

    if (!sec || !Array.isArray(sec.data) || !sec.data.length) {
        throw new Error('MOEX вернул пустой список бумаг');
    }
    if (!md || !Array.isArray(md.data)) {
        throw new Error('MOEX вернул пустые котировки');
    }

    const idx = cols => Object.fromEntries(cols.map((c, i) => [String(c).toUpperCase(), i]));
    const si = idx(sec.columns);
    const mi = idx(md.columns);

    const snapshot = new Map();

    sec.data.forEach(row => {
        const secid = row[si.SECID];
        if (!secid) return;

        snapshot.set(secid, {
            ticker: secid,
            name: row[si.SHORTNAME] || secid,
            secname: row[si.SECNAME] || null,
            sectype: row[si.SECTYPE],
            decimals: num(row[si.DECIMALS]),
            prevPrice: num(row[si.PREVPRICE]),
            prevLegal: num(row[si.PREVLEGALCLOSEPRICE]),
            lotSize: num(row[si.LOTSIZE]),
            isin: row[si.ISIN] || null,
            last: null, marketPrice: null, open: null, low: null, high: null,
            volToday: null, valToday: null, numTrades: null, waPrice: null,
            bid: null, offer: null, cap: null
        });
    });

    md.data.forEach(row => {
        const item = snapshot.get(row[mi.SECID]);
        if (!item) return;
        item.last = num(row[mi.LAST]);
        item.marketPrice = num(row[mi.MARKETPRICE]);
        item.open = num(row[mi.OPEN]);
        item.low = num(row[mi.LOW]);
        item.high = num(row[mi.HIGH]);
        item.volToday = num(row[mi.VOLTODAY]);
        item.valToday = num(row[mi.VALTODAY]);
        item.numTrades = num(row[mi.NUMTRADES]);
        item.waPrice = num(row[mi.WAPRICE]);
        item.bid = num(row[mi.BID]);
        item.offer = num(row[mi.OFFER]);
        item.cap = num(row[mi.ISSUECAPITALIZATION]);
    });

    return snapshot;
}

async function fetchIndex() {
    const data = await fetchJson(
        `${MOEX_ISS}/engines/stock/markets/index/securities/IMOEX.json?iss.meta=off&iss.only=marketdata`,
        { retries: 1, timeout: 10000 }
    );
    const md = data.marketdata;
    if (!md || !Array.isArray(md.data) || !md.data.length) return null;
    const ix = name => col(md.columns, name);
    const row = md.data.find(r => r[ix('SECID')] === 'IMOEX') || md.data[0];
    const value = num(row[ix('CURRENTVALUE')]) ?? num(row[ix('LASTVALUE')]);
    const pct = num(row[ix('LASTCHANGEPRC')]);
    return value === null ? null : { value, pct };
}

/*
 * LAST — живая цена последней сделки (включая утреннюю сессию).
 * MARKETPRICE — расчётная цена прошлых дней, поэтому только в самую последнюю очередь.
 */
function currentPrice(item) {
    return item.last ?? item.prevPrice ?? item.prevLegal ?? item.marketPrice ?? null;
}

function saveSnapshotCache(snapshot) {
    writeJson(CACHE_KEY, { time: Date.now(), items: Array.from(snapshot.values()) });
}

function loadSnapshotCache() {
    const obj = readJson(CACHE_KEY);
    if (!obj || !Array.isArray(obj.items) || !obj.items.length) return null;
    return { time: obj.time, snapshot: new Map(obj.items.map(i => [i.ticker, i])) };
}

/* ---------- calculation ---------- */

function makeResult(price, base) {
    if (price === null || base === null || base === undefined || base <= 0) {
        return { price, base: null, delta: null, change: null };
    }
    const delta = price - base;
    return { price, base, delta, change: (delta / base) * 100 };
}

function basisKey(period) {
    return `${period}:${moscowDateStr(new Date())}`;
}

function basisFresh(period) {
    if (period === 'day') return true;
    const b = bases[period];
    return !!b && b.key === basisKey(period);
}

function computeFor(item, period) {
    const price = currentPrice(item);
    if (price === null) return { price: null, base: null, delta: null, change: null };

    if (period === 'day') return makeResult(price, item.prevPrice ?? item.prevLegal);
    if (!basisFresh(period)) return makeResult(price, null);
    return makeResult(price, bases[period].map[item.ticker] ?? null);
}

/* ---------- history ---------- */

async function fetchHistoryDay(dateStr, preferredField = 'CLOSE') {
    const pageUrl = start =>
        `${HISTORY_PATH}/securities.json?date=${dateStr}&start=${start}` +
        `&iss.meta=off&iss.only=history,history.cursor` +
        `&history.columns=SECID,TRADEDATE,CLOSE,LEGALCLOSEPRICE,WAPRICE`;

    const map = {};
    const kinds = {};

    const parse = data => {
        const h = data.history;
        if (!h || !Array.isArray(h.data)) return 0;

        const iSec = col(h.columns, 'SECID');
        const iClose = col(h.columns, 'CLOSE');
        const iLegal = col(h.columns, 'LEGALCLOSEPRICE');
        const iWap = col(h.columns, 'WAPRICE');

        h.data.forEach(row => {
            const secid = row[iSec];
            const close = num(row[iClose]);
            const legal = num(row[iLegal]);
            const wap = num(row[iWap]);

            let value = null;
            let kind = null;

            if (preferredField === 'WAPRICE' && wap !== null && wap > 0) {
                value = wap; kind = 'WAPRICE';
            } else if (close !== null && close > 0) {
                value = close; kind = 'CLOSE';
            } else if (legal !== null && legal > 0) {
                value = legal; kind = 'LEGALCLOSEPRICE';
            }

            if (secid && value !== null) {
                map[secid] = value;
                kinds[secid] = kind;
            }
        });

        return h.data.length;
    };

    const first = await fetchJson(pageUrl(0));
    const rowsOnFirst = parse(first);
    if (rowsOnFirst === 0) return null; // нерабочий день

    const cursor = first['history.cursor'];
    if (cursor && cursor.data && cursor.data.length) {
        const ci = cursor.columns;
        const total = num(cursor.data[0][col(ci, 'TOTAL')]) || rowsOnFirst;
        const pageSize = num(cursor.data[0][col(ci, 'PAGESIZE')]) || rowsOnFirst;
        const pages = [];
        for (let start = pageSize; start < total; start += pageSize) {
            pages.push(fetchJson(pageUrl(start)));
        }
        (await Promise.all(pages)).forEach(parse);
    }

    return { map, kinds };
}

async function loadBasis(period) {
    const today = moscowDateStr(new Date());

    let startDate;
    let field;
    if (period === 'month') {
        // последний торговый день ДО даты «месяц назад»
        startDate = shiftDateStr(shiftDateStr(today, { months: -1 }), { days: -1 });
        field = 'WAPRICE';
    } else {
        // ближайший торговый день на дату «неделя назад» или раньше
        startDate = shiftDateStr(today, { days: -7 });
        field = 'CLOSE';
    }

    for (let i = 0; i <= MAX_BACK_DAYS; i++) {
        const dateStr = shiftDateStr(startDate, { days: -i });
        const r = await fetchHistoryDay(dateStr, field);
        if (r && Object.keys(r.map).length) {
            return { period, key: `${period}:${today}`, date: dateStr, kind: field, map: r.map, kinds: r.kinds };
        }
    }
    return null;
}

function canTryBasis(period, force) {
    return force || !basisFailedAt[period] || Date.now() - basisFailedAt[period] > HISTORY_RETRY_DELAY;
}

function ensureBasis(period) {
    if (period === 'day' || basisFresh(period)) return Promise.resolve(true);
    if (basisPromises[period]) return basisPromises[period];

    basisPromises[period] = (async () => {
        try {
            const loaded = await loadBasis(period);
            if (loaded) {
                bases[period] = loaded;
                basisFailedAt[period] = 0;
                return true;
            }
            basisFailedAt[period] = Date.now();
            return false;
        } catch (e) {
            console.error(e);
            basisFailedAt[period] = Date.now();
            return false;
        } finally {
            basisPromises[period] = null;
        }
    })();

    return basisPromises[period];
}

/* Недельная и месячная базы нужны нижним блокам всегда, независимо от выбранного периода. */
function kickBackgroundBases() {
    ['week', 'month'].forEach(period => {
        if (basisFresh(period) || basisPromises[period] || !canTryBasis(period, false)) return;
        ensureBasis(period).then(() => {
            if (lastSnapshot) applySnapshot(lastSnapshot);
        });
    });
}

/* ---------- блоки внизу ---------- */

function initBlocks() {
    const container = document.getElementById('blocks');

    EXTREME_BLOCKS.forEach(cfg => {
        const title = mk('div', 'block-title');
        const note = mk('div', 'block-note');
        const grid = mk('div', 'grid');
        container.append(title, note, grid);
        blockEls[cfg.key] = { title, note, grid };
    });

    const title = mk('div', 'block-title', `Топ-${TOP_TURNOVER_COUNT} по обороту сегодня`);
    const note = mk('div', 'block-note');
    const grid = mk('div', 'grid');
    container.append(title, note, grid);
    topEls = { title, note, grid };

    const rTitle = mk('div', 'block-title');
    const rNote = mk('div', 'block-note');
    const rGrid = mk('div', 'grid');
    container.append(rTitle, rNote, rGrid);
    revEls = { title: rTitle, note: rNote, grid: rGrid };
}

function renderExtremeBlock(cfg, snapshot) {
    const els = blockEls[cfg.key];
    els.title.textContent = `Изменение ${cfg.label} более ${cfg.threshold} % (от красного к зелёному)`;

    if (!basisFresh(cfg.period)) {
        els.grid.replaceChildren();
        els.note.textContent = basisPromises[cfg.period] || !basisFailedAt[cfg.period]
            ? 'Загрузка исторических данных...'
            : 'Не удалось загрузить исторические данные. Нажмите «Обновить».';
        return;
    }

    const rows = [];
    allStocks.forEach(stock => {
        const item = snapshot.get(stock.ticker);
        if (!item) return;
        const result = computeFor(item, cfg.period);
        if (result.change !== null && Math.abs(result.change) > cfg.threshold) {
            rows.push({ stock, result });
        }
    });

    rows.sort((a, b) => a.result.change - b.result.change); // от красного к зелёному

    const baseNote = cfg.period === 'day' ? 'база: вчерашнее закрытие' : `база: ${humanDate(bases[cfg.period].date)}`;
    els.note.textContent = rows.length ? `Найдено: ${rows.length}. ${baseNote}` : `Сейчас нет таких бумаг (${baseNote}).`;

    els.grid.replaceChildren(...rows.map(({ stock, result }) => {
        const c = createCard(stock);
        fillCard(c, stock, result, cfg.period);
        return c.card;
    }));
}

function renderTopTurnover(snapshot) {
    const rows = [];
    allStocks.forEach(stock => {
        const item = snapshot.get(stock.ticker);
        if (item && item.valToday > 0) rows.push({ stock, item });
    });
    rows.sort((a, b) => b.item.valToday - a.item.valToday);
    const top = rows.slice(0, TOP_TURNOVER_COUNT);

    topEls.title.textContent = `Топ-${TOP_TURNOVER_COUNT} по обороту сегодня (цвет — изменение ${PERIOD_LABEL[currentPeriod]})`;
    topEls.note.textContent = top.length
        ? top.map(r => `${r.stock.ticker} ${formatMoney(r.item.valToday)}`).join(' · ')
        : 'Сегодня торгов ещё не было.';

    topEls.grid.replaceChildren(...top.map(({ stock, item }) => {
        const c = createCard(stock);
        fillCard(c, stock, computeFor(item, currentPeriod), currentPeriod);
        return c.card;
    }));
}

function renderSummary(snapshot) {
    const box = document.getElementById('summary');
    if (!allStocks.length) {
        box.hidden = true;
        return;
    }
    box.hidden = false;

    let up = 0;
    let down = 0;
    let flat = 0;
    const values = [];
    let turnover = 0;

    allStocks.forEach(stock => {
        const c = currentChanges[stock.ticker];
        if (c !== null && c !== undefined && !isNaN(c)) {
            values.push(c);
            const r = Math.round(c * 100) / 100;
            if (r > 0) up++;
            else if (r < 0) down++;
            else flat++;
        }
        const item = snapshot.get(stock.ticker);
        if (item && item.valToday > 0) turnover += item.valToday;
    });

    values.sort((a, b) => a - b);
    const median = values.length
        ? (values.length % 2 ? values[(values.length - 1) / 2] : (values[values.length / 2 - 1] + values[values.length / 2]) / 2)
        : null;
    const total = up + down + flat;

    const lines = [];

    if (imoex) {
        const l = mk('div');
        l.append('Индекс МосБиржи: ');
        l.append(mk('b', null, nf(2).format(imoex.value)));
        if (imoex.pct !== null) l.append(' ', mk('span', signCls(imoex.pct), formatChange(imoex.pct)));
        lines.push(l);
    }

    const breadthLine = mk('div');
    breadthLine.append(`Ширина рынка ${PERIOD_LABEL[currentPeriod]}: `);
    breadthLine.append(mk('span', 'pos', `растут ${up}`), ' · ', mk('span', 'neg', `падают ${down}`), ` · без изм. ${flat}`);
    lines.push(breadthLine);

    const bar = mk('div', 'breadth');
    if (total) {
        const parts = [[up, '#43a047'], [flat, '#9e9e9e'], [down, '#c62828']];
        parts.forEach(([n, color]) => {
            const s = mk('span');
            s.style.width = `${(n / total) * 100}%`;
            s.style.background = color;
            bar.append(s);
        });
    }
    lines.push(bar);

    const stat = mk('div');
    stat.append(`Оборот сегодня: ${formatMoney(turnover)}`);
    if (median !== null) stat.append(' · медиана: ', mk('span', signCls(median), formatChange(median)));
    lines.push(stat);

    box.replaceChildren(...lines);
}

/* ====== СВЕЧНОЙ ГРАФИК (общий код акций и облигаций) ====== */

/* Поиск колонки без учёта регистра: MOEX отдаёт имена то строчными, то заглавными. */
function col(columns, name) {
    const n = String(name).toLowerCase();
    return (columns || []).findIndex(c => String(c).toLowerCase() === n);
}

/* ISS умеет свечи 1 / 10 / 60 мин, день, неделя, месяц. 5 и 15 минут собираем из минутных. */
const CHART_TF = [
    { key: '1m',  label: '1м',      kind: 'intra',  agg: 1,  days: 1 },
    { key: '5m',  label: '5м',      kind: 'intra',  agg: 5,  days: 2 },
    { key: '15m', label: '15м',     kind: 'intra',  agg: 15, days: 3 },
    { key: '1h',  label: '1ч',      kind: 'native', interval: 60 },
    { key: '1d',  label: 'День',    kind: 'native', interval: 24 },
    { key: '1w',  label: 'Неделя',  kind: 'native', interval: 7 },
    { key: '1M',  label: 'Месяц',   kind: 'native', interval: 31 }
];
const CHART_TF_MAP = Object.fromEntries(CHART_TF.map(t => [t.key, t]));
const CHART_DEFAULT_VISIBLE = { '1m': 120, '5m': 90, '15m': 80, '1h': 80, '1d': 90, '1w': 104, '1M': 60 };
const tradesCache = {};

async function fetchCandlePages(base, query) {
    const out = [];
    let start = 0;
    for (let page = 0; page < 14; page++) {
        const url = `${base}/candles.json?${query}&start=${start}&iss.meta=off&iss.only=candles` +
            `&candles.columns=begin,open,close,high,low,value,volume`;
        const data = await fetchJson(url, { retries: 2, timeout: 20000 });
        const c = data.candles;
        if (!c || !Array.isArray(c.data)) break;
        const iB = col(c.columns, 'begin');
        const iO = col(c.columns, 'open');
        const iC = col(c.columns, 'close');
        const iH = col(c.columns, 'high');
        const iL = col(c.columns, 'low');
        const iV = col(c.columns, 'volume');
        const iVal = col(c.columns, 'value');
        c.data.forEach(r => {
            const o = num(r[iO]);
            const cl = num(r[iC]);
            const h = num(r[iH]);
            const l = num(r[iL]);
            if (o === null || cl === null || h === null || l === null) return;
            out.push({ t: String(r[iB]).replace('T', ' '), o, c: cl, h, l, v: num(r[iV]), val: num(r[iVal]) });
        });
        if (c.data.length < 500) break; // ISS отдаёт максимум 500 свечей за запрос
        start += c.data.length;
    }
    return out;
}

function aggregateCandles(rows, agg) {
    const out = [];
    let cur = null;
    let curKey = null;
    rows.forEach(r => {
        const day = r.t.slice(0, 10);
        const mins = Number(r.t.slice(11, 13)) * 60 + Number(r.t.slice(14, 16));
        const bucket = Math.floor(mins / agg);
        const key = `${day}#${bucket}`;
        if (key !== curKey) {
            const bm = bucket * agg;
            const hh = String(Math.floor(bm / 60)).padStart(2, '0');
            const mm = String(bm % 60).padStart(2, '0');
            cur = { t: `${day} ${hh}:${mm}:00`, o: r.o, c: r.c, h: r.h, l: r.l, v: r.v || 0, val: r.val || 0 };
            out.push(cur);
            curKey = key;
        } else {
            cur.h = Math.max(cur.h, r.h);
            cur.l = Math.min(cur.l, r.l);
            cur.c = r.c;
            cur.v += r.v || 0;
            cur.val += r.val || 0;
        }
    });
    return out;
}

async function loadChartData(cfg, tf) {
    const today = moscowDateStr(new Date());
    const enc = encodeURIComponent;

    if (tf.kind === 'intra') {
        const chunks = [];
        let found = 0;
        for (let i = 0; i < 10 && found < tf.days; i++) {
            const d = shiftDateStr(today, { days: -i });
            const rows = await fetchCandlePages(cfg.candlesBase,
                `interval=1&from=${enc(d + ' 00:00:00')}&till=${enc(d + ' 23:59:59')}`);
            if (rows.length) {
                chunks.unshift(rows);
                found++;
            }
        }
        let rows = chunks.flat();
        if (tf.agg > 1) rows = aggregateCandles(rows, tf.agg);
        const what = tf.agg > 1 ? `Свечи ${tf.agg} мин собраны из минутных` : 'Минутные свечи';
        return { candles: rows, note: `${what}: ${found} торг. дн. (последние). Время московское.` };
    }

    let from;
    let span;
    if (tf.key === '1h') { from = shiftDateStr(today, { days: -30 }); span = '30 дней'; }
    else if (tf.key === '1d') { from = shiftDateStr(today, { months: -36 }); span = '3 года'; }
    else if (tf.key === '1w') { from = shiftDateStr(today, { months: -120 }); span = '10 лет'; }
    else { from = '1990-01-01'; span = 'вся история'; }

    const rows = await fetchCandlePages(cfg.candlesBase,
        `interval=${tf.interval}&from=${from}&till=${enc(today + ' 23:59:59')}`);
    return { candles: rows, note: `Свечи MOEX (${span}). Время московское.` };
}

/* Число сделок ISS отдаёт только в дневных итогах — подтягиваем для дневных, недельных и месячных свечей (последние 2 года). */
async function fetchTradesMap(cfg) {
    if (tradesCache[cfg.historyBase]) return tradesCache[cfg.historyBase];

    const from = shiftDateStr(moscowDateStr(new Date()), { months: -24 });
    const url = start =>
        `${cfg.historyBase}.json?iss.meta=off&iss.only=history,history.cursor` +
        `&history.columns=TRADEDATE,NUMTRADES&from=${from}&start=${start}`;
    const map = {};
    const eat = data => {
        const h = data.history;
        if (!h || !Array.isArray(h.data)) return 0;
        const iD = col(h.columns, 'TRADEDATE');
        const iN = col(h.columns, 'NUMTRADES');
        h.data.forEach(r => { const n = num(r[iN]); if (n !== null) map[String(r[iD]).slice(0, 10)] = n; });
        return h.data.length;
    };

    const first = await fetchJson(url(0), { retries: 1 });
    const n = eat(first);
    const cur = first['history.cursor'];
    let total = n;
    let pageSize = n;
    if (cur && cur.data && cur.data.length) {
        total = num(cur.data[0][col(cur.columns, 'TOTAL')]) || n;
        pageSize = num(cur.data[0][col(cur.columns, 'PAGESIZE')]) || n;
    }
    const starts = [];
    for (let s = pageSize; pageSize > 0 && s < total; s += pageSize) starts.push(s);
    for (let i = 0; i < starts.length; i += 6) {
        const pages = await Promise.all(starts.slice(i, i + 6).map(s => fetchJson(url(s), { retries: 1 }).catch(() => null)));
        pages.forEach(p => { if (p) eat(p); });
    }
    const res = { map, from };
    tradesCache[cfg.historyBase] = res;
    return res;
}

function chartDec(price, cfg) {
    if (cfg && Number.isInteger(cfg.decimals)) return cfg.decimals;
    const a = Math.abs(price);
    return a < 1 ? 4 : a < 10 ? 3 : 2;
}

function formatVolume(v) {
    if (v === null || v === undefined || isNaN(v)) return '—';
    if (v >= 1e9) return nf(2).format(v / 1e9) + ' млрд';
    if (v >= 1e6) return nf(2).format(v / 1e6) + ' млн';
    return nf(0).format(v);
}

function chartTimeLabel(t, key, prevT) {
    const day = t.slice(0, 10);
    if (key === '1m' || key === '5m' || key === '15m') {
        const hm = t.slice(11, 16);
        return !prevT || prevT.slice(0, 10) !== day ? `${t.slice(8, 10)}.${t.slice(5, 7)} ${hm}` : hm;
    }
    if (key === '1h') return `${t.slice(8, 10)}.${t.slice(5, 7)} ${t.slice(11, 16)}`;
    if (key === '1M') return `${t.slice(5, 7)}.${t.slice(0, 4)}`;
    return `${t.slice(8, 10)}.${t.slice(5, 7)}.${t.slice(2, 4)}`;
}

function chartTipTitle(t, key) {
    const d = `${t.slice(8, 10)}.${t.slice(5, 7)}.${t.slice(0, 4)}`;
    if (key === '1m' || key === '5m' || key === '15m' || key === '1h') return `${d} ${t.slice(11, 16)}`;
    if (key === '1w') return `Неделя с ${d}`;
    if (key === '1M') return `Месяц ${t.slice(5, 7)}.${t.slice(0, 4)}`;
    return d;
}

function createCandleChart(stage, cfg) {
    const canvas = document.createElement('canvas');
    canvas.className = 'cp-canvas';
    const tip = mk('div', 'cp-tip');
    tip.hidden = true;
    stage.append(canvas, tip);

    const M = { l: 6, r: 62, t: 10, b: 22 };
    const UP = '#2e7d32';
    const DOWN = '#c62828';
    const raf = typeof requestAnimationFrame === 'function' ? requestAnimationFrame : f => setTimeout(f, 0);

    let data = [];
    let tfKey = '1d';
    let mode = 'candles';
    let visible = 80;
    let end = 0;
    let hover = -1;
    let drag = null;
    let pinch = null;
    let pending = false;

    function dims() {
        const dpr = (typeof window !== 'undefined' && window.devicePixelRatio) || 1;
        const w = stage.clientWidth || 320;
        const h = stage.clientHeight || 280;
        const pw = Math.round(w * dpr);
        const ph = Math.round(h * dpr);
        if (canvas.width !== pw || canvas.height !== ph) {
            canvas.width = pw;
            canvas.height = ph;
        }
        return { w, h, dpr };
    }

    function clampView() {
        const n = data.length;
        visible = Math.max(8, Math.min(visible, Math.max(n + 6, 16)));
        const lo = visible - 4;
        const hi = n + 4;
        end = Math.min(Math.max(end, Math.min(lo, hi)), hi);
    }

    function schedule() {
        if (pending) return;
        pending = true;
        raf(() => { pending = false; draw(); });
    }

    function geometry() {
        const { w, h, dpr } = dims();
        const volH = Math.round((h - M.t - M.b) * 0.2);
        const priceH = h - M.t - M.b - volH - 6;
        const plotW = w - M.l - M.r;
        return { w, h, dpr, volH, priceH, plotW, bw: plotW / visible, start: end - visible };
    }

    function draw() {
        const g = geometry();
        const ctx = canvas.getContext('2d');
        ctx.setTransform(g.dpr, 0, 0, g.dpr, 0, 0);
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, g.w, g.h);

        const n = data.length;
        if (!n) {
            ctx.fillStyle = '#888';
            ctx.font = '13px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('Нет данных для графика', g.w / 2, g.h / 2);
            return;
        }

        const i0 = Math.max(0, Math.floor(g.start));
        const i1 = Math.min(n - 1, Math.ceil(end) - 1);
        let lo = Infinity;
        let hi = -Infinity;
        let vmax = 0;
        for (let i = i0; i <= i1; i++) {
            const d = data[i];
            const dl = mode === 'line' ? d.c : d.l;
            const dh = mode === 'line' ? d.c : d.h;
            if (dl < lo) lo = dl;
            if (dh > hi) hi = dh;
            if (d.v > vmax) vmax = d.v;
        }
        if (!isFinite(lo) || !isFinite(hi)) return;
        const pad = ((hi - lo) || Math.abs(hi) * 0.01 || 1) * 0.07;
        lo -= pad;
        hi += pad;

        const py = p => M.t + ((hi - p) / (hi - lo)) * g.priceH;
        const vy = v => M.t + g.priceH + 6 + g.volH - (vmax ? (v / vmax) * g.volH : 0);
        const px = i => M.l + (i + 0.5 - g.start) * g.bw;
        const dec = chartDec(data[Math.min(n - 1, i1)].c, cfg);

        // сетка и подписи цены
        ctx.font = '11px Arial';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.lineWidth = 1;
        for (let k = 0; k <= 4; k++) {
            const p = lo + ((hi - lo) * k) / 4;
            const y = Math.round(py(p)) + 0.5;
            ctx.strokeStyle = '#eee';
            ctx.beginPath(); ctx.moveTo(M.l, y); ctx.lineTo(g.w - M.r, y); ctx.stroke();
            ctx.fillStyle = '#666';
            ctx.fillText(nf(dec).format(p), g.w - M.r + 4, y);
        }

        // свечи / линия и объёмы
        const body = Math.max(1, Math.min(g.bw * 0.72, 22));
        if (mode === 'line') {
            ctx.beginPath();
            for (let i = i0; i <= i1; i++) {
                const x = px(i);
                const y = py(data[i].c);
                if (i === i0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = '#1565c0';
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.lineTo(px(i1), M.t + g.priceH);
            ctx.lineTo(px(i0), M.t + g.priceH);
            ctx.closePath();
            ctx.fillStyle = 'rgba(21,101,192,.10)';
            ctx.fill();
            ctx.lineWidth = 1;
        }
        for (let i = i0; i <= i1; i++) {
            const d = data[i];
            const x = px(i);
            const up = d.c >= d.o;
            if (mode !== 'line') {
                ctx.strokeStyle = ctx.fillStyle = up ? UP : DOWN;
                ctx.beginPath(); ctx.moveTo(Math.round(x) + 0.5, py(d.h)); ctx.lineTo(Math.round(x) + 0.5, py(d.l)); ctx.stroke();
                const y1 = py(Math.max(d.o, d.c));
                const y2 = py(Math.min(d.o, d.c));
                ctx.fillRect(x - body / 2, y1, body, Math.max(1, y2 - y1));
            }
            if (d.v) {
                ctx.fillStyle = mode === 'line' ? '#90a4ae' : up ? UP : DOWN;
                ctx.globalAlpha = 0.45;
                ctx.fillRect(x - body / 2, vy(d.v), body, M.t + g.priceH + 6 + g.volH - vy(d.v));
                ctx.globalAlpha = 1;
            }
        }

        // ось времени
        ctx.fillStyle = '#666';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const step = Math.max(1, Math.ceil(84 / g.bw));
        for (let i = i0 - (i0 % step); i <= i1; i += step) {
            if (i < 0) continue;
            const x = px(i);
            if (x < M.l + 20 || x > g.w - M.r - 20) continue;
            ctx.fillText(chartTimeLabel(data[i].t, tfKey, i > 0 ? data[i - 1].t : null), x, g.h - M.b + 5);
        }

        // перекрестие
        if (hover >= 0 && hover < n) {
            const d = data[hover];
            const x = Math.round(px(hover)) + 0.5;
            ctx.strokeStyle = 'rgba(0,0,0,.35)';
            ctx.setLineDash([4, 3]);
            ctx.beginPath(); ctx.moveTo(x, M.t); ctx.lineTo(x, g.h - M.b); ctx.stroke();
            const y = Math.round(py(d.c)) + 0.5;
            ctx.beginPath(); ctx.moveTo(M.l, y); ctx.lineTo(g.w - M.r, y); ctx.stroke();
            ctx.setLineDash([]);
            ctx.fillStyle = d.c >= d.o ? UP : DOWN;
            ctx.fillRect(g.w - M.r, y - 8, M.r - 2, 16);
            ctx.fillStyle = '#fff';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(nf(dec).format(d.c), g.w - M.r + 3, y);
        }
    }

    function showTip(i, xPix) {
        if (i < 0 || i >= data.length) { tip.hidden = true; return; }
        const d = data[i];
        const dec = chartDec(d.c, cfg);
        const ch = d.o ? ((d.c / d.o - 1) * 100) : null;
        const line = (a, b, cls) => {
            const r = mk('div', 'r');
            r.append(mk('span', null, a), mk('span', cls || null, b));
            return r;
        };
        const rows = [
            mk('b', null, chartTipTitle(d.t, tfKey)),
            line('Открытие', nf(dec).format(d.o)),
            line('Закрытие', nf(dec).format(d.c), d.c >= d.o ? 'up' : 'down'),
            line('Минимум', nf(dec).format(d.l)),
            line('Максимум', nf(dec).format(d.h)),
            line('Объём', d.v ? `${formatVolume(d.v)} шт.` : '—'),
            line('Сделок', d.n !== undefined && d.n !== null ? nf(0).format(d.n) : '—')
        ];
        if (ch !== null) rows.push(line('Изменение', (ch >= 0 ? '+' : '−') + nf(2).format(Math.abs(ch)) + ' %', ch >= 0 ? 'up' : 'down'));
        tip.replaceChildren(...rows);
        const sw = stage.clientWidth || 320;
        tip.style.left = (xPix > sw / 2 ? 8 : Math.max(8, sw - 180)) + 'px';
        tip.hidden = false;
    }

    function idxAtX(xPix) {
        const g = geometry();
        return Math.floor(g.start + (xPix - M.l) / g.bw);
    }

    function relX(clientX) {
        const r = canvas.getBoundingClientRect();
        return clientX - r.left;
    }

    function zoomAt(factor, xPix) {
        const g = geometry();
        const frac = Math.max(0, Math.min(1, (xPix - M.l) / g.plotW));
        const anchor = g.start + frac * visible;
        visible = visible * factor;
        const n = data.length;
        visible = Math.max(8, Math.min(visible, Math.max(n + 6, 16)));
        end = anchor - frac * visible + visible;
        clampView();
        schedule();
    }

    function panBy(dxPix) {
        const g = geometry();
        end -= dxPix / g.bw;
        clampView();
        schedule();
    }

    // мышь
    canvas.addEventListener('mousemove', e => {
        const x = relX(e.clientX);
        if (drag && drag.mouse) {
            panBy(x - drag.x);
            drag.x = x;
            drag.moved = true;
            return;
        }
        hover = idxAtX(x);
        showTip(hover, x);
        schedule();
    });
    canvas.addEventListener('mouseleave', () => { hover = -1; tip.hidden = true; drag = null; schedule(); });
    canvas.addEventListener('mousedown', e => { drag = { mouse: true, x: relX(e.clientX), moved: false }; });
    canvas.addEventListener('mouseup', () => { drag = null; });
    canvas.addEventListener('wheel', e => {
        if (e.preventDefault) e.preventDefault();
        zoomAt(e.deltaY < 0 ? 0.85 : 1 / 0.85, relX(e.clientX));
    }, { passive: false });

    // касания: один палец — сдвиг (горизонтально) или тап = подсказка; два пальца — масштаб
    const dist = ts => Math.hypot(ts[0].clientX - ts[1].clientX, ts[0].clientY - ts[1].clientY);
    canvas.addEventListener('touchstart', e => {
        if (e.touches.length === 2) {
            pinch = { d: dist(e.touches), v: visible };
            drag = null;
        } else if (e.touches.length === 1) {
            const t = e.touches[0];
            drag = { x: t.clientX, y: t.clientY, sx: t.clientX, sy: t.clientY, moved: false };
        }
    }, { passive: true });
    canvas.addEventListener('touchmove', e => {
        if (e.touches.length === 2 && pinch) {
            const g = geometry();
            const mid = relX((e.touches[0].clientX + e.touches[1].clientX) / 2);
            const target = Math.max(8, pinch.v * (pinch.d / Math.max(1, dist(e.touches))));
            zoomAt(target / visible, mid);
            if (e.preventDefault) e.preventDefault();
            return;
        }
        if (drag && e.touches.length === 1) {
            const t = e.touches[0];
            const dx = t.clientX - drag.x;
            const horizontal = Math.abs(t.clientX - drag.sx) > Math.abs(t.clientY - drag.sy);
            if (Math.abs(t.clientX - drag.sx) > 6 || Math.abs(t.clientY - drag.sy) > 6) drag.moved = true;
            if (horizontal) {
                panBy(dx);
                tip.hidden = true;
                hover = -1;
                if (e.preventDefault) e.preventDefault();
            }
            drag.x = t.clientX;
            drag.y = t.clientY;
        }
    }, { passive: false });
    canvas.addEventListener('touchend', () => {
        if (drag && !drag.moved) {
            const x = relX(drag.sx);
            hover = idxAtX(x);
            showTip(hover, x);
            schedule();
        }
        drag = null;
        pinch = null;
    });

    let ro = null;
    const onResize = () => schedule();
    if (typeof ResizeObserver !== 'undefined') {
        ro = new ResizeObserver(onResize);
        ro.observe(stage);
    } else if (typeof window !== 'undefined' && window.addEventListener) {
        window.addEventListener('resize', onResize);
    }

    return {
        setData(candles, key) {
            data = candles || [];
            tfKey = key;
            hover = -1;
            tip.hidden = true;
            visible = Math.min(Math.max(data.length, 10), CHART_DEFAULT_VISIBLE[key] || 80);
            end = data.length + 2;
            clampView();
            schedule();
        },
        redraw: schedule,
        setMode(m) { mode = m; schedule(); },
        getMode() { return mode; },
        zoom(factor) { zoomAt(factor, M.l + geometry().plotW / 2); },
        reset() {
            visible = Math.min(Math.max(data.length, 10), CHART_DEFAULT_VISIBLE[tfKey] || 80);
            end = data.length + 2;
            clampView();
            schedule();
        },
        hoverAt(i) { hover = i; showTip(i, 0); schedule(); }, // для тестов и программного вызова
        view() { return { visible, end, n: data.length }; },
        destroy() {
            if (ro) ro.disconnect();
            else if (typeof window !== 'undefined' && window.removeEventListener) window.removeEventListener('resize', onResize);
        }
    };
}

/* Панель: кнопки таймфреймов, масштаб, полный экран, график, сноска. cfg: { candlesBase, historyBase, decimals } */
function makeChartPanel(cfg) {
    const root = mk('div', 'cp');
    const head = mk('div', 'cp-head');
    const tools = mk('div', 'cp-tools');
    const stage = mk('div', 'cp-stage');
    const note = mk('div', 'note', '');

    const tfBtns = {};
    CHART_TF.forEach(tf => {
        const b = mk('button', 'cp-btn', tf.label);
        b.addEventListener('click', () => select(tf.key));
        tfBtns[tf.key] = b;
        head.append(b);
    });

    const bCandles = mk('button', 'cp-btn active', 'Свечи');
    const bLine = mk('button', 'cp-btn', 'Линия');
    const bMinus = mk('button', 'cp-btn', '−');
    const bPlus = mk('button', 'cp-btn', '+');
    const bReset = mk('button', 'cp-btn', '⟲');
    const bFull = mk('button', 'cp-btn', '⛶');
    bMinus.title = 'Уменьшить';
    bPlus.title = 'Увеличить';
    bReset.title = 'Сбросить масштаб';
    bFull.title = 'На весь экран';
    const bClose = mk('button', 'cp-close', '✕ Закрыть');
    tools.append(bCandles, bLine, bMinus, bPlus, bReset, bFull);
    root.append(bClose, head, tools, stage, note);

    const chart = createCandleChart(stage, cfg);
    const cache = {};
    let token = 0;
    let full = false;
    let destroyed = false;

    function setMode(m) {
        chart.setMode(m);
        bCandles.className = 'cp-btn' + (m === 'candles' ? ' active' : '');
        bLine.className = 'cp-btn' + (m === 'line' ? ' active' : '');
    }
    bCandles.addEventListener('click', () => setMode('candles'));
    bLine.addEventListener('click', () => setMode('line'));
    bMinus.addEventListener('click', () => chart.zoom(1.3));
    bPlus.addEventListener('click', () => chart.zoom(1 / 1.3));
    bReset.addEventListener('click', () => chart.reset());

    let homeParent = null;
    let homeNext = null;
    function setFull(on) {
        if (on === full) return;
        full = on;
        // Полный экран выносим в <body>: внутри прокручиваемого окна iPhone «прилипший» блок съезжает и кнопка закрытия пропадает.
        if (on) {
            homeParent = root.parentNode;
            homeNext = root.nextSibling;
            document.body.appendChild(root);
        } else if (homeParent) {
            homeParent.insertBefore(root, homeNext);
        }
        root.className = 'cp' + (on ? ' cp-full' : '');
        bFull.textContent = on ? '✕' : '⛶';
        bFull.title = on ? 'Свернуть' : 'На весь экран';
        try {
            if (on && root.requestFullscreen) root.requestFullscreen().catch(() => {});
            else if (!on && document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
        } catch (_) { /* на iPhone Fullscreen API нет — работает режим «поверх страницы» */ }
        chart.redraw();
    }
    bFull.addEventListener('click', () => setFull(!full));
    bClose.addEventListener('click', () => setFull(false));

    const onKey = e => {
        if (e.key === 'Escape' && full) {
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
            setFull(false);
        }
    };
    document.addEventListener('keydown', onKey, true);

    async function attachTrades(key, candles) {
        if (!cfg.historyBase || (key !== '1d' && key !== '1w' && key !== '1M')) return;
        try {
            const res = await fetchTradesMap(cfg);
            if (destroyed || !res) return;
            const dates = Object.keys(res.map).sort();
            candles.forEach((c, i) => {
                const d0 = c.t.slice(0, 10);
                if (d0 < res.from) return;
                if (key === '1d') {
                    if (res.map[d0] !== undefined) c.n = res.map[d0];
                    return;
                }
                const d1 = i + 1 < candles.length ? candles[i + 1].t.slice(0, 10) : '9999-12-31';
                let sum = 0;
                let any = false;
                dates.forEach(d => { if (d >= d0 && d < d1) { sum += res.map[d]; any = true; } });
                if (any) c.n = sum;
            });
            chart.redraw();
        } catch (e) {
            console.error(e);
        }
    }

    async function select(key) {
        Object.keys(tfBtns).forEach(k => { tfBtns[k].className = 'cp-btn' + (k === key ? ' active' : ''); });
        const my = ++token;
        note.textContent = 'Загрузка свечей...';
        try {
            let res = cache[key];
            if (!res || Date.now() - res.t > 60000) {
                res = await loadChartData(cfg, CHART_TF_MAP[key]);
                res.t = Date.now();
                cache[key] = res;
            }
            if (my !== token || destroyed) return;
            chart.setData(res.candles, key);
            note.textContent = res.candles.length
                ? `${res.note} Свечей: ${res.candles.length}. Колесо / щипок — масштаб, перетаскивание — сдвиг, наведение или тап — подробности.` +
                  (key === '1d' || key === '1w' || key === '1M' ? ' Число сделок — только за последние 2 года.' : ' Число сделок для этого таймфрейма MOEX не публикует.')
                : 'Свечей за этот период нет (возможно, торги не проводились).';
            attachTrades(key, res.candles);
        } catch (e) {
            console.error(e);
            if (my === token) note.textContent = `Не удалось загрузить свечи: ${e.message}`;
        }
    }

    select('1d');

    return {
        el: root,
        select,
        chart,
        destroy() {
            destroyed = true;
            if (full) setFull(false);
            if (root.parentNode === document.body) root.remove();
            document.removeEventListener('keydown', onKey, true);
            chart.destroy();
            try { if (full && document.fullscreenElement && document.exitFullscreen) document.exitFullscreen(); } catch (_) { /* ignore */ }
        }
    };
}


/* ====== ВЕБ-УТИЛИТЫ: чтение чужих сайтов через CORS-прокси, RSS, HTML-таблицы, Википедия ====== */

/* Браузер не даёт читать чужие сайты напрямую (CORS): пробуем напрямую → публичные прокси. */
const WEB_PROXIES = [
    { name: 'напрямую',   build: u => u,                                                              timeout: 6000 },
    { name: 'allorigins', build: u => `https://api.allorigins.win/raw?url=${encodeURIComponent(u)}`, timeout: 15000 },
    { name: 'corsproxy',  build: u => `https://corsproxy.io/?url=${encodeURIComponent(u)}`,          timeout: 15000 }
];

async function webBytes(url, timeout) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);
    try {
        const r = await fetch(url, { cache: 'no-store', signal: controller.signal });
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return new Uint8Array(await r.arrayBuffer());
    } finally {
        clearTimeout(timer);
    }
}

/* Кодировка берётся из XML-заголовка / meta (бывает windows-1251). */
function webDecode(bytes) {
    let label = 'utf-8';
    let head = '';
    for (let i = 0; i < Math.min(bytes.length, 600); i++) head += String.fromCharCode(bytes[i]);
    const m = head.match(/(?:encoding=|charset=)["']?([\w-]+)/i);
    if (m) label = m[1].toLowerCase();
    try {
        return new TextDecoder(label).decode(bytes);
    } catch (_) {
        return new TextDecoder('utf-8').decode(bytes);
    }
}

/* validate(text) → true, если ответ годится (иначе пробуем следующий прокси). */
async function fetchTextViaProxies(url, validate) {
    let lastErr = null;
    for (const p of WEB_PROXIES) {
        try {
            const text = webDecode(await webBytes(p.build(url), p.timeout));
            if (!validate || validate(text)) return { text, via: p.name };
            lastErr = new Error('ответ не содержит нужных данных');
        } catch (e) {
            lastErr = e;
        }
    }
    throw lastErr || new Error('нет ответа');
}

function decodeEntities(s) {
    return s
        .replace(/&nbsp;/g, ' ').replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&#39;/g, "'")
        .replace(/&lt;/g, '<').replace(/&gt;/g, '>')
        .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16)))
        .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
        .replace(/&amp;/g, '&');
}

function cleanHtml(s) {
    if (!s) return '';
    return decodeEntities(s.replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1').replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim();
}

function tagOf(block, name) {
    const m = block.match(new RegExp(`<${name}(?:\\s[^>]*)?>([\\s\\S]*?)</${name}>`, 'i'));
    return m ? m[1] : '';
}

function parseFeed(text) {
    const out = [];
    const blocks = text.match(/<(item|entry)[\s>][\s\S]*?<\/\1>/gi) || [];
    blocks.forEach(blk => {
        const title = cleanHtml(tagOf(blk, 'title'));
        let link = cleanHtml(tagOf(blk, 'link'));
        if (!link) {
            const m = blk.match(/<link[^>]*href=["']([^"']+)["']/i);
            link = m ? decodeEntities(m[1]) : '';
        }
        if (!link) link = cleanHtml(tagOf(blk, 'guid'));
        const date = cleanHtml(tagOf(blk, 'pubDate') || tagOf(blk, 'published') || tagOf(blk, 'updated') || tagOf(blk, 'dc:date'));
        const ts = Date.parse(date);
        const src = cleanHtml(tagOf(blk, 'source'));
        if (title && /^https?:\/\//i.test(link)) out.push({ title, link, ts: Number.isFinite(ts) ? ts : null, src });
    });
    return out;
}

const RSS2JSON = u => `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(u)}`;

async function fetchFeedAny(url) {
    let lastErr = null;
    try {
        const r = await fetchTextViaProxies(url, t => parseFeed(t).length > 0);
        return { list: parseFeed(r.text), via: r.via };
    } catch (e) {
        lastErr = e;
    }
    try {
        const r = await fetch(RSS2JSON(url), { cache: 'no-store' });
        const j = await r.json();
        if (j && j.status === 'ok' && Array.isArray(j.items) && j.items.length) {
            const list = j.items
                .map(it => ({ title: cleanHtml(it.title), link: String(it.link || ''), ts: Date.parse(String(it.pubDate || '').replace(' ', 'T') + 'Z'), src: '' }))
                .filter(it => it.title && /^https?:\/\//i.test(it.link))
                .map(it => ({ ...it, ts: Number.isFinite(it.ts) ? it.ts : null }));
            if (list.length) return { list, via: 'rss2json' };
        }
    } catch (e) {
        lastErr = e;
    }
    throw lastErr || new Error('нет ответа');
}

/* Все таблицы страницы: массив таблиц, каждая — массив строк, строка — массив текстов ячеек. */
function parseHtmlTables(html) {
    const tables = [];
    (html.match(/<table[\s\S]*?<\/table>/gi) || []).forEach(t => {
        const rows = [];
        (t.match(/<tr[\s\S]*?<\/tr>/gi) || []).forEach(tr => {
            const cells = (tr.match(/<t[hd][\s\S]*?<\/t[hd]>/gi) || []).map(cleanHtml);
            if (cells.some(x => x !== '')) rows.push(cells);
        });
        if (rows.length) tables.push(rows);
    });
    return tables;
}

/* Числа и даты из русских таблиц: «37,64₽», «13,6%», «1 059,5», «17.07.2026». */
function ruNumber(s) {
    if (s === null || s === undefined) return null;
    const m = String(s).replace(/\u00a0/g, ' ').match(/-?\d[\d\s]*(?:[.,]\d+)?/);
    if (!m) return null;
    const n = Number(m[0].replace(/\s/g, '').replace(',', '.'));
    return Number.isFinite(n) ? n : null;
}

function ruDate(s) {
    const m = String(s || '').match(/(\d{1,2})\.(\d{1,2})\.(\d{4})/);
    return m ? `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}` : null;
}

/* Описание компании из Википедии (CORS открыт): подбор статьи по названию, может быть неточным. */
async function wikiSummary(queries) {
    for (const q of queries) {
        if (!q) continue;
        try {
            const s = await fetchJson(
                `https://ru.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(q)}&srlimit=3&format=json&origin=*`,
                { retries: 1, timeout: 12000 });
            const hits = s && s.query && s.query.search ? s.query.search : [];
            for (const h of hits) {
                const sum = await fetchJson(
                    `https://ru.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(h.title.replace(/ /g, '_'))}`,
                    { retries: 1, timeout: 12000 });
                if (sum && sum.extract && sum.type !== 'disambiguation') {
                    return {
                        title: sum.title, extract: sum.extract, description: sum.description || '',
                        url: sum.content_urls && sum.content_urls.desktop ? sum.content_urls.desktop.page : null, query: q
                    };
                }
            }
        } catch (e) {
            console.error('wiki', q, e);
        }
    }
    return null;
}

/* Новости по одной бумаге: Google News RSS по названию (через прокси). */
async function loadSecurityNews(query) {
    const url = `https://news.google.com/rss/search?q=${encodeURIComponent(query)}&hl=ru&gl=RU&ceid=RU:ru`;
    const r = await fetchFeedAny(url);
    const now = Date.now();
    const seen = new Set();
    const out = [];
    r.list.forEach(it => {
        let title = it.title;
        let src = it.src;
        const m = title.match(/^(.*)\s[-–—]\s([^-–—]{2,40})$/);
        if (m) {
            title = m[1];
            if (!src) src = m[2];
        }
        const key = title.toLowerCase().replace(/[^a-zа-яё0-9]+/g, ' ').trim().slice(0, 70);
        if (seen.has(key)) return;
        seen.add(key);
        out.push({ title, link: it.link, ts: it.ts || now, src: src || 'Google News' });
    });
    out.sort((a, b) => b.ts - a.ts);
    return out;
}

function timeAgo(ts) {
    const d = new Date(ts);
    const diff = Date.now() - ts;
    if (diff < 60 * 1000) return 'только что';
    if (diff < 60 * 60 * 1000) return `${Math.round(diff / 60000)} мин назад`;
    const pad = n => String(n).padStart(2, '0');
    const hm = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
    return new Date().toDateString() === d.toDateString() ? `сегодня ${hm}` : `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${String(d.getFullYear()).slice(2)} ${hm}`;
}


/* ====== ИЗБРАННОЕ: надёжное хранение ======
 * Список лежит в браузере под фиксированным ключом FAV_KEY (localStorage) и дублируется в IndexedDB.
 * Обновление кода страниц его не трогает: данные принадлежат адресу сайта, а не файлам.
 * Ключ и формат НЕ МЕНЯТЬ. Если формат когда-нибудь изменится, нужна миграция в normalize() — старые записи читаются всегда.
 * Слияние идёт по времени изменения каждой записи (новее побеждает), удаления хранятся как «надгробия» 180 дней,
 * поэтому копия из IndexedDB не воскрешает удалённое. Плюс экспорт/импорт резервной копии вручную.
 */
const FAV_KEY = 'mx.fav.v1';
const FAV_IDB_NAME = 'mx-heatmap';
const FAV_IDB_STORE = 'kv';
const FAV_IDB_KEY = 'fav.v1';
const FAV_TOMBSTONE_MS = 180 * 86400000;

const FavStore = (() => {
    let items = {};
    const status = { ls: false, idb: false, persisted: null, saved: null };
    const listeners = [];
    let ready = null;

    const keyOf = (k, id) => `${k}:${id}`;

    function normalize(raw) {
        const out = {};
        if (!raw) return out;
        if (Array.isArray(raw)) { // v0: просто массив тикеров
            raw.forEach(id => {
                if (typeof id === 'string' && id) out[keyOf('s', id)] = { k: 's', id, board: null, name: id, a: 1, u: 1, del: false };
            });
            return out;
        }
        const src = raw.items || raw;
        Object.keys(src).forEach(key => {
            const it = src[key];
            if (it && it.id && (it.k === 's' || it.k === 'b')) {
                out[keyOf(it.k, it.id)] = {
                    k: it.k, id: String(it.id), board: it.board || null, name: it.name || String(it.id),
                    a: Number(it.a) || 0, u: Number(it.u) || Number(it.a) || 0, del: !!it.del
                };
            }
        });
        return out;
    }

    function merge(a, b) {
        const out = { ...a };
        Object.keys(b).forEach(key => {
            if (!out[key] || (b[key].u || 0) > (out[key].u || 0)) out[key] = b[key];
        });
        return out;
    }

    function readLS() {
        try {
            const raw = localStorage.getItem(FAV_KEY);
            return raw ? normalize(JSON.parse(raw)) : {};
        } catch (_) {
            return {};
        }
    }

    function idbOpen() {
        return new Promise((resolve, reject) => {
            if (typeof indexedDB === 'undefined') { reject(new Error('IndexedDB недоступна')); return; }
            const r = indexedDB.open(FAV_IDB_NAME, 1);
            r.onupgradeneeded = () => r.result.createObjectStore(FAV_IDB_STORE);
            r.onsuccess = () => resolve(r.result);
            r.onerror = () => reject(r.error);
        });
    }

    async function idbGet() {
        const db = await idbOpen();
        return new Promise((resolve, reject) => {
            const req = db.transaction(FAV_IDB_STORE, 'readonly').objectStore(FAV_IDB_STORE).get(FAV_IDB_KEY);
            req.onsuccess = () => resolve(req.result || null);
            req.onerror = () => reject(req.error);
        });
    }

    async function idbPut(value) {
        const db = await idbOpen();
        return new Promise((resolve, reject) => {
            const tx = db.transaction(FAV_IDB_STORE, 'readwrite');
            tx.objectStore(FAV_IDB_STORE).put(value, FAV_IDB_KEY);
            tx.oncomplete = () => resolve(true);
            tx.onerror = () => reject(tx.error);
        });
    }

    function purge() {
        const limit = Date.now() - FAV_TOMBSTONE_MS;
        Object.keys(items).forEach(key => { if (items[key].del && items[key].u < limit) delete items[key]; });
    }

    async function persist() {
        purge();
        const payload = { v: 1, saved: Date.now(), items };
        status.saved = payload.saved;
        try {
            localStorage.setItem(FAV_KEY, JSON.stringify(payload));
            status.ls = true;
        } catch (_) {
            status.ls = false;
        }
        try {
            await idbPut(payload);
            status.idb = true;
        } catch (_) {
            status.idb = false;
        }
    }

    function emit() {
        listeners.forEach(fn => { try { fn(); } catch (e) { console.error(e); } });
    }

    items = readLS(); // сразу, синхронно: звёздочки рисуются без ожидания

    return {
        init() {
            if (ready) return ready;
            ready = (async () => {
                try {
                    items = merge(items, normalize(await idbGet()));
                    status.idb = true;
                } catch (_) {
                    status.idb = false;
                }
                await persist();
                try {
                    if (typeof navigator !== 'undefined' && navigator.storage && navigator.storage.persist) {
                        status.persisted = await navigator.storage.persist();
                    }
                } catch (_) { /* ignore */ }
                if (typeof window !== 'undefined' && window.addEventListener) {
                    window.addEventListener('storage', e => {
                        if (e.key !== FAV_KEY || !e.newValue) return;
                        try {
                            items = merge(items, normalize(JSON.parse(e.newValue)));
                            emit();
                        } catch (_) { /* ignore */ }
                    });
                }
                emit();
            })();
            return ready;
        },
        has(k, id) {
            const it = items[keyOf(k, id)];
            return !!it && !it.del;
        },
        toggle(k, id, meta) {
            const key = keyOf(k, id);
            const now = Date.now();
            const cur = items[key];
            if (cur && !cur.del) {
                items[key] = { ...cur, del: true, u: now };
            } else {
                items[key] = {
                    k, id: String(id), board: (meta && meta.board) || (cur && cur.board) || null,
                    name: (meta && meta.name) || (cur && cur.name) || String(id), a: now, u: now, del: false
                };
            }
            persist().then(emit);
            emit();
            return !items[key].del;
        },
        list() {
            return Object.keys(items).map(k => items[k]).filter(it => !it.del).sort((a, b) => a.a - b.a);
        },
        onChange(fn) { listeners.push(fn); },
        exportText() {
            return JSON.stringify({ v: 1, exported: new Date().toISOString(), items: this.list() }, null, 1);
        },
        async importText(text, replace) {
            let raw;
            try { raw = JSON.parse(text); } catch (_) { throw new Error('это не похоже на резервную копию (не JSON)'); }
            let list = raw && raw.items ? raw.items : raw;
            if (!Array.isArray(list) && list && typeof list === 'object') list = Object.keys(list).map(k => list[k]);
            if (!Array.isArray(list)) throw new Error('в копии нет списка бумаг');
            const now = Date.now();
            const incoming = normalize({ items: Object.fromEntries(list.filter(x => x && x.id && (x.k === 's' || x.k === 'b')).map(x => [keyOf(x.k, x.id), { ...x, u: now + 1, del: false, a: x.a || now }])) });
            if (replace) {
                Object.keys(items).forEach(key => { if (!items[key].del) items[key] = { ...items[key], del: true, u: now }; });
            }
            items = merge(items, incoming);
            await persist();
            emit();
            return Object.keys(incoming).length;
        },
        describe() {
            return `Хранилище: localStorage ${status.ls ? '✓' : '✗'} · IndexedDB ${status.idb ? '✓' : '✗'}` +
                ` · постоянное хранение: ${status.persisted === null ? 'не запрошено' : status.persisted ? 'да' : 'нет (браузер может очистить при нехватке места)'}` +
                (status.saved ? ` · сохранено ${new Date(status.saved).toLocaleString('ru-RU')}` : '');
        }
    };
})();


/* ====== СТАКАН и НОВОСТИ БУМАГИ (общий код акций и облигаций) ====== */

async function fetchOrderBook(url) {
    const data = await fetchJson(url, { retries: 1, timeout: 12000 });
    const blk = data.orderbook;
    if (!blk || !Array.isArray(blk.data)) return { rows: [], updated: null };
    const iS = col(blk.columns, 'BUYSELL');
    const iP = col(blk.columns, 'PRICE');
    const iQ = col(blk.columns, 'QUANTITY');
    const iT = col(blk.columns, 'UPDATETIME');
    const rows = blk.data
        .map(r => ({ side: String(r[iS]).toUpperCase(), price: num(r[iP]), qty: num(r[iQ]), t: iT >= 0 ? r[iT] : null }))
        .filter(r => r.price !== null && r.qty !== null && (r.side === 'B' || r.side === 'S'));
    return { rows, updated: rows.length && rows[0].t ? rows[0].t : null };
}

/* cfg: { url, dec, bid, offer, bcsUrl } — продавцы красным, покупатели зелёным, максимальная глубина, которую отдаёт MOEX */
function renderOrderBook(box, cfg) {
    const fmt = v => nf(cfg.dec).format(v);
    box.replaceChildren(mk('div', 'note', 'Загрузка стакана...'));

    const refresh = mk('button', 'btn', '↻ Обновить стакан');
    refresh.addEventListener('click', () => renderOrderBook(box, cfg));

    fetchOrderBook(cfg.url).then(res => {
        const parts = [mk('h4', null, 'Стакан заявок')];
        const sells = res.rows.filter(r => r.side === 'S').sort((a, b) => b.price - a.price);
        const buys = res.rows.filter(r => r.side === 'B').sort((a, b) => b.price - a.price);

        if (!sells.length && !buys.length) {
            parts.push(mk('div', 'note',
                'MOEX не отдаёт стакан в бесплатном (задержанном) доступе, поэтому полноценной глубины здесь нет. ' +
                'Лучшие цены из котировок ниже, а живой стакан смотрите в приложении брокера.'));
            if (cfg.bid !== null && cfg.bid !== undefined) parts.push(rowEl('Лучшая цена покупки (бид)', fmt(cfg.bid), 'pos'));
            if (cfg.offer !== null && cfg.offer !== undefined) parts.push(rowEl('Лучшая цена продажи (оффер)', fmt(cfg.offer), 'neg'));
            if (cfg.bcsUrl) {
                const a = mk('a', 'btn primary', 'Открыть стакан в БКС');
                a.href = cfg.bcsUrl;
                a.target = '_blank';
                a.rel = 'noopener';
                parts.push(a);
            }
            parts.push(refresh);
            box.replaceChildren(...parts);
            return;
        }

        const maxQty = Math.max(...res.rows.map(r => r.qty), 1);
        const head = mk('div', 'ob-head');
        head.append(mk('span', null, 'Цена'), mk('span', null, 'Объём (шт.)'));
        parts.push(head);

        const rowEl2 = (r, cls) => {
            const row = mk('div', 'ob-row ' + cls);
            const bar = mk('div', 'ob-bar');
            bar.style.width = `${Math.max(2, (r.qty / maxQty) * 100)}%`;
            row.append(bar, mk('span', null, fmt(r.price)), mk('span', null, nf(0).format(r.qty)));
            return row;
        };
        sells.forEach(r => parts.push(rowEl2(r, 'ob-sell')));
        if (sells.length && buys.length) {
            const bestAsk = sells[sells.length - 1].price;
            const bestBid = buys[0].price;
            const sp = bestAsk - bestBid;
            parts.push(mk('div', 'ob-spread', `Спред: ${fmt(sp)} (${nf(2).format((sp / bestAsk) * 100)} %)`));
        }
        buys.forEach(r => parts.push(rowEl2(r, 'ob-buy')));

        const sumS = sells.reduce((s, r) => s + r.qty, 0);
        const sumB = buys.reduce((s, r) => s + r.qty, 0);
        parts.push(rowEl('Продавцов всего (шт.)', nf(0).format(sumS), 'neg'));
        parts.push(rowEl('Покупателей всего (шт.)', nf(0).format(sumB), 'pos'));
        parts.push(mk('div', 'note', `Уровней: ${sells.length} на продажу, ${buys.length} на покупку${res.updated ? `; обновлено ${res.updated}` : ''}. Глубина — максимум, который отдаёт MOEX.`));
        parts.push(refresh);
        box.replaceChildren(...parts);
    }).catch(e => {
        console.error(e);
        const parts = [mk('h4', null, 'Стакан заявок'), mk('div', 'note', `Не удалось получить стакан: ${e.message}`)];
        if (cfg.bcsUrl) {
            const a = mk('a', 'btn primary', 'Открыть стакан в БКС');
            a.href = cfg.bcsUrl;
            a.target = '_blank';
            a.rel = 'noopener';
            parts.push(a);
        }
        parts.push(refresh);
        box.replaceChildren(...parts);
    });
}

/* Вкладка «Новости»: только про эту бумагу. matcher(title) — отбор по названию/тикеру, если подходящих достаточно. */
function renderNewsTab(box, query, matcher) {
    box.replaceChildren(mk('h4', null, 'Новости по бумаге'), mk('div', 'note', 'Загрузка новостей...'));
    loadSecurityNews(query).then(all => {
        let list = all;
        if (matcher) {
            const f = all.filter(it => matcher(it.title));
            if (f.length >= 3) list = f;
        }
        list = list.slice(0, 25);
        const parts = [mk('h4', null, 'Новости по бумаге')];
        if (!list.length) {
            parts.push(mk('div', 'note', 'Свежих новостей не найдено.'));
        } else {
            list.forEach(it => {
                const a = mk('a', 'news-line');
                a.href = it.link;
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
                a.append(mk('div', 't', it.title));
                const m = mk('div', 'm');
                m.append(mk('b', null, it.src), ` · ${timeAgo(it.ts)}`);
                a.append(m);
                parts.push(a);
            });
        }
        parts.push(mk('div', 'note', `Поиск новостей: «${query}» (Google News через прокси). Заголовки и ссылки принадлежат изданиям.`));
        const again = mk('button', 'btn', '↻ Обновить новости');
        again.addEventListener('click', () => renderNewsTab(box, query, matcher));
        parts.push(again);
        box.replaceChildren(...parts);
    }).catch(e => {
        console.error(e);
        const again = mk('button', 'btn', '↻ Повторить');
        again.addEventListener('click', () => renderNewsTab(box, query, matcher));
        box.replaceChildren(mk('h4', null, 'Новости по бумаге'),
            mk('div', 'note', `Не удалось загрузить новости: ${e.message}. Прокси могли быть недоступны (проверьте сеть и VPN).`), again);
    });
}

/* Название для поиска: без «ПАО», «ао», «ап», серий и т.п. */
function cleanCompanyName(name) {
    return String(name || '')
        .replace(/\b(ПАО|АО|ОАО|ЗАО|ООО|МКПАО|ао|ап|п|ап\.|ао\.|акции|обыкновенные|привилегированные|[0-9]+[-\s]?[ао]{2}|-ао|-ап|-п)\b/gi, ' ')
        .replace(/[«»"()]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}


/* ---------- карточка бумаги ---------- */

function modalItem() {
    return lastSnapshot && modalTicker ? lastSnapshot.get(modalTicker) : null;
}

function rowEl(label, value, cls) {
    const r = mk('div', 'row');
    r.append(mk('span', null, label), mk('span', cls || null, value));
    return r;
}

const MODAL_TABS = ['summary', 'div', 'info', 'book', 'news'];

function openStock(ticker) {
    const stock = stockByTicker[ticker];
    if (!stock) return;

    modalTicker = ticker;
    document.getElementById('modal').hidden = false;
    document.body.style.overflow = 'hidden';

    const item = modalItem();
    document.getElementById('modalTitle').textContent = `${stock.name} (${ticker})`;
    document.getElementById('modalSub').textContent = (item && item.secname) || '';

    setModalTab('summary');
    renderStar();
    renderModalLive();
    renderModalHist();
    renderModalDivTab();
    renderModalForecast();
    renderModalLinks();

    mountChart(ticker);
    loadHistoryStats(ticker).then(() => { if (modalTicker === ticker) renderModalHist(); });
    loadDividends(ticker).then(() => {
        if (modalTicker === ticker) {
            renderModalDivTab();
            renderModalLive();
        }
    });
}

function setModalTab(tab) {
    modalTab = tab;
    MODAL_TABS.forEach(t => {
        const cap = t[0].toUpperCase() + t.slice(1);
        document.getElementById('pane' + cap).hidden = t !== tab;
        document.getElementById('tab' + cap).className = 'tab' + (t === tab ? ' active' : '');
    });
    if (!modalTicker) return;
    if (tab === 'info') renderModalInfo();
    if (tab === 'book') renderModalBook();
    if (tab === 'news') renderModalNews();
}

function mountChart(ticker) {
    if (chartPanel) chartPanel.destroy();
    const stock = stockByTicker[ticker];
    const enc = encodeURIComponent(ticker);
    chartPanel = makeChartPanel({
        candlesBase: `${BOARD_PATH}/securities/${enc}`,
        historyBase: `${HISTORY_PATH}/securities/${enc}`,
        decimals: stock ? stock.decimals : null
    });
    document.getElementById('modalChart').replaceChildren(mk('h4', null, 'График (японские свечи)'), chartPanel.el);
}

function closeModal() {
    if (chartPanel) {
        chartPanel.destroy();
        chartPanel = null;
    }
    document.getElementById('modalChart').replaceChildren();
    modalTicker = null;
    newsFor = null;
    document.getElementById('modal').hidden = true;
    document.body.style.overflow = '';
}

function renderModalLive() {
    const box = document.getElementById('modalLive');
    const item = modalItem();
    const stock = modalTicker && stockByTicker[modalTicker];
    if (!item || !stock) {
        box.replaceChildren(mk('div', 'note', 'Нет данных.'));
        return;
    }

    const dec = stock.decimals;
    const day = computeFor(item, 'day');
    const price = day.price;
    const rows = [mk('h4', null, 'Сегодня')];

    rows.push(rowEl('Цена сейчас', `${formatPrice(price, dec)} ₽`));
    rows.push(rowEl('Изменение за день, %', formatChange(day.change), signCls(day.change)));
    rows.push(rowEl('Изменение за день, ₽', formatRubDelta(day.delta, dec, price), signCls(day.delta)));
    rows.push(rowEl('Цена открытия', item.open !== null ? `${formatPrice(item.open, dec)} ₽` : '—'));
    rows.push(rowEl('Закрытие предыдущего дня', item.prevPrice !== null ? `${formatPrice(item.prevPrice, dec)} ₽` : '—'));
    if (item.prevLegal !== null) {
        rows.push(rowEl('Официальная цена закрытия пред. дня', `${formatPrice(item.prevLegal, dec)} ₽`));
    }
    rows.push(rowEl('Минимум за день', item.low !== null ? `${formatPrice(item.low, dec)} ₽` : '—'));
    rows.push(rowEl('Максимум за день', item.high !== null ? `${formatPrice(item.high, dec)} ₽` : '—'));

    if (item.low !== null && item.high !== null && item.high > item.low && price !== null) {
        const pos = ((price - item.low) / (item.high - item.low)) * 100;
        rows.push(rowEl('Положение в диапазоне дня', `${nf(0).format(Math.max(0, Math.min(100, pos)))} % (0 — минимум, 100 — максимум)`));
    }

    rows.push(rowEl('Объём торгов, шт.', formatInt(item.volToday)));
    rows.push(rowEl('Объём торгов, ₽', formatMoney(item.valToday)));
    rows.push(rowEl('Сделок', formatInt(item.numTrades)));
    if (item.waPrice !== null) rows.push(rowEl('Средневзвешенная цена', `${formatPrice(item.waPrice, dec)} ₽`));
    if (item.bid !== null || item.offer !== null) {
        rows.push(rowEl('Покупка / продажа (стакан)', `${formatPrice(item.bid, dec)} / ${formatPrice(item.offer, dec)}`));
    }
    if (item.cap !== null) rows.push(rowEl('Капитализация', formatMoney(item.cap)));
    if (item.lotSize !== null) rows.push(rowEl('Размер лота', `${formatInt(item.lotSize)} шт.`));

    const ds = divSummary(modalTicker);
    if (ds && ds.yieldTtm !== null) {
        rows.push(rowEl('Дивидендная доходность (12 мес.)', ds.ttm > 0 ? formatPct1(ds.yieldTtm) : 'выплат не было'));
    }

    ['week', 'month'].forEach(p => {
        if (!basisFresh(p)) return;
        const r = computeFor(item, p);
        const baseInfo = r.base !== null
            ? ` (от ${formatPrice(r.base, dec)} ₽, ${p === 'month' ? 'средневзв.' : 'закрытие'} ${humanDate(bases[p].date)})`
            : '';
        rows.push(rowEl(`Изменение ${PERIOD_LABEL[p]}${baseInfo}`, formatChange(r.change), signCls(r.change)));
    });

    const noTrades = item.numTrades === 0 || (item.open === null && item.high === null);
    rows.push(mk('div', 'note',
        (noTrades ? 'Сегодня сделок ещё не было — открытие, минимум и максимум появятся после первых сделок. ' : '') +
        'Данные MOEX идут с задержкой около 15 минут. «Закрытие» сегодняшнего дня появится после окончания торгов, до этого ориентир — закрытие предыдущего дня.'));

    box.replaceChildren(...rows);
}

/* ---------- история цен: экстремумы ---------- */

const splitsCache = {};

/* Сплиты и консолидации: /statistics/engines/stock/splits/<тикер>. До сплита цены в истории MOEX — в старом масштабе. */
async function loadSplits(ticker) {
    if (splitsCache[ticker]) return splitsCache[ticker];
    const key = `moexHeatmap.splits.${ticker}`;
    const cached = readJson(key);
    if (cached && Date.now() - cached.t < 24 * 3600 * 1000) {
        splitsCache[ticker] = { list: cached.list, ok: true };
        return splitsCache[ticker];
    }

    const list = [];
    try {
        const data = await fetchJson(`${MOEX_ISS}/statistics/engines/stock/splits/${encodeURIComponent(ticker)}.json?iss.meta=off`,
            { retries: 1, timeout: 15000 });
        Object.keys(data).forEach(k => {
            const b = data[k];
            if (!b || !Array.isArray(b.columns) || !Array.isArray(b.data)) return;
            const iS = col(b.columns, 'secid');
            const iD = col(b.columns, 'tradedate');
            const iB = col(b.columns, 'before');
            const iA = col(b.columns, 'after');
            if (iD < 0 || iB < 0 || iA < 0) return;
            b.data.forEach(r => {
                if (iS >= 0 && String(r[iS]).toUpperCase() !== ticker.toUpperCase()) return;
                const before = num(r[iB]);
                const after = num(r[iA]);
                if (before && after && r[iD]) list.push({ date: String(r[iD]).slice(0, 10), before, after });
            });
        });
        writeJson(key, { t: Date.now(), list });
        splitsCache[ticker] = { list, ok: true };
    } catch (e) {
        console.error('splits', e);
        return { list: [], ok: false };
    }
    return splitsCache[ticker];
}

/* Коэффициент сплита проверяется по данным: цена до × коэффициент должна стыковаться с ценой после. */
function buildSplitFactors(rows, splits) {
    const applied = [];
    const skipped = [];
    (splits || []).slice().sort((a, b) => a.date.localeCompare(b.date)).forEach(s => {
        const f0 = s.before / s.after;
        if (!isFinite(f0) || f0 <= 0 || Math.abs(f0 - 1) < 1e-9) return;
        const iA = rows.findIndex(r => r.d >= s.date);
        if (iA <= 0) return; // до сплита данных нет — корректировать нечего
        const cb = rows[iA - 1].cl;
        const ca = rows[iA].cl;
        if (!(cb > 0) || !(ca > 0)) {
            applied.push({ date: s.date, f: f0, flipped: false, unverified: true });
            return;
        }
        const err = f => Math.abs(Math.log((cb * f) / ca));
        const f = err(f0) <= err(1 / f0) ? f0 : 1 / f0;
        if (err(f) > Math.log(2.5)) {
            skipped.push({ date: s.date, f: f0 });
            return;
        }
        applied.push({ date: s.date, f, flipped: f !== f0 });
    });
    return { applied, skipped };
}

function splitFactorAt(applied, dateStr) {
    let m = 1;
    applied.forEach(s => { if (dateStr < s.date) m *= s.f; });
    return m;
}

function extremesOf(rows, fromDate) {
    const res = { min: null, minD: null, max: null, maxD: null };
    rows.forEach(r => {
        if (fromDate && r.d < fromDate) return;
        if (r.lo > 0 && (res.min === null || r.lo < res.min)) { res.min = r.lo; res.minD = r.d; }
        if (r.hi > 0 && (res.max === null || r.hi > res.max)) { res.max = r.hi; res.maxD = r.d; }
    });
    return res;
}

/*
 * Исторические минимум и максимум.
 *  1. Дневная история с from=1990-01-01 (все страницы; упавшие страницы перезапрашиваются).
 *  2. Поправка на сплиты/консолидации (с проверкой по ценам).
 *  3. Перекрёстная проверка по месячным свечам: если месячный максимум выше дневного — дневная история неполная, берём месячный.
 */
function loadStatsFor(ticker, cfg) {
    if (histStats[ticker]) return Promise.resolve(histStats[ticker]);

    const cached = readJson(`moexHeatmap.hist2.${ticker}`);
    if (cached && Date.now() - cached.t < HIST_TTL) {
        histStats[ticker] = cached;
        return Promise.resolve(cached);
    }
    if (histPromises[ticker]) return histPromises[ticker];

    histPromises[ticker] = (async () => {
        try {
            const url = start =>
                `${cfg.historyBase}.json?iss.meta=off&iss.only=history,history.cursor` +
                `&history.columns=TRADEDATE,LOW,HIGH,CLOSE&from=1990-01-01&start=${start}`;

            const rows = [];
            const eat = data => {
                const h = data.history;
                if (!h || !Array.isArray(h.data)) return 0;
                const iD = col(h.columns, 'TRADEDATE');
                const iL = col(h.columns, 'LOW');
                const iH = col(h.columns, 'HIGH');
                const iC = col(h.columns, 'CLOSE');
                h.data.forEach(r => {
                    if (!r[iD]) return;
                    rows.push({ d: String(r[iD]).slice(0, 10), lo: num(r[iL]), hi: num(r[iH]), cl: num(r[iC]) });
                });
                return h.data.length;
            };

            const first = await fetchJson(url(0));
            const n = eat(first);
            const cur = first['history.cursor'];
            let total = n;
            let pageSize = n;
            if (cur && cur.data && cur.data.length) {
                total = num(cur.data[0][col(cur.columns, 'TOTAL')]) || n;
                pageSize = num(cur.data[0][col(cur.columns, 'PAGESIZE')]) || n;
            }
            histProgress[ticker] = { done: n, total };

            const starts = [];
            for (let s = pageSize; pageSize > 0 && s < total; s += pageSize) starts.push(s);
            const failed = [];
            for (let i = 0; i < starts.length; i += HIST_BATCH) {
                const results = await Promise.all(starts.slice(i, i + HIST_BATCH).map(
                    s => fetchJson(url(s)).then(p => ({ s, p })).catch(() => ({ s, p: null }))));
                results.forEach(r => {
                    if (r.p) histProgress[ticker].done += eat(r.p);
                    else failed.push(r.s);
                });
                if (cfg.onProgress) cfg.onProgress();
            }
            const stillFailed = [];
            for (const s of failed) {
                let ok = false;
                for (let a = 0; a < 2 && !ok; a++) {
                    try {
                        histProgress[ticker].done += eat(await fetchJson(url(s)));
                        ok = true;
                    } catch (_) {
                        await sleep(800);
                    }
                }
                if (!ok) stillFailed.push(s);
            }

            rows.sort((a, b) => a.d.localeCompare(b.d));
            const missing = Math.max(0, total - rows.length);
            const notes = [];

            // сплиты
            const sp = cfg.splits ? await loadSplits(cfg.splitsTicker || ticker) : { list: [], ok: true };
            const { applied, skipped } = buildSplitFactors(rows, sp.list);
            const adj = rows.map(r => {
                const f = splitFactorAt(applied, r.d);
                return { d: r.d, lo: r.lo !== null ? r.lo * f : null, hi: r.hi !== null ? r.hi * f : null, cl: r.cl !== null ? r.cl * f : null };
            });
            applied.forEach(s => notes.push(
                `Цены до ${humanDate(s.date)} пересчитаны на сплит/консолидацию (×${nf(s.f >= 1 ? 0 : 4).format(s.f)})${s.unverified ? ' — без проверки' : ''}.`));
            skipped.forEach(s => notes.push(
                `Сплит ${humanDate(s.date)} не применён: цены до и после не стыкуются, экстремумы до этой даты в старом масштабе.`));
            if (cfg.splits && !sp.ok) notes.push('Список сплитов MOEX не загрузился — поправка на сплиты не проверялась.');

            // скачки цены, не объяснённые сплитом
            let jumps = 0;
            for (let i = 1; i < adj.length && jumps < 2; i++) {
                const a = adj[i - 1].cl;
                const b = adj[i].cl;
                if (!(a > 0) || !(b > 0)) continue;
                const r = b / a;
                if (r >= 3 || r <= 1 / 3) {
                    const near = applied.concat(skipped).some(s => Math.abs(Date.parse(s.date) - Date.parse(adj[i].d)) < 8 * 86400000);
                    if (!near) {
                        notes.push(`Скачок цены в ${nf(1).format(r >= 1 ? r : 1 / r)} раз ${r >= 1 ? 'вверх' : 'вниз'} ${humanDate(adj[i].d)} — возможно, неучтённый сплит; экстремумы могут быть искажены.`);
                        jumps++;
                    }
                }
            }

            const today = moscowDateStr(new Date());
            const all = extremesOf(adj, null);
            const y5 = extremesOf(adj, shiftDateStr(today, { months: -60 }));
            const w52 = extremesOf(adj, shiftDateStr(today, { days: -365 }));

            // перекрёстная проверка по месячным свечам
            let monthlyOk = false;
            try {
                const months = await fetchCandlePages(cfg.candlesBase,
                    `interval=31&from=1990-01-01&till=${encodeURIComponent(today + ' 23:59:59')}`);
                let mMax = null;
                let mMaxB = null;
                let mMin = null;
                let mMinB = null;
                months.forEach((m, i) => {
                    const b0 = m.t.slice(0, 10);
                    const b1 = i + 1 < months.length ? months[i + 1].t.slice(0, 10) : '9999-12-31';
                    if (applied.some(s => s.date > b0 && s.date < b1)) return; // сплит внутри месяца — пропускаем
                    const f = splitFactorAt(applied, b0);
                    const h = m.h * f;
                    const l = m.l * f;
                    if (h > 0 && (mMax === null || h > mMax)) { mMax = h; mMaxB = b0; }
                    if (l > 0 && (mMin === null || l < mMin)) { mMin = l; mMinB = b0; }
                });
                monthlyOk = months.length > 0;
                if (mMax !== null && all.max !== null && mMax > all.max * 1.005) {
                    notes.push(`Дневная история неполная: максимум уточнён по месячным свечам (${mMaxB.slice(0, 7)}).`);
                    all.max = mMax;
                    all.maxD = mMaxB.slice(0, 7);
                }
                if (mMin !== null && all.min !== null && mMin < all.min * 0.995) {
                    notes.push(`Дневная история неполная: минимум уточнён по месячным свечам (${mMinB.slice(0, 7)}).`);
                    all.min = mMin;
                    all.minD = mMinB.slice(0, 7);
                }
            } catch (e) {
                console.error('monthly', e);
            }
            if (!monthlyOk) notes.push('Перекрёстная проверка по месячным свечам недоступна.');
            if (missing > 0 || stillFailed.length) {
                notes.push(`Не загружено ${missing} дней из ${total}: значения могли быть неточными (см. проверку по месяцам).`);
            }

            const acc = {
                t: Date.now(), rows: rows.length, total, missing,
                first: rows.length ? rows[0].d : null, last: rows.length ? rows[rows.length - 1].d : null,
                all, y5, w52, notes, monthlyOk
            };
            histStats[ticker] = acc;
            writeJson(`moexHeatmap.hist2.${ticker}`, acc);
            delete histErrors[ticker];
            return acc;
        } catch (e) {
            console.error(e);
            histErrors[ticker] = e.message;
            return null;
        } finally {
            histPromises[ticker] = null;
        }
    })();

    return histPromises[ticker];
}

function loadHistoryStats(ticker) {
    const enc = encodeURIComponent(ticker);
    return loadStatsFor(ticker, {
        historyBase: `${HISTORY_PATH}/securities/${enc}`,
        candlesBase: `${BOARD_PATH}/securities/${enc}`,
        splits: true,
        splitsTicker: ticker,
        onProgress: () => { if (modalTicker === ticker) renderModalHist(); }
    });
}

function renderModalHist() {
    const box = document.getElementById('modalHist');
    if (!modalTicker) return;
    const ticker = modalTicker;
    const stock = stockByTicker[ticker];
    const item = modalItem();
    box.replaceChildren(buildHistBox(ticker, item ? currentPrice(item) : null, stock ? stock.decimals : null, '₽', `доска ${BOARD}`));
}

/* ---------- дивиденды ---------- */

const RUB_CUR = new Set(['SUR', 'RUB', 'RUR', '']);
function isRubCur(cur) { return RUB_CUR.has(String(cur || '').toUpperCase()); }

/* Таблицы smart-lab: заголовки ищем по названию колонки, а не по номеру. */
function smartlabColumns(header) {
    const idx = re => header.findIndex(h => re.test(h));
    return {
        ticker: idx(/тикер/i),
        period: idx(/период/i),
        buyUntil: idx(/(дата\s*t-?\s*1|купить\s*до)/i),
        date: idx(/(дата\s*отсечки|дата закрытия реестра)/i),
        yield: idx(/дох/i),
        price: idx(/цена/i),
        amount: header.findIndex(h => /дивиденд/i.test(h) && !/дох/i.test(h))
    };
}

/* История выплат по бумаге: https://smart-lab.ru/q/<ТИКЕР>/dividend/ (в таблице есть и цена на дату, и доходность). */
function parseSmartlabHistory(html, ticker) {
    const out = [];
    parseHtmlTables(html).forEach(rows => {
        const c = smartlabColumns(rows[0]);
        if (c.ticker < 0 || c.date < 0 || c.amount < 0) return;
        rows.slice(1).forEach(r => {
            if (String(r[c.ticker]).trim().toUpperCase() !== ticker.toUpperCase()) return;
            const date = ruDate(r[c.date]);
            const value = ruNumber(r[c.amount]);
            if (!date || value === null) return;
            out.push({
                date, value, cur: 'RUB', src: 'smart-lab',
                buyUntil: c.buyUntil >= 0 ? ruDate(r[c.buyUntil]) : null,
                period: c.period >= 0 ? r[c.period] : '',
                price: c.price >= 0 ? ruNumber(r[c.price]) : null,
                yieldPct: c.yield >= 0 ? ruNumber(r[c.yield]) : null
            });
        });
    });
    return out;
}

/* Календарь предстоящих дивидендов всех компаний: https://smart-lab.ru/dividends/ */
function parseSmartlabUpcoming(html) {
    const out = {};
    parseHtmlTables(html).forEach(rows => {
        const c = smartlabColumns(rows[0]);
        if (c.ticker < 0 || c.date < 0 || c.amount < 0) return;
        rows.slice(1).forEach(r => {
            const t = String(r[c.ticker]).trim().toUpperCase();
            const date = ruDate(r[c.date]);
            const value = ruNumber(r[c.amount]);
            if (!t || !/^[A-Z0-9]{2,8}$/.test(t) || !date || value === null) return;
            const rec = {
                date, value, buyUntil: c.buyUntil >= 0 ? ruDate(r[c.buyUntil]) : null,
                period: c.period >= 0 ? r[c.period] : '', yieldPct: c.yield >= 0 ? ruNumber(r[c.yield]) : null,
                price: c.price >= 0 ? ruNumber(r[c.price]) : null
            };
            if (!out[t] || rec.date < out[t].date) out[t] = rec;
        });
    });
    return out;
}

/* Дивиденды бумаги. Сначала smart-lab (даты, суммы, цены и доходности), если не вышло — ISS MOEX. */
function loadDividends(ticker) {
    if (divData[ticker]) return Promise.resolve(divData[ticker]);
    if (divPromises[ticker]) return divPromises[ticker];

    divPromises[ticker] = (async () => {
        const diag = [];
        let rows = [];
        let src = null;

        try {
            const r = await fetchTextViaProxies(`https://smart-lab.ru/q/${encodeURIComponent(ticker)}/dividend/`,
                t => /дивиденд/i.test(t) && /<table/i.test(t));
            rows = parseSmartlabHistory(r.text, ticker);
            if (rows.length) src = `smart-lab (${r.via})`;
            else diag.push('smart-lab: таблица выплат не найдена');
        } catch (e) {
            diag.push(`smart-lab: ${e.message}`);
        }

        if (!rows.length) {
            try {
                const data = await fetchJson(`${MOEX_ISS}/securities/${encodeURIComponent(ticker)}/dividends.json?iss.meta=off`, { retries: 1, timeout: 15000 });
                Object.keys(data).forEach(k => {
                    const d = data[k];
                    if (!d || !Array.isArray(d.columns) || !Array.isArray(d.data)) return;
                    const iDate = col(d.columns, 'registryclosedate');
                    const iVal = col(d.columns, 'value');
                    if (iDate < 0 || iVal < 0) return;
                    const iCur = col(d.columns, 'currencyid');
                    d.data.forEach(r => {
                        const value = num(r[iVal]);
                        if (value !== null && r[iDate]) {
                            rows.push({ date: String(r[iDate]).slice(0, 10), value, cur: String(r[iCur] || 'RUB').toUpperCase(), src: 'ISS', price: null, yieldPct: null });
                        }
                    });
                });
                if (rows.length) src = 'ISS MOEX';
                else diag.push('ISS: пустой ответ');
            } catch (e) {
                diag.push(`ISS: ${e.message}`);
            }
        }

        rows.sort((a, b) => String(b.date).localeCompare(String(a.date)));
        divData[ticker] = { rows, src, diag: rows.length ? [] : diag };
        divPromises[ticker] = null;
        return divData[ticker];
    })();

    return divPromises[ticker];
}

function formatPct1(v) {
    return v === null || v === undefined || isNaN(v) ? '—' : nf(1).format(v) + ' %';
}

function shortDate(dateStr) {
    if (!dateStr) return '—';
    const [y, m, d] = String(dateStr).slice(0, 10).split('-');
    return `${d}.${m}.${y.slice(2)}`;
}

function daysUntil(dateStr) {
    const a = Date.parse(moscowDateStr(new Date()));
    const b = Date.parse(String(dateStr).slice(0, 10));
    return Math.round((b - a) / 86400000);
}

function manualDivs(ticker) {
    const a = readJson(`moexHeatmap.divmanual.${ticker}`);
    return Array.isArray(a) ? a : [];
}

/* Сводка по дивидендам: история бумаги + календарь smart-lab (по всем бумагам) + выплаты, внесённые вручную. */
function divSummary(ticker) {
    const dv = divData[ticker];
    const up = upcomingMap[ticker] || null;
    if (!dv && !up) return null;

    const item = lastSnapshot && lastSnapshot.get(ticker);
    const price = item ? currentPrice(item) : null;
    const today = moscowDateStr(new Date());
    const dateOf = r => String(r.date).slice(0, 10);

    const all = (dv ? dv.rows : []).map(r => ({ ...r, date: dateOf(r), manual: false }))
        .concat(manualDivs(ticker).map(r => ({ date: String(r.date).slice(0, 10), value: r.value, cur: 'RUB', manual: true, note: r.note, price: null, yieldPct: null })));
    if (up && !all.some(r => r.date === up.date)) {
        all.push({ date: up.date, value: up.value, cur: 'RUB', manual: false, src: 'smart-lab', buyUntil: up.buyUntil, period: up.period, price: up.price, yieldPct: up.yieldPct });
    }

    const future = all.filter(r => r.date >= today).sort((a, b) => a.date.localeCompare(b.date));
    const past = all.filter(r => r.date < today).sort((a, b) => b.date.localeCompare(a.date));

    const cutoff = shiftDateStr(today, { days: -365 });
    const ttmRows = past.filter(r => r.date >= cutoff && isRubCur(r.cur));
    const ttm = ttmRows.reduce((s, r) => s + r.value, 0);
    const yieldTtm = price ? (ttm > 0 ? (ttm / price) * 100 : 0) : null;

    let est = null;
    if (!future.length) {
        const lookback = shiftDateStr(today, { days: -400 });
        const cands = past.filter(r => r.date >= lookback && isRubCur(r.cur))
            .map(r => ({ date: shiftDateStr(r.date, { months: 12 }), value: r.value }))
            .filter(r => r.date >= today)
            .sort((a, b) => a.date.localeCompare(b.date));
        est = cands[0] || null;
    }

    const upcoming = future[0] || null;
    const upYield = upcoming && upcoming.yieldPct !== null && upcoming.yieldPct !== undefined
        ? upcoming.yieldPct
        : upcoming && price ? (upcoming.value / price) * 100 : null;

    return { price, future, past, upcoming, est, ttm, ttmCount: ttmRows.length, yieldTtm, upYield, all, hasHistory: !!(dv && dv.rows.length) };
}

function runPool(items, worker, size) {
    let i = 0;
    const runners = Array.from({ length: Math.min(size, items.length) }, async () => {
        while (i < items.length) {
            const item = items[i++];
            await worker(item);
        }
    });
    return Promise.all(runners);
}

function setDivStatus(cls, text) {
    const box = document.getElementById('divStatus');
    box.className = 'status' + (cls ? ' ' + cls : '');
    box.textContent = text;
}

/* Один запрос календаря дивидендов smart-lab на все бумаги (кэш на 6 часов). */
function ensureAllDividends() {
    if (divAllLoaded) return Promise.resolve(true);
    if (divAllPromise) return divAllPromise;

    divAllPromise = (async () => {
        try {
            const cached = readJson(DIV_CACHE_KEY);
            let map = cached && cached.map && Date.now() - cached.t < DIV_TTL ? cached.map : null;
            if (!map) {
                setDivStatus('loading', 'Загрузка календаря дивидендов (smart-lab)...');
                const r = await fetchTextViaProxies('https://smart-lab.ru/dividends/', t => /Тикер/i.test(t) && /<table/i.test(t));
                map = parseSmartlabUpcoming(r.text);
                if (!Object.keys(map).length) throw new Error('таблица дивидендов не найдена в ответе');
                writeJson(DIV_CACHE_KEY, { t: Date.now(), map, via: r.via });
            }
            const today = moscowDateStr(new Date());
            Object.keys(upcomingMap).forEach(k => delete upcomingMap[k]);
            Object.keys(map).forEach(t => { if (map[t].date >= today) upcomingMap[t] = map[t]; });
            const n = allStocks.filter(s => upcomingMap[s.ticker]).length;
            divAllLoaded = true;
            setDivStatus('ok', `Дивиденды (smart-lab): предстоящие выплаты у ${n} бумаг из ${allStocks.length}`);
            return true;
        } catch (e) {
            console.error(e);
            setDivStatus('error', `Не удалось загрузить календарь дивидендов: ${e.message}. Проверьте сеть/VPN и нажмите кнопку ещё раз.`);
            return false;
        } finally {
            divAllPromise = null;
        }
    })();

    return divAllPromise;
}

function updateSortButtons() {
    document.getElementById('divDateBtn').className = 'toggle' + (sortMode === 'divDate' ? ' active' : '');
    document.getElementById('divYieldBtn').className = 'toggle' + (sortMode === 'divYield' ? ' active' : '');
}

function setSortMode(mode) {
    sortMode = sortMode === mode ? 'change' : mode;
    updateSortButtons();

    if (sortMode === 'change') {
        setDivStatus('', '');
        if (lastSnapshot) applySnapshot(lastSnapshot);
        return;
    }

    ensureAllDividends().then(() => {
        if (lastSnapshot) applySnapshot(lastSnapshot);
    });
}

/* В режиме дивидендной сортировки вместо ₽-изменения на плитке показываем дату / доходность. */
function applyDivMetric() {
    if (sortMode === 'change' || !divAllLoaded) return;
    allStocks.forEach(stock => {
        const els = cardEls[stock.ticker];
        if (!els) return;
        const d = divSummary(stock.ticker);
        let text = 'нет данных';
        if (d) {
            if (sortMode === 'divDate') {
                text = d.upcoming ? shortDate(d.upcoming.date) : d.est ? `≈${shortDate(d.est.date)}` : 'нет дат';
            } else if (d.upcoming && d.upYield !== null) {
                text = `Див. ${formatPct1(d.upYield)}`;
            } else {
                text = d.yieldTtm > 0 ? `12м ${formatPct1(d.yieldTtm)}` : 'без дивид.';
            }
        }
        els.delta.textContent = text;
    });
}

/* Цена акции перед закрытием реестра (за 2 торговых дня: последний день покупки с дивидендом) — для расчёта доходности выплат. */
const ppCache = {};

async function loadPayoutPrices(ticker) {
    if (ppCache[ticker]) return ppCache[ticker];
    const d = divSummary(ticker);
    if (!d) return null;

    const today = moscowDateStr(new Date());
    const cutoff5 = shiftDateStr(today, { months: -60 });
    const dates = Array.from(new Set(d.past.filter(r => r.date >= cutoff5 && isRubCur(r.cur)).map(r => r.date))).slice(0, 30);

    const key = `moexHeatmap.pp.${ticker}`;
    const saved = readJson(key);
    const map = saved && Date.now() - saved.t < 7 * 24 * 3600 * 1000 ? saved.map : {};
    const need = dates.filter(x => map[x] === undefined);

    await runPool(need, async date => {
        try {
            const data = await fetchJson(
                `${HISTORY_PATH}/securities/${encodeURIComponent(ticker)}.json?iss.meta=off&iss.only=history` +
                `&history.columns=TRADEDATE,CLOSE&from=${shiftDateStr(date, { days: -14 })}&till=${shiftDateStr(date, { days: -1 })}`,
                { retries: 1, timeout: 15000 });
            const h = data.history;
            const closes = [];
            if (h && Array.isArray(h.data)) {
                const iD = col(h.columns, 'TRADEDATE');
                const iC = col(h.columns, 'CLOSE');
                h.data.forEach(r => { const c = num(r[iC]); if (c !== null && c > 0) closes.push({ d: String(r[iD]), c }); });
            }
            closes.sort((a, b) => a.d.localeCompare(b.d));
            const pick = closes.length >= 2 ? closes[closes.length - 2] : closes[closes.length - 1];
            map[date] = pick ? pick.c : null;
        } catch (e) {
            console.error('payout price', ticker, date, e);
        }
    }, 5);

    ppCache[ticker] = { map };
    writeJson(key, { t: Date.now(), map });
    return ppCache[ticker];
}

function renderModalDivTab() {
    const box = document.getElementById('modalDivTab');
    if (!modalTicker) return;
    const ticker = modalTicker;
    const stock = stockByTicker[ticker];
    const dv = divData[ticker];
    const parts = [];

    if (!dv) {
        box.replaceChildren(mk('div', 'note', 'Загрузка дивидендов...'));
        return;
    }
    const d = divSummary(ticker);
    const price = d.price;
    const today = moscowDateStr(new Date());

    // --- ближайшая выплата
    if (d.upcoming) {
        const u = d.upcoming;
        const box1 = mk('div', 'upcoming');
        box1.append(mk('h4', null, `Ближайшая выплата${u.manual ? ' (внесена вручную)' : ''}`));
        box1.append(rowEl('Закрытие реестра', `${humanDate(u.date)} (через ${daysUntil(u.date)} дн.)`));
        box1.append(rowEl('Размер', `${nf(2).format(u.value)} ₽`));
        if (price) box1.append(rowEl('Доходность к текущей цене', formatPct1((u.value / price) * 100), 'pos'));
        if (u.note) box1.append(rowEl('Заметка', u.note));
        parts.push(box1);
        d.future.slice(1, 4).forEach(r => parts.push(rowEl(`Далее: ${humanDate(r.date)}`, `${nf(2).format(r.value)} ₽`)));
    } else if (d.est) {
        const box2 = mk('div', 'estimate');
        box2.append(mk('h4', null, 'Ожидаемая выплата (оценка, не официально)'));
        box2.append(rowEl('Ориентировочная дата', `≈ ${humanDate(d.est.date)} (через ${daysUntil(d.est.date)} дн.)`));
        box2.append(rowEl('Ориентировочный размер', `${nf(2).format(d.est.value)} ₽ (как в прошлом году)`));
        if (price) box2.append(rowEl('Доходность к текущей цене', `≈ ${formatPct1((d.est.value / price) * 100)}`));
        box2.append(mk('div', 'note', 'Это не данные эмитента: дата и сумма взяты по прошлогодней выплате. Объявленных будущих дивидендов в источниках нет.'));
        parts.push(box2);
    } else {
        parts.push(mk('div', 'note', 'Объявленных будущих дивидендов не найдено. Если дивиденд объявлен, внесите его ниже.'));
    }

    // --- итоги за 12 месяцев и за 5 лет
    const cutoff5 = shiftDateStr(today, { months: -60 });
    const past5 = d.past.filter(r => r.date >= cutoff5);
    const rub5 = past5.filter(r => isRubCur(r.cur));
    const sum5 = rub5.reduce((s, r) => s + r.value, 0);

    parts.push(mk('h4', null, 'Итоги'));
    parts.push(rowEl('Текущая цена', price !== null ? `${formatPrice(price, stock ? stock.decimals : null)} ₽` : '—'));
    parts.push(rowEl('Выплаты за 12 месяцев', d.ttm > 0 ? `${nf(2).format(d.ttm)} ₽ (${d.ttmCount} шт.)` : 'не было'));
    parts.push(rowEl('Доходность за 12 месяцев (к текущей цене)', d.ttm > 0 ? formatPct1(d.yieldTtm) : '0 %', d.ttm > 0 ? 'pos' : ''));
    parts.push(rowEl('Выплаты за 5 лет', sum5 > 0 ? `${nf(2).format(sum5)} ₽ (${rub5.length} шт.)` : 'не было'));
    if (!d.past.length) {
        parts.push(mk('div', 'note',
            `Выплат не получено (${(dv.diag && dv.diag.length ? dv.diag.join('; ') : 'источники не вернули записей')}). ` +
            'Если эмитент платил дивиденды, проверьте внешние источники по ссылкам ниже или проверьте сеть/VPN.'));
    }

    // --- таблица за 5 лет: дата, сумма, цена на дату, доходность выплаты, доходность за год
    if (past5.length) {
        const pp = ppCache[ticker];
        parts.push(mk('div', 'sub-h', `Выплаты за 5 лет (${past5.length}), от новых к старым`));

        const table = mk('table', 'dt');
        const thead = mk('tr');
        ['Реестр', 'Сумма', 'Цена', 'Дох.', 'Год. дох.'].forEach(h => thead.append(mk('th', null, h)));
        table.append(thead);

        const trailing = date => {
            const from = shiftDateStr(date, { days: -365 });
            return d.past.filter(r => isRubCur(r.cur) && r.date <= date && r.date > from).reduce((s, r) => s + r.value, 0);
        };

        past5.slice(0, 40).forEach(r => {
            const tr = mk('tr');
            const cur = isRubCur(r.cur) ? '₽' : r.cur;
            const p = r.price || (pp && pp.map[r.date] ? pp.map[r.date] : null);
            const rub = isRubCur(r.cur);
            tr.append(mk('td', null, `${shortDate(r.date)}${r.manual ? '*' : ''}`));
            tr.append(mk('td', null, `${nf(2).format(r.value)} ${cur}`));
            tr.append(mk('td', null, p ? formatPrice(p, stock ? stock.decimals : null) : pp ? '—' : '...'));
            tr.append(mk('td', 'pos', p && rub ? formatPct1((r.value / p) * 100) : '—'));
            tr.append(mk('td', 'pos', p && rub ? formatPct1((trailing(r.date) / p) * 100) : '—'));
            table.append(tr);
        });
        parts.push(table);
        parts.push(mk('div', 'note',
            `Источник: ${dv.src || 'не определён'}. «Цена» и «Дох.» — как в источнике на момент выплаты; если их нет, цена берётся из истории MOEX за 2 торговых дня до реестра. ` +
            '«Дох.» — выплата / цена. «Год. дох.» — сумма выплат за 365 дней до этой даты / цена на эту дату.'));

        // --- по годам
        const byYear = {};
        rub5.forEach(r => {
            const y = r.date.slice(0, 4);
            byYear[y] = byYear[y] || { sum: 0, n: 0, prices: [] };
            byYear[y].sum += r.value;
            byYear[y].n++;
            const p = r.price || (pp && pp.map[r.date]);
            if (p) byYear[y].prices.push(p);
        });
        const years = Object.keys(byYear).sort((a, b) => b.localeCompare(a));
        if (years.length) {
            parts.push(mk('div', 'sub-h', 'По годам'));
            const yields = [];
            years.forEach(y => {
                const yy = byYear[y];
                const avgP = yy.prices.length ? yy.prices.reduce((s, x) => s + x, 0) / yy.prices.length : null;
                const yl = avgP ? (yy.sum / avgP) * 100 : null;
                if (yl !== null && y < today.slice(0, 4)) yields.push(yl);
                parts.push(rowEl(`${y} (${yy.n} шт.): ${nf(2).format(yy.sum)} ₽`,
                    yl !== null ? `${formatPct1(yl)} годовых` : '—', yl !== null ? 'pos' : ''));
            });
            if (yields.length) {
                parts.push(rowEl(`Средняя годовая доходность (${yields.length} полн. ${yields.length === 1 ? 'год' : 'лет'})`,
                    formatPct1(yields.reduce((s, x) => s + x, 0) / yields.length), 'pos'));
            }
            parts.push(mk('div', 'note', 'Годовая доходность по годам = сумма выплат за год / средняя цена на даты выплат этого года.'));
        }
    }
    if (d.past.length > past5.length) {
        parts.push(mk('div', 'note', `Более ранних выплат (старше 5 лет): ${d.past.length - past5.length}.`));
    }

    // --- ручной ввод будущего дивиденда
    const manual = manualDivs(ticker);
    parts.push(mk('div', 'sub-h', 'Внести объявленный дивиденд'));
    manual.forEach((r, idx) => {
        parts.push(rowEl(`${humanDate(r.date)}${r.note ? ' · ' + r.note : ''}`, `${nf(2).format(r.value)} ₽`));
        const del = mk('button', 'btn', 'Удалить');
        del.addEventListener('click', () => {
            const arr = manualDivs(ticker);
            arr.splice(idx, 1);
            writeJson(`moexHeatmap.divmanual.${ticker}`, arr);
            renderModalDivTab();
            if (lastSnapshot) applySnapshot(lastSnapshot);
        });
        parts.push(del);
    });
    const form = mk('div', 'forecast-form');
    const fDate = mk('input');
    fDate.type = 'date';
    const fVal = mk('input');
    fVal.type = 'number';
    fVal.step = 'any';
    fVal.placeholder = 'Сумма, ₽';
    const fNote = mk('input');
    fNote.type = 'text';
    fNote.placeholder = 'Заметка';
    const add = mk('button', null, 'Добавить');
    add.addEventListener('click', () => {
        const v = parseFloat(String(fVal.value).replace(',', '.'));
        if (!fDate.value || !Number.isFinite(v) || v <= 0) return;
        const arr = manualDivs(ticker);
        arr.push({ date: fDate.value, value: v, note: fNote.value || '' });
        writeJson(`moexHeatmap.divmanual.${ticker}`, arr);
        renderModalDivTab();
        if (lastSnapshot) applySnapshot(lastSnapshot);
    });
    form.append(fDate, fVal, fNote, add);
    parts.push(form);

    // --- где смотреть объявленные
    const mkLink = (text, href) => {
        const a = mk('a', 'btn', text);
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener';
        return a;
    };
    parts.push(mk('div', 'sub-h', 'Где смотреть объявленные и прогнозные дивиденды'));
    parts.push(mkLink('Дивиденды на Доход.ру', `https://www.dohod.ru/ik/analytics/dividend/${encodeURIComponent(ticker.toLowerCase())}`));
    parts.push(mkLink('Дивиденды на Smart-lab', `https://smart-lab.ru/q/${encodeURIComponent(ticker)}/dividend/`));
    parts.push(mk('div', 'note',
        'История и календарь берутся с smart-lab.ru через публичные прокси (запасной источник — ISS MOEX). Сторонние данные сверяйте с сообщениями эмитента.'));

    box.replaceChildren(...parts);

    // цены на даты выплат подгружаются отдельно и дорисовываются
    if (!ppCache[ticker] && d.past.some(r => !r.price)) {
        loadPayoutPrices(ticker).then(() => { if (modalTicker === ticker) renderModalDivTab(); });
    }
}


/* Прогнозы аналитиков через бесплатный API недоступны — храним собственный прогноз пользователя. */
function renderModalForecast() {
    const box = document.getElementById('modalForecast');
    if (!modalTicker) return;
    const ticker = modalTicker;
    const key = `moexHeatmap.forecast.${ticker}`;
    const saved = readJson(key);
    const item = modalItem();
    const price = item ? currentPrice(item) : null;

    const parts = [mk('h4', null, 'Прогноз цены (вручную)')];

    if (saved && saved.target) {
        const upside = price ? (saved.target / price - 1) * 100 : null;
        parts.push(rowEl(`Целевая цена${saved.source ? ' · ' + saved.source : ''}`, `${nf(2).format(saved.target)} ₽`));
        if (saved.date) parts.push(rowEl('Срок', humanDate(saved.date)));
        if (upside !== null) parts.push(rowEl('Потенциал к текущей цене', formatChange(upside), signCls(upside)));
    } else {
        parts.push(mk('div', 'note',
            'Целевые цены БКС и Т-Банка недоступны через открытый API, а страница работает без сервера. ' +
            'Откройте прогнозы по ссылкам ниже и при желании внесите цель сюда — потенциал посчитается сам.'));
    }

    const form = mk('div', 'forecast-form');
    const target = mk('input');
    target.type = 'number';
    target.step = 'any';
    target.placeholder = 'Цель, ₽';
    target.value = saved && saved.target ? String(saved.target) : '';
    const date = mk('input');
    date.type = 'date';
    date.value = (saved && saved.date) || '';
    const source = mk('select');
    ['БКС', 'Т-Банк', 'Другое'].forEach(s => {
        const o = mk('option', null, s);
        o.value = s;
        source.append(o);
    });
    source.value = (saved && saved.source) || 'БКС';
    const save = mk('button', null, 'Сохранить');
    save.addEventListener('click', () => {
        const t = parseFloat(String(target.value).replace(',', '.'));
        if (!Number.isFinite(t) || t <= 0) return;
        writeJson(key, { target: t, date: date.value || null, source: source.value });
        if (modalTicker === ticker) renderModalForecast();
    });
    const del = mk('button', null, 'Удалить');
    del.addEventListener('click', () => {
        try { localStorage.removeItem(key); } catch (_) { /* ignore */ }
        if (modalTicker === ticker) renderModalForecast();
    });
    form.append(target, date, source, save, del);
    parts.push(form);

    box.replaceChildren(...parts);
}

function renderModalLinks() {
    const box = document.getElementById('modalLinks');
    if (!modalTicker) return;
    const t = modalTicker;
    const mkLink = (text, href, cls) => {
        const a = mk('a', 'btn' + (cls ? ' ' + cls : ''), text);
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener';
        return a;
    };
    box.replaceChildren(
        mk('h4', null, 'Открыть и посмотреть прогнозы'),
        mkLink('Карточка в БКС (вкладка «Прогнозы»)', bcsUrl(t), 'primary'),
        mkLink('Т-Инвестиции', `https://www.tbank.ru/invest/stocks/${encodeURIComponent(t)}/`)
    );
}

/* ---------- кандидаты на разворот ---------- */

function monthsBetween(isoA, isoB) {
    const [ya, ma] = String(isoA).slice(0, 7).split('-').map(Number);
    const [yb, mb] = String(isoB).slice(0, 7).split('-').map(Number);
    return (yb * 12 + mb) - (ya * 12 + ma);
}

/* Месячные свечи с марта 2022: сколько раз обновлялся минимум, когда был последний, средний дневной оборот. */
async function analyzeMonthly(ticker) {
    const today = moscowDateStr(new Date());
    const url =
        `${BOARD_PATH}/securities/${encodeURIComponent(ticker)}/candles.json` +
        `?from=2022-03-01&till=${today}&interval=31&iss.meta=off&iss.only=candles` +
        `&candles.columns=begin,high,low,close,value`;
    const data = await fetchJson(url, { retries: 1, timeout: 20000 });
    const c = data.candles;
    if (!c || !Array.isArray(c.data)) return null;

    const iB = col(c.columns, 'begin');
    const iL = col(c.columns, 'low');
    const iV = col(c.columns, 'value');
    const rows = c.data
        .map(r => ({ begin: String(r[iB]).slice(0, 10), low: num(r[iL]), value: num(r[iV]) }))
        .filter(r => r.low !== null && r.low > 0);
    if (rows.length < 6) return null;

    let runMin = rows[0].low;
    let lowBegin = rows[0].begin;
    let count = 0;
    for (let i = 1; i < rows.length; i++) {
        if (rows[i].low < runMin) {
            runMin = rows[i].low;
            lowBegin = rows[i].begin;
            count++;
        }
    }

    const curMonth = today.slice(0, 7);
    const complete = rows.filter(r => r.begin.slice(0, 7) !== curMonth && r.value !== null).slice(-3);
    const avgTurnover = complete.length ? complete.reduce((s, r) => s + r.value, 0) / (complete.length * 21) : null;

    return { newLowMonths: count, absLow: runMin, lowBegin, avgTurnover };
}

async function loadReversal() {
    if (revState.status === 'loading' || revState.status === 'done') return;
    revState.status = 'loading';
    revState.error = null;
    renderReversal();

    try {
        const cached = readJson(REVERSAL.cacheKey);
        if (cached && cached.analysis && Date.now() - cached.t < REVERSAL.ttl) {
            revState.analysis = cached.analysis;
            revState.status = 'done';
            renderReversal();
            return;
        }

        let baseMap = readJson(REVERSAL.baseKey);
        if (!baseMap || !Object.keys(baseMap).length) {
            const r = await fetchHistoryDay(REVERSAL.baseDate, 'CLOSE');
            if (!r) throw new Error(`нет данных MOEX за ${humanDate(REVERSAL.baseDate)}`);
            baseMap = r.map;
            writeJson(REVERSAL.baseKey, baseMap);
        }

        const candidates = [];
        allStocks.forEach(stock => {
            const item = lastSnapshot && lastSnapshot.get(stock.ticker);
            const base = baseMap[stock.ticker];
            const price = item ? currentPrice(item) : null;
            if (!base || !price) return;
            const drop = (price / base - 1) * 100;
            if (drop <= -REVERSAL.minDrop) candidates.push({ ticker: stock.ticker, drop, base });
        });
        candidates.sort((a, b) => a.drop - b.drop);
        const list = candidates.slice(0, REVERSAL.maxCandidates);

        revState.progress = { done: 0, total: list.length };
        const analysis = {};
        await runPool(list, async cand => {
            try {
                const a = await analyzeMonthly(cand.ticker);
                if (a) analysis[cand.ticker] = { ...a, base: cand.base };
            } catch (e) {
                console.error(cand.ticker, e);
            }
            revState.progress.done++;
            if (revState.progress.done % 5 === 0) renderReversal();
        }, REVERSAL.concurrency);

        revState.analysis = analysis;
        writeJson(REVERSAL.cacheKey, { t: Date.now(), analysis });
        revState.status = 'done';
    } catch (e) {
        console.error(e);
        revState.status = 'error';
        revState.error = e.message;
    }
    renderReversal();
}

function kickReversal() {
    if (revState.scheduled || revState.status !== 'idle') return;
    revState.scheduled = true;
    setTimeout(loadReversal, 3000); // сначала основные данные, потом тяжёлый анализ
}

function renderReversal() {
    if (!revEls) return;
    const crit =
        `Критерии: падение к цене на ${humanDate(REVERSAL.baseDate)} не меньше ${REVERSAL.minDrop} %, ` +
        `новых минимумов с марта 2022 (по месяцам) не меньше ${REVERSAL.minNewLowMonths}, последний минимум не старше ${REVERSAL.maxMonthsSinceLow} мес., ` +
        `средний дневной оборот не меньше ${formatMoney(REVERSAL.minAvgTurnover)}. ` +
        'Это формальный отбор по цифрам, а не прогноз роста и не инвестсовет: падение может продолжиться.';

    revEls.title.textContent = `Кандидаты на разворот: падение с ${humanDate(REVERSAL.baseDate)} и новые минимумы (по % падения)`;

    if (revState.status === 'idle') {
        revEls.note.textContent = 'Анализ начнётся после загрузки котировок...';
        revEls.grid.replaceChildren();
        return;
    }
    if (revState.status === 'loading') {
        const p = revState.progress;
        revEls.note.textContent = p.total ? `Анализ истории: ${p.done} / ${p.total}...` : 'Загрузка данных за 2022 год...';
        revEls.grid.replaceChildren();
        return;
    }
    if (revState.status === 'error') {
        revEls.note.textContent = `Не удалось выполнить анализ: ${revState.error}. Нажмите «Обновить».`;
        revEls.grid.replaceChildren();
        return;
    }

    const today = moscowDateStr(new Date());
    const rows = [];
    allStocks.forEach(stock => {
        const a = revState.analysis && revState.analysis[stock.ticker];
        const item = lastSnapshot && lastSnapshot.get(stock.ticker);
        if (!a || !item) return;
        const price = currentPrice(item);
        if (!price || !a.base) return;
        const drop = (price / a.base - 1) * 100;
        if (drop > -REVERSAL.minDrop) return;
        if (a.newLowMonths < REVERSAL.minNewLowMonths) return;
        if (monthsBetween(a.lowBegin, today) > REVERSAL.maxMonthsSinceLow) return;
        if (a.avgTurnover === null || a.avgTurnover < REVERSAL.minAvgTurnover) return;
        rows.push({ stock, a, price, drop });
    });
    rows.sort((x, y) => x.drop - y.drop); // самые большие падения — первыми

    revEls.note.textContent = (rows.length ? `Найдено: ${rows.length}. ` : 'Сейчас под критерии никто не подходит. ') + crit;

    revEls.grid.replaceChildren(...rows.map(({ stock, a, price, drop }) => {
        const c = createCard(stock);
        c.price.textContent = formatPrice(price, stock.decimals);
        c.change.textContent = formatChange(drop);
        c.delta.textContent = `мин. ×${a.newLowMonths}`;
        c.card.className = 'card ' + getBgClass(drop, 'month');
        c.card.title = `Падение к ${humanDate(REVERSAL.baseDate)}: ${formatChange(drop)}; ` +
            `новых минимумов (мес.): ${a.newLowMonths}; средний дневной оборот ≈ ${formatMoney(a.avgTurnover)}`;
        return c.card;
    }));
}

