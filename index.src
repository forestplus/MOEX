/* ---------- вкладка «О компании» ---------- */

const infoCache = {};
const SECTOR_INDEX = {
    MOEXOG: 'Нефть и газ', MOEXEU: 'Электроэнергетика', MOEXTL: 'Телекоммуникации', MOEXMM: 'Металлы и добыча',
    MOEXFN: 'Финансы', MOEXCN: 'Потребительский сектор', MOEXCH: 'Химия и нефтехимия', MOEXIT: 'Информационные технологии',
    MOEXRE: 'Строительство и недвижимость', MOEXTN: 'Транспорт'
};
const SMARTLAB_METRICS = [
    ['Капитализация', /^капитализация/i], ['EV', /^ev\b(?!\/)/i], ['Выручка', /^(выручка|чист\S* операц)/i],
    ['Чистая прибыль', /^чистая прибыль/i], ['EPS', /^eps/i], ['P/E', /^p\/e/i], ['P/B', /^p\/b/i], ['P/S', /^p\/s/i],
    ['EV/EBITDA', /^ev\/ebitda/i], ['ROE', /^roe/i], ['ROA', /^roa/i], ['Долг', /^долг/i],
    ['Дивиденд на акцию', /^дивиденд/i], ['Дивидендная доходность', /^див\S*\s*доход/i], ['Free float', /free\s*float/i]
];

/* Разбор страницы https://smart-lab.ru/q/<ТИКЕР>/f/y/: сектор и ключевые показатели (последнее значение в строке). */
function parseSmartlabFundamentals(html) {
    const res = { sector: null, metrics: [] };
    const sm = html.match(/нализ\s+сектора\s*([^<"\n]{2,40})/i);
    if (sm) res.sector = cleanHtml(sm[1]);
    parseHtmlTables(html).forEach(rows => {
        if (rows.length < 5) return;
        const head = rows[0];
        SMARTLAB_METRICS.forEach(([name, re]) => {
            if (res.metrics.some(m => m.name === name)) return;
            const row = rows.find(r => r.length > 2 && re.test(String(r[0]).trim()));
            if (!row) return;
            let idx = -1;
            for (let i = row.length - 1; i >= 1; i--) {
                if (String(row[i]).trim() !== '' && ruNumber(row[i]) !== null) { idx = i; break; }
            }
            if (idx > 0) res.metrics.push({ name, label: row[0], value: row[idx], period: head[idx] || '' });
        });
    });
    return res;
}

async function loadInfo(ticker) {
    if (infoCache[ticker]) return infoCache[ticker];
    const stock = stockByTicker[ticker];
    const item = lastSnapshot && lastSnapshot.get(ticker);
    const enc = encodeURIComponent(ticker);
    const res = { desc: null, indices: [], smart: null, wiki: null, market: null, errors: [] };
    const guard = (name, fn) => fn().catch(e => { console.error(name, e); res.errors.push(`${name}: ${e.message}`); });

    await Promise.all([
        guard('описание MOEX', async () => {
            const data = await fetchJson(`${MOEX_ISS}/securities/${enc}.json?iss.meta=off&iss.only=description`, { retries: 1, timeout: 15000 });
            const d = data.description;
            if (d && Array.isArray(d.data)) {
                const iN = col(d.columns, 'name');
                const iT = col(d.columns, 'title');
                const iV = col(d.columns, 'value');
                res.desc = {};
                d.data.forEach(r => { res.desc[String(r[iN]).toUpperCase()] = { title: r[iT], value: r[iV] }; });
            }
        }),
        guard('индексы MOEX', async () => {
            const data = await fetchJson(`${MOEX_ISS}/securities/${enc}/indices.json?iss.meta=off&only_actual=1`, { retries: 1, timeout: 15000 });
            const d = data.indices;
            if (d && Array.isArray(d.data)) {
                const iS = col(d.columns, 'SECID');
                const iN = col(d.columns, 'SHORTNAME');
                d.data.forEach(r => res.indices.push({ id: String(r[iS]), name: r[iN] || r[iS] }));
            }
        }),
        guard('показатели smart-lab', async () => {
            let r;
            try {
                r = await fetchTextViaProxies(`https://smart-lab.ru/q/${enc}/f/y/`, t => /<table/i.test(t) && /капитализация|P\/E/i.test(t));
            } catch (e) {
                if (!/P$/.test(ticker)) throw e;
                r = await fetchTextViaProxies(`https://smart-lab.ru/q/${encodeURIComponent(ticker.slice(0, -1))}/f/y/`, t => /<table/i.test(t) && /капитализация|P\/E/i.test(t));
            }
            res.smart = parseSmartlabFundamentals(r.text);
        }),
        guard('описание компании', async () => {
            const nm = cleanCompanyName((item && item.secname) || (stock && stock.name));
            res.wiki = await wikiSummary([nm, `${cleanCompanyName(stock && stock.name)} компания`]);
        }),
        guard('оборот и волатильность', async () => {
            const today = moscowDateStr(new Date());
            const rows = await fetchCandlePages(`${BOARD_PATH}/securities/${enc}`,
                `interval=24&from=${shiftDateStr(today, { days: -75 })}&till=${encodeURIComponent(today + ' 23:59:59')}`);
            const last = rows.slice(-30);
            const vals = last.map(r => r.val).filter(v => v !== null);
            const rets = [];
            for (let i = 1; i < rows.length; i++) if (rows[i - 1].c > 0 && rows[i].c > 0) rets.push(Math.log(rows[i].c / rows[i - 1].c));
            let vol = null;
            if (rets.length > 5) {
                const mean = rets.reduce((s, x) => s + x, 0) / rets.length;
                vol = Math.sqrt(rets.reduce((s, x) => s + (x - mean) * (x - mean), 0) / (rets.length - 1)) * Math.sqrt(252) * 100;
            }
            res.market = {
                avgTurnover: vals.length ? vals.reduce((s, x) => s + x, 0) / vals.length : null,
                days: vals.length, vol, volDays: rets.length
            };
        })
    ]);

    infoCache[ticker] = res;
    return res;
}

function renderModalInfo() {
    const box = document.getElementById('modalInfo');
    if (!modalTicker) return;
    const ticker = modalTicker;
    const stock = stockByTicker[ticker];
    const item = modalItem();
    const info = infoCache[ticker];

    if (!info) {
        box.replaceChildren(mk('div', 'note', 'Загрузка сведений о компании...'));
        loadInfo(ticker).then(() => { if (modalTicker === ticker && modalTab === 'info') renderModalInfo(); });
        return;
    }

    const parts = [];

    parts.push(mk('h4', null, 'Чем занимается'));
    if (info.wiki) {
        const ex = info.wiki.extract.length > 900 ? info.wiki.extract.slice(0, 900).replace(/\s\S*$/, '') + '…' : info.wiki.extract;
        parts.push(mk('div', 'info-text', ex));
        if (info.wiki.url) {
            const a = mk('a', 'btn', `Статья «${info.wiki.title}» в Википедии`);
            a.href = info.wiki.url;
            a.target = '_blank';
            a.rel = 'noopener';
            parts.push(a);
        }
        parts.push(mk('div', 'note', 'Описание подобрано автоматически по названию и может относиться к другой организации — сверяйте со статьёй.'));
    } else {
        parts.push(mk('div', 'note', 'Описание не найдено автоматически. Смотрите карточку эмитента по ссылкам внизу.'));
    }

    parts.push(mk('h4', null, 'Отрасль и сектор'));
    const sectors = info.indices.filter(i => SECTOR_INDEX[i.id]).map(i => SECTOR_INDEX[i.id]);
    if (info.smart && info.smart.sector) parts.push(rowEl('Сектор (smart-lab)', info.smart.sector));
    if (sectors.length) parts.push(rowEl('Отраслевой индекс MOEX', sectors.join(', ')));
    const broad = info.indices.filter(i => !SECTOR_INDEX[i.id]).slice(0, 8).map(i => i.name);
    if (broad.length) parts.push(rowEl('Входит в индексы', broad.join(', ')));
    if (!(info.smart && info.smart.sector) && !sectors.length) parts.push(mk('div', 'note', 'Сектор определить не удалось.'));

    parts.push(mk('h4', null, 'О бумаге (MOEX)'));
    const d = info.desc || {};
    const field = (key, label) => { if (d[key] && d[key].value) parts.push(rowEl(label || d[key].title || key, String(d[key].value))); };
    field('NAME', 'Полное наименование');
    field('LATNAME', 'Латинское название');
    field('ISIN', 'ISIN');
    field('TYPENAME', 'Тип');
    field('ISSUESIZE', 'Выпущено акций');
    field('FACEVALUE', 'Номинал');
    field('LISTLEVEL', 'Уровень листинга');
    field('ISSUEDATE', 'Дата начала торгов');
    field('REGNUMBER', 'Регистрационный номер');
    if (!info.desc) parts.push(mk('div', 'note', 'Описание бумаги MOEX не загрузилось.'));

    parts.push(mk('h4', null, 'Рыночные показатели'));
    if (item) {
        if (item.cap) parts.push(rowEl('Капитализация', formatMoney(item.cap)));
        if (item.lotSize) parts.push(rowEl('Размер лота', `${formatInt(item.lotSize)} шт.`));
    }
    if (info.market) {
        if (info.market.avgTurnover !== null) parts.push(rowEl(`Средний дневной оборот (${info.market.days} дн.)`, formatMoney(info.market.avgTurnover)));
        if (info.market.vol !== null) parts.push(rowEl('Волатильность (годовая, по дням)', formatPct1(info.market.vol)));
    }
    const st = histStats[ticker];
    const price = item ? currentPrice(item) : null;
    if (st && st.w52 && st.w52.max && price) {
        parts.push(rowEl('До максимума 52 недель', formatChange((price / st.w52.max - 1) * 100), signCls(price / st.w52.max - 1)));
        parts.push(rowEl('От минимума 52 недель', formatChange((price / st.w52.min - 1) * 100), signCls(price / st.w52.min - 1)));
    }
    const ds = divSummary(ticker);
    if (ds && ds.yieldTtm !== null) parts.push(rowEl('Дивидендная доходность (12 мес.)', ds.ttm > 0 ? formatPct1(ds.yieldTtm) : 'выплат не было'));

    parts.push(mk('h4', null, 'Финансовые показатели (smart-lab, МСФО)'));
    if (info.smart && info.smart.metrics.length) {
        info.smart.metrics.forEach(m => parts.push(rowEl(`${m.label}${m.period ? ' · ' + m.period : ''}`, m.value)));
        parts.push(mk('div', 'note', 'Последнее доступное значение в строке отчётности; единицы указаны в названии показателя. Данные сторонние, сверяйте с отчётностью эмитента.'));
    } else {
        parts.push(mk('div', 'note', 'Показатели не загрузились (нет данных по этой бумаге или недоступны прокси).'));
    }

    if (info.errors.length) parts.push(mk('div', 'note', `Часть данных не загрузилась: ${info.errors.join('; ')}`));

    const mkLink = (text, href) => {
        const a = mk('a', 'btn', text);
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener';
        return a;
    };
    parts.push(mkLink('Показатели на Smart-lab', `https://smart-lab.ru/q/${encodeURIComponent(ticker)}/f/y/`));
    parts.push(mkLink('Страница на MOEX', `https://www.moex.com/ru/issue.aspx?code=${encodeURIComponent(ticker)}&board=${BOARD}`));

    box.replaceChildren(...parts);
}

/* ---------- вкладки «Стакан» и «Новости» ---------- */

function renderModalBook() {
    const box = document.getElementById('modalBook');
    const ticker = modalTicker;
    if (!ticker) return;
    const stock = stockByTicker[ticker];
    const item = modalItem();
    renderOrderBook(box, {
        url: `${BOARD_PATH}/securities/${encodeURIComponent(ticker)}/orderbook.json?iss.meta=off`,
        dec: stock && Number.isInteger(stock.decimals) ? stock.decimals : 2,
        bid: item ? item.bid : null,
        offer: item ? item.offer : null,
        bcsUrl: bcsUrl(ticker)
    });
}

let newsFor = null;
let newsAt = 0;
function renderModalNews() {
    const box = document.getElementById('modalNews');
    const ticker = modalTicker;
    if (!ticker) return;
    if (newsFor === ticker && Date.now() - newsAt < 60000) return;
    newsFor = ticker;
    newsAt = Date.now();
    const stock = stockByTicker[ticker];
    const item = modalItem();
    const nm = cleanCompanyName((item && item.secname) || (stock && stock.name)) || ticker;
    const short = cleanCompanyName(stock && stock.name).toLowerCase();
    const stem = short.length >= 5 ? short.slice(0, Math.max(4, Math.min(short.length, 7))) : short;
    renderNewsTab(box, `${nm} акции`, title => {
        const t = title.toLowerCase();
        return t.includes(ticker.toLowerCase()) || (stem && t.includes(stem)) || t.includes(nm.toLowerCase().slice(0, 6));
    });
}


/* ---------- курсы валют, металлы, индекс ---------- */

const CETS_PATH = `${MOEX_ISS}/engines/currency/markets/selt/boards/CETS`;
const CETS_HIST = `${MOEX_ISS}/history/engines/currency/markets/selt/boards/CETS`;
const RATES = [
    { id: 'USD',   label: 'USD/RUB',    kind: 'cets',  sec: 'USD000UTSTOM', cbr: 'USD', preferCbr: true,  dec: 2, unit: '₽' },
    { id: 'EUR',   label: 'EUR/RUB',    kind: 'cets',  sec: 'EUR_RUB__TOM', cbr: 'EUR', preferCbr: true,  dec: 2, unit: '₽' },
    { id: 'HKD',   label: 'HKD/RUB',    kind: 'cets',  sec: 'HKDRUB_TOM',   cbr: 'HKD', preferCbr: true,  dec: 3, unit: '₽' },
    { id: 'CNY',   label: 'CNY/RUB',    kind: 'cets',  sec: 'CNYRUB_TOM',   cbr: 'CNY', preferCbr: false, dec: 3, unit: '₽' },
    { id: 'GLD',   label: 'Золото',     kind: 'cets',  sec: 'GLDRUB_TOM',   dec: 2, unit: '₽/г' },
    { id: 'SLV',   label: 'Серебро',    kind: 'cets',  sec: 'SLVRUB_TOM',   dec: 2, unit: '₽/г' },
    { id: 'IMOEX', label: 'Индекс MOEX', kind: 'index', sec: 'IMOEX',        dec: 2, unit: '' }
];
const ratesIss = {};      // sec -> { value, change, prev, open, low, high }
let ratesCbr = null;      // { USD: { value, prev }, ... , t }
let modalRate = null;
let ratePanel = null;

function rateBases(r) {
    if (r.kind === 'index') {
        return { candles: `${MOEX_ISS}/engines/stock/markets/index/securities/${r.sec}`, history: `${MOEX_ISS}/history/engines/stock/markets/index/securities/${r.sec}` };
    }
    return { candles: `${CETS_PATH}/securities/${r.sec}`, history: `${CETS_HIST}/securities/${r.sec}` };
}

async function loadRates() {
    const secs = RATES.filter(r => r.kind === 'cets').map(r => r.sec).join(',');
    const tasks = [];

    tasks.push((async () => {
        const data = await fetchJson(
            `${CETS_PATH}/securities.json?iss.meta=off&iss.only=securities,marketdata&securities=${secs}`,
            { retries: 1, timeout: 12000 });
        const sec = data.securities;
        const md = data.marketdata;
        const prevBy = {};
        if (sec && Array.isArray(sec.data)) {
            const iS = col(sec.columns, 'SECID');
            const iP = col(sec.columns, 'PREVPRICE');
            const iW = col(sec.columns, 'PREVWAPRICE');
            sec.data.forEach(r => { prevBy[r[iS]] = num(r[iP]) ?? num(r[iW]); });
        }
        if (md && Array.isArray(md.data)) {
            const ix = n => col(md.columns, n);
            md.data.forEach(r => {
                const id = r[ix('SECID')];
                const last = num(r[ix('LAST')]);
                const prev = prevBy[id] ?? null;
                const value = last ?? num(r[ix('MARKETPRICE')]) ?? prev;
                let change = num(r[ix('LASTCHANGEPRCNT')]);
                if (change === null && value !== null && prev) change = (value / prev - 1) * 100;
                ratesIss[id] = { value, change: last === null ? 0 : change, prev, open: num(r[ix('OPEN')]), low: num(r[ix('LOW')]), high: num(r[ix('HIGH')]), live: last !== null };
            });
        }
    })().catch(e => console.error('курсы MOEX', e)));

    if (!ratesCbr || Date.now() - ratesCbr.t > 10 * 60 * 1000) {
        tasks.push((async () => {
            const data = await fetchJson('https://www.cbr-xml-daily.ru/daily_json.js', { retries: 1, timeout: 10000 });
            const out = { t: Date.now() };
            Object.keys(data.Valute || {}).forEach(k => {
                const v = data.Valute[k];
                if (v && v.Nominal && v.Value) out[k] = { value: v.Value / v.Nominal, prev: v.Previous ? v.Previous / v.Nominal : null };
            });
            ratesCbr = out;
        })().catch(e => console.error('курсы ЦБ', e)));
    }

    await Promise.all(tasks);
}

/* Что показываем по каждому курсу: ЦБ для USD/EUR/HKD (биржевые торги ими могут быть остановлены), MOEX для остального. */
function rateValue(r) {
    if (r.kind === 'index') {
        return imoex ? { value: imoex.value, change: imoex.pct, src: 'MOEX' } : null;
    }
    const iss = ratesIss[r.sec];
    const cbr = ratesCbr && r.cbr ? ratesCbr[r.cbr] : null;
    const fromCbr = cbr ? { value: cbr.value, change: cbr.prev ? (cbr.value / cbr.prev - 1) * 100 : null, src: 'ЦБ РФ' } : null;
    const fromIss = iss && iss.value !== null ? { value: iss.value, change: iss.change, src: 'MOEX', open: iss.open, low: iss.low, high: iss.high, prev: iss.prev } : null;
    if (r.preferCbr) return fromCbr || fromIss;
    return fromIss || fromCbr;
}

function renderRates() {
    const box = document.getElementById('rates');
    box.replaceChildren(...RATES.map(r => {
        const v = rateValue(r);
        const b = mk('button', 'rate');
        b.title = v ? `${r.label}: источник ${v.src}. Нажмите для графика и подробностей.` : 'Нет данных';
        b.append(mk('span', 'rl', r.label));
        b.append(mk('b', null, v ? nf(r.dec).format(v.value) : '—'));
        const c = v ? v.change : null;
        b.append(mk('span', c === null || c === undefined || Math.abs(c) < 0.005 ? 'rc' : c > 0 ? 'rc up' : 'rc down', formatChange(c)));
        b.addEventListener('click', () => openRate(r.id));
        return b;
    }));
}

function refreshRates() {
    loadRates().then(() => {
        renderRates();
        if (modalRate) renderRateLive();
    });
}

/* Общий блок «исторические минимум и максимум»: key — ключ в histStats, unit — единица, coverage — подпись источника. */
function buildHistBox(key, price, dec, unit, coverage) {
    const st = histStats[key];
    const hist = mk('div', 'hist-box');
    hist.append(mk('h4', null, 'Исторические минимум и максимум'));

    if (st && st.all.max !== null) {
        const pr = v => `${nf(Number.isInteger(dec) ? dec : defaultDecimals(v)).format(v)}${unit ? ' ' + unit : ''}`;
        const fromMax = price !== null && price !== undefined ? (price / st.all.max - 1) * 100 : null;
        const fromMin = price !== null && price !== undefined ? (price / st.all.min - 1) * 100 : null;
        const dl = d => (String(d).length === 7 ? `${String(d).slice(5, 7)}.${String(d).slice(0, 4)}` : humanDate(d));

        hist.append(rowEl(`Максимум за всё время (${dl(st.all.maxD)})`, pr(st.all.max)));
        if (fromMax !== null) hist.append(rowEl('Сейчас относительно максимума', formatChange(fromMax), signCls(fromMax)));
        hist.append(rowEl(`Минимум за всё время (${dl(st.all.minD)})`, pr(st.all.min)));
        if (fromMin !== null) hist.append(rowEl('Сейчас относительно минимума', formatChange(fromMin), signCls(fromMin)));
        if (st.y5.max !== null) {
            hist.append(rowEl(`Максимум за 5 лет (${dl(st.y5.maxD)})`, pr(st.y5.max)));
            hist.append(rowEl(`Минимум за 5 лет (${dl(st.y5.minD)})`, pr(st.y5.min)));
        }
        if (st.w52.max !== null) {
            hist.append(rowEl(`Максимум за 52 недели (${dl(st.w52.maxD)})`, pr(st.w52.max)));
            hist.append(rowEl(`Минимум за 52 недели (${dl(st.w52.minD)})`, pr(st.w52.min)));
        }
        hist.append(mk('div', 'note',
            `Дневная история MOEX (${coverage}): с ${humanDate(st.first)} по ${humanDate(st.last)}, ${formatInt(st.rows)} из ${formatInt(st.total)} торговых дней. ` +
            'Учитываются внутридневные минимум и максимум.'));
        (st.notes || []).forEach(t => hist.append(mk('div', 'note', t)));
    } else if (histErrors[key]) {
        hist.append(mk('div', 'note', `Не удалось загрузить историю: ${histErrors[key]}`));
    } else {
        const p = histProgress[key];
        hist.append(mk('div', 'note', p ? `Загрузка истории... ${formatInt(p.done)} из ${formatInt(p.total)} дней` : 'Загрузка истории...'));
    }
    return hist;
}

function openRate(id) {
    const r = RATES.find(x => x.id === id);
    if (!r) return;
    modalRate = id;
    document.getElementById('rateModal').hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('rateTitle').textContent = r.label;
    document.getElementById('rateSub').textContent = r.kind === 'index' ? 'Индекс МосБиржи' : r.id === 'GLD' || r.id === 'SLV' ? 'Цена за грамм, MOEX' : 'Курс к рублю';
    renderRateLive();
    renderRateHist();

    const b = rateBases(r);
    if (ratePanel) ratePanel.destroy();
    ratePanel = makeChartPanel({ candlesBase: b.candles, historyBase: b.history, decimals: r.dec });
    document.getElementById('rateChart').replaceChildren(mk('h4', null, 'График'), ratePanel.el);

    const key = `rate:${id}`;
    loadStatsFor(key, {
        historyBase: b.history, candlesBase: b.candles, splits: false,
        onProgress: () => { if (modalRate === id) renderRateHist(); }
    }).then(() => { if (modalRate === id) renderRateHist(); });
}

function closeRate() {
    if (ratePanel) {
        ratePanel.destroy();
        ratePanel = null;
    }
    document.getElementById('rateChart').replaceChildren();
    modalRate = null;
    document.getElementById('rateModal').hidden = true;
    document.body.style.overflow = '';
}

function renderRateLive() {
    const box = document.getElementById('rateLive');
    const r = modalRate && RATES.find(x => x.id === modalRate);
    if (!r) return;
    const v = rateValue(r);
    const rows = [mk('h4', null, 'Сейчас')];
    if (!v) {
        rows.push(mk('div', 'note', 'Данных нет: источник не ответил или торги по этому инструменту не ведутся.'));
    } else {
        rows.push(rowEl('Значение', `${nf(r.dec).format(v.value)}${r.unit ? ' ' + r.unit : ''}`));
        rows.push(rowEl('Изменение', formatChange(v.change), signCls(v.change)));
        rows.push(rowEl('Источник', v.src));
        if (v.prev) rows.push(rowEl('Предыдущее закрытие', nf(r.dec).format(v.prev)));
        if (v.open) rows.push(rowEl('Открытие сегодня', nf(r.dec).format(v.open)));
        if (v.low) rows.push(rowEl('Минимум сегодня', nf(r.dec).format(v.low)));
        if (v.high) rows.push(rowEl('Максимум сегодня', nf(r.dec).format(v.high)));
    }
    if (r.preferCbr) {
        rows.push(mk('div', 'note', 'Показан официальный курс ЦБ РФ (биржевые торги этой валютой могут быть остановлены). График и минимумы/максимумы — по данным MOEX и могут заканчиваться на дате остановки торгов.'));
    }
    rows.push(mk('div', 'note', 'Данные с задержкой. Курс ЦБ — через открытое зеркало cbr-xml-daily.ru.'));
    box.replaceChildren(...rows);
}

function renderRateHist() {
    const r = modalRate && RATES.find(x => x.id === modalRate);
    if (!r) return;
    const v = rateValue(r);
    document.getElementById('rateHist').replaceChildren(
        buildHistBox(`rate:${r.id}`, v ? v.value : null, r.dec, r.unit, r.kind === 'index' ? 'индекс' : 'валютный рынок MOEX'));
}


/* ---------- debug ---------- */

function setDebugText(text) {
    const box = document.getElementById('debugInfo');
    if (!box) return;
    box.hidden = !DEBUG;
    if (DEBUG) box.textContent = text;
}

async function loadDebugRows() {
    if (!DEBUG || currentPeriod === 'day') {
        debugRows = null;
        debugRowsKey = null;
        return;
    }
    const today = moscowDateStr(new Date());
    const key = `${currentPeriod}:${today}`;
    if (debugRowsKey === key) return;
    debugRowsKey = key;

    const target = currentPeriod === 'month'
        ? shiftDateStr(today, { months: -1 })
        : shiftDateStr(today, { days: -7 });
    const from = shiftDateStr(target, { days: -7 });
    const till = shiftDateStr(target, { days: 2 });

    try {
        const url =
            `${HISTORY_PATH}/securities/${encodeURIComponent(DEBUG_TICKER)}.json` +
            `?from=${from}&till=${till}&iss.meta=off&iss.only=history` +
            `&history.columns=TRADEDATE,OPEN,CLOSE,LEGALCLOSEPRICE,WAPRICE`;
        const data = await fetchJson(url, { retries: 1 });
        const h = data.history;
        debugRows = (h && h.data ? h.data : []).map(r => ({
            date: r[0], OPEN: num(r[1]), CLOSE: num(r[2]), LEGAL: num(r[3]), WAP: num(r[4])
        }));
        debugRows.target = target;
    } catch (e) {
        debugRows = null;
        debugRowsKey = null;
        console.error(e);
    }
}

function debugResult(snapshot) {
    if (!DEBUG) return;

    const item = snapshot.get(DEBUG_TICKER);
    if (!item) {
        setDebugText(`DEBUG ${DEBUG_TICKER}: бумага не найдена в snapshot`);
        return;
    }

    const result = computeFor(item, currentPeriod);
    const basis = bases[currentPeriod] || {};
    const lines = [
        `DEBUG ${DEBUG_TICKER} · ${currentPeriod} · ${VERSION}`,
        `CURRENT: ${result.price ?? '—'}`,
        `BASE:    ${result.base ?? '—'}`,
        `DELTA:   ${result.delta ?? '—'}`,
        `PCT:     ${result.change == null ? '—' : result.change.toFixed(6) + ' %'}`
    ];

    if (currentPeriod === 'day') {
        lines.push(`PREVPRICE: ${item.prevPrice ?? '—'}`);
        lines.push(`PREVLEGALCLOSEPRICE: ${item.prevLegal ?? '—'}`);
        lines.push('', 'DAY = (CURRENT − PREVPRICE) / PREVPRICE × 100');
    } else {
        lines.push(`BASIS DATE: ${basis.date ? humanDate(basis.date) : '—'}`);
        lines.push(`BASIS TYPE: ${(basis.kinds && basis.kinds[DEBUG_TICKER]) || basis.kind || '—'}`);
        lines.push('');
        lines.push(currentPeriod === 'month'
            ? `MONTH = (CURRENT − WAPRICE[${basis.date || '—'}]) / WAPRICE × 100`
            : `WEEK = (CURRENT − CLOSE[${basis.date || '—'}]) / CLOSE × 100`);

        const price = result.price;
        const implied = Number.isFinite(DEBUG_BCS) && price ? price / (1 + DEBUG_BCS / 100) : null;
        if (implied) lines.push('', `БАЗА БКС для ${DEBUG_BCS}% ≈ ${implied.toFixed(implied < 10 ? 5 : 2)}`);

        if (debugRows && debugRows.length) {
            lines.push('', `ИСТОРИЯ ${DEBUG_TICKER} (цель ${humanDate(debugRows.target)}):`);
            debugRows.forEach(r => {
                const marks = [];
                if (implied) {
                    ['OPEN', 'CLOSE', 'LEGAL', 'WAP'].forEach(f => {
                        if (r[f] && Math.abs(r[f] / implied - 1) < 0.002) marks.push(f);
                    });
                }
                lines.push(
                    `${r.date} O ${r.OPEN ?? '—'} C ${r.CLOSE ?? '—'} ` +
                    `L ${r.LEGAL ?? '—'} W ${r.WAP ?? '—'}` +
                    (marks.length ? `  <== ≈БКС (${marks.join(',')})` : '')
                );
            });
        }
    }

    setDebugText(lines.join('\n'));
}

/* ---------- quotes ---------- */

function applySnapshot(snapshot) {
    lastSnapshot = snapshot;
    let updated = 0;

    allStocks.forEach(stock => {
        const item = snapshot.get(stock.ticker);
        if (!item) return;

        const result = computeFor(item, currentPeriod);
        if (result.price === null) return;

        updateCard(stock, result);
        if (result.change !== null) updated++;
    });

    sortCards();
    debugResult(snapshot);

    EXTREME_BLOCKS.forEach(cfg => renderExtremeBlock(cfg, snapshot));
    renderTopTurnover(snapshot);
    renderSummary(snapshot);
    applyDivMetric();
    renderReversal();
    if (modalTicker) renderModalLive();

    kickBackgroundBases();
    kickReversal();
    return updated;
}

function okStatusText(updated) {
    let text = `Обновлено ${updated} акций в ${new Date().toLocaleTimeString('ru-RU')} ` +
        `(MOEX, задержка ~15 мин) · ${VERSION}`;
    const b = bases[currentPeriod];
    if (currentPeriod === 'month' && b) {
        text += `. Месяц: WAPRICE за ${humanDate(b.date)}`;
    } else if (currentPeriod === 'week' && b) {
        text += `. База: закрытие ${humanDate(b.date)}`;
    }
    return text;
}

async function fetchQuotes(force = false) {
    if (!isInitialized) return;

    const now = Date.now();
    if (!force && now - lastRequestTime < MIN_REQUEST_GAP) return;

    const token = periodToken;
    if (activeToken === token) return;

    activeToken = token;
    lastRequestTime = now;

    try {
        setStatus('loading', 'Обновление...');

        if (currentPeriod !== 'day' && !basisFresh(currentPeriod) && canTryBasis(currentPeriod, force)) {
            setStatus('loading', 'Загрузка исторической базы...');
            await ensureBasis(currentPeriod);
            if (token !== periodToken) return;
        }

        const [snapshot, index] = await Promise.all([fetchSnapshot(), fetchIndex().catch(() => null)]);
        if (token !== periodToken) return;

        imoex = index;
        refreshRates();
        saveSnapshotCache(snapshot);
        const updated = applySnapshot(snapshot);

        if (DEBUG && currentPeriod !== 'day') {
            loadDebugRows().then(() => {
                if (token === periodToken) debugResult(snapshot);
            });
        }

        if (currentPeriod !== 'day' && !basisFresh(currentPeriod)) {
            setStatus('error', 'Не удалось загрузить историю — показаны только цены. Нажмите «Обновить».');
        } else {
            setStatus('ok', okStatusText(updated));
        }
    } catch (err) {
        console.error(err);
        if (token === periodToken) {
            setStatus('error', `Ошибка загрузки котировок: ${err.message}`);
        }
    } finally {
        if (activeToken === token) activeToken = null;
    }
}

/* ---------- timer ---------- */

function startTimer() {
    stopTimer();
    updateTimer = setInterval(() => fetchQuotes(), REQUEST_INTERVAL);
}

function stopTimer() {
    if (updateTimer) clearInterval(updateTimer);
    updateTimer = null;
}

/* ---------- start ---------- */

async function start() {
    if (isStarting || isInitialized) return;
    isStarting = true;
    clearTimeout(retryTimer);

    const stopProgress = showProgress('Загрузка списка акций');
    let snapshot = null;
    let cacheTime = null;
    let netErr = null;

    try {
        snapshot = await fetchSnapshot();
        saveSnapshotCache(snapshot);
    } catch (err) {
        console.error(err);
        netErr = err;
        const cached = loadSnapshotCache();
        if (cached) {
            snapshot = cached.snapshot;
            cacheTime = cached.time;
        }
    } finally {
        stopProgress();
    }

    const stocks = [];
    if (snapshot) {
        snapshot.forEach(item => {
            if (!isValidStock(item.name, item.sectype)) return;
            if (currentPrice(item) === null) return;
            stocks.push({ ticker: item.ticker, name: item.name, decimals: item.decimals });
        });
        stocks.sort((a, b) => a.ticker.localeCompare(b.ticker));
        if (!stocks.length && !netErr) netErr = new Error('фильтр не пропустил ни одной акции');
    }

    if (!stocks.length) {
        setStatus('error',
            `Ошибка загрузки: ${netErr ? netErr.message : 'нет данных'}. ` +
            `Повтор через ${START_RETRY_DELAY / 1000} с или нажмите «Обновить».`);
        isStarting = false;
        retryTimer = setTimeout(start, START_RETRY_DELAY);
        return;
    }

    allStocks = stocks;
    Object.keys(cardEls).forEach(k => delete cardEls[k]);
    allStocks.forEach(s => { stockByTicker[s.ticker] = s; });

    const grid = document.getElementById('grid');
    grid.innerHTML = '';
    allStocks.forEach(stock => renderCard(grid, stock));
    applySearch();

    isInitialized = true;
    isStarting = false;

    const updated = applySnapshot(snapshot);
    fetchIndex().then(i => { imoex = i; if (lastSnapshot) renderSummary(lastSnapshot); renderRates(); }).catch(() => {});
    refreshRates();
    const openParam = new URLSearchParams(location.search).get('open');
    if (openParam && stockByTicker[openParam.toUpperCase()]) openStock(openParam.toUpperCase());

    if (cacheTime) {
        const t = new Date(cacheTime).toLocaleString('ru-RU');
        setStatus('warn', `MOEX недоступен (${netErr.message}). Показаны данные из кэша от ${t}. Идёт повтор...`);
    } else if (currentPeriod === 'day') {
        setStatus('ok', okStatusText(updated));
    } else {
        fetchQuotes(true); // период успели сменить во время первой загрузки
    }

    startTimer();
}

/* ---------- events ---------- */

document.getElementById('bondsLink').href = BONDS_PAGE;
document.getElementById('favLink').href = FAV_PAGE;
document.getElementById('newsLink').href = NEWS_PAGE;

document.getElementById('periodSelect').addEventListener('change', e => {
    currentPeriod = e.target.value;
    periodToken++;
    basisFailedAt.week = 0;
    basisFailedAt.month = 0;

    allStocks.forEach(stock => resetCard(stock.ticker));
    fetchQuotes(true);
});

document.getElementById('refreshBtn').addEventListener('click', () => {
    if (!isInitialized) {
        start();
        return;
    }
    basisFailedAt.week = 0;
    basisFailedAt.month = 0;
    if (revState.status === 'error') {
        revState.status = 'idle';
        revState.scheduled = false;
    }
    fetchQuotes(true);
});

function updateOrderBtn() {
    document.getElementById('orderBtn').textContent = colorAsc ? '⇅ Красные → зелёные' : '⇅ Зелёные → красные';
}
document.getElementById('orderBtn').addEventListener('click', () => {
    colorAsc = !colorAsc;
    try { localStorage.setItem('mx.pref.order', colorAsc ? 'asc' : 'desc'); } catch (_) { /* ignore */ }
    updateOrderBtn();
    if (lastSnapshot) sortCards();
});
updateOrderBtn();

document.getElementById('modalStar').addEventListener('click', () => {
    if (!modalTicker) return;
    const stock = stockByTicker[modalTicker];
    FavStore.toggle('s', modalTicker, { name: stock ? stock.name : modalTicker });
    renderStar();
    refreshFavMarks();
});
FavStore.onChange(() => { renderStar(); refreshFavMarks(); });
FavStore.init();

MODAL_TABS.forEach(t => {
    document.getElementById('tab' + t[0].toUpperCase() + t.slice(1)).addEventListener('click', () => setModalTab(t));
});
document.getElementById('rateClose').addEventListener('click', closeRate);
document.getElementById('rateModal').addEventListener('click', e => {
    if (e.target === document.getElementById('rateModal')) closeRate();
});

document.getElementById('divDateBtn').addEventListener('click', () => setSortMode('divDate'));
document.getElementById('divYieldBtn').addEventListener('click', () => setSortMode('divYield'));
document.getElementById('logoutLink').addEventListener('click', e => {
    e.preventDefault();
    try { sessionStorage.removeItem('mx_k'); } catch (_) { /* ignore */ }
    location.reload();
});

document.getElementById('searchInput').addEventListener('input', e => {
    searchQuery = String(e.target.value || '').trim().toLowerCase();
    applySearch();
});

document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('modal').addEventListener('click', e => {
    if (e.target === document.getElementById('modal')) closeModal();
});
document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (modalRate) closeRate();
    else if (modalTicker) closeModal();
});

/* Не долбим MOEX из фоновой вкладки; при возврате сразу обновляемся. */
document.addEventListener('visibilitychange', () => {
    if (!isInitialized) return;
    if (document.hidden) {
        stopTimer();
    } else {
        fetchQuotes(true);
        startTimer();
    }
});

renderRates();
initBlocks();
start();
</script>
</body>
</html>
