<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Портфель БКС — аналитика</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; background: #f0f0f0; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .container { width: 100%; max-width: 1200px; background: #fff; padding: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.1); }
        .nav { display: flex; gap: 8px; margin-bottom: 10px; font-size: 14px; flex-wrap: wrap; }
        .nav a { padding: 4px 14px; border: 1px solid #ccc; border-radius: 16px; color: #333; text-decoration: none; background: #fff; }
        .nav a.active { background: #2e7d32; color: #fff; border-color: #2e7d32; }
        .nav a.logout { margin-left: auto; color: #777; }
        .header { display: flex; align-items: center; margin-bottom: 10px; font-size: 14px; color: #333; flex-wrap: wrap; gap: 10px; }
        .header button { padding: 4px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; background: #fff; cursor: pointer; }
        .header button:hover { background: #f5f5f5; }
        .status { font-size: 12px; color: #666; }
        .status.error { color: #c00; font-weight: bold; }
        .status.ok { color: #2e7d32; }
        .status.loading { color: #f57c00; }

        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px; margin-bottom: 12px; }
        .stat { border: 1px solid #eee; border-radius: 8px; padding: 10px 12px; background: #fafafa; }
        .stat .lbl { font-size: 11px; color: #777; margin-bottom: 4px; }
        .stat .val { font-size: 18px; font-weight: bold; color: #222; }
        .stat .sub { font-size: 12px; margin-top: 2px; }
        .pos { color: #2e7d32; font-weight: bold; }
        .neg { color: #c62828; font-weight: bold; }

        .alloc { display: flex; height: 14px; border-radius: 7px; overflow: hidden; background: #eee; margin: 4px 0 2px; }
        .alloc span { display: block; height: 100%; }
        .alloc-cap { font-size: 11px; color: #777; margin-bottom: 12px; }

        table.pf { width: 100%; border-collapse: collapse; font-size: 13px; }
        table.pf th { text-align: right; font-size: 11px; color: #777; padding: 6px 8px; border-bottom: 2px solid #e0e0e0; cursor: pointer; user-select: none; white-space: nowrap; }
        table.pf th:first-child, table.pf td:first-child { text-align: left; }
        table.pf th.sorted { color: #1565c0; }
        table.pf td { text-align: right; padding: 7px 8px; border-bottom: 1px solid #f0f0f0; white-space: nowrap; }
        table.pf tr:hover td { background: #f7fbff; }
        table.pf td.tk { font-weight: bold; color: #1565c0; }
        table.pf td.nm { max-width: 220px; overflow: hidden; text-overflow: ellipsis; color: #555; font-weight: normal; }
        table.pf tr.cash td { background: #fbfbf6; font-style: italic; }
        table.pf tr.total td { border-top: 2px solid #e0e0e0; border-bottom: none; font-weight: bold; }

        /* тепловые мини-карточки в колонке «Тикер» (палитра как на тепловой карте) */
        .mini { display: flex; justify-content: space-between; align-items: stretch; gap: 6px;
                min-width: 150px; max-width: 200px; min-height: 44px; padding: 4px 7px; border-radius: 6px;
                color: #fff; font-size: 12px; line-height: 1.25; cursor: pointer;
                transition: filter .1s ease, transform .1s ease; -webkit-tap-highlight-color: transparent; }
        .mini:hover { filter: brightness(1.12); transform: scale(1.02); }
        .mini:focus-visible { outline: 2px solid #1565c0; outline-offset: -1px; }
        .mini-left { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; overflow: hidden; }
        .mini-right { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end; text-align: right; white-space: nowrap; }
        .mini-name { font-weight: bold; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .mini-price { font-size: 11px; opacity: .95; font-variant-numeric: tabular-nums; }
        .mini-change { font-size: 12px; font-weight: bold; font-variant-numeric: tabular-nums; }
        .mini-delta { font-size: 10px; opacity: .9; font-variant-numeric: tabular-nums; }
        .bg-pos-5 { background-color: #2e7d32; }
        .bg-pos-4 { background-color: #388e3c; }
        .bg-pos-3 { background-color: #43a047; }
        .bg-pos-2 { background-color: #81c784; color: #1a1a1a; }
        .bg-pos-1 { background-color: #c8e6c9; color: #1a1a1a; }
        .bg-neg-1 { background-color: #ef9a9a; color: #1a1a1a; }
        .bg-neg-2 { background-color: #e57373; color: #1a1a1a; }
        .bg-neg-3 { background-color: #d32f2f; }
        .bg-neg-4 { background-color: #c62828; }
        .bg-neg-5 { background-color: #8e0000; }
        .bg-neutral { background-color: #9e9e9e; color: #fff; }

        /* легенда структуры портфеля */
        .legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: #555; margin: 6px 0 12px; }
        .legend .li { display: inline-flex; align-items: center; gap: 5px; }
        .legend .dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; flex: none; }

        /* модалка карточки бумаги */
        .smodal { position: fixed; inset: 0; background: rgba(0,0,0,.55); display: flex; align-items: flex-end; justify-content: center; z-index: 100; }
        .smodal[hidden] { display: none; }
        .ssheet { background: #fff; width: 100%; max-width: 560px; max-height: 92vh; overflow-y: auto; padding: 14px 16px 20px; border-radius: 14px 14px 0 0; }
        @media (min-width: 700px) { .smodal { align-items: center; } .ssheet { border-radius: 14px; } }
        .ssheet-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; background: #fff; padding-bottom: 8px; border-bottom: 1px solid #eee; }
        .ssheet-title { font-size: 17px; font-weight: bold; color: #222; }
        .ssheet-sub { font-size: 12px; color: #777; margin-top: 2px; }
        .ssheet-close { border: none; background: #f0f0f0; border-radius: 8px; width: 30px; height: 30px; font-size: 15px; cursor: pointer; color: #555; flex: none; }
        .ssheet-close:hover { background: #e4e4e4; }
        .ssec { margin-top: 12px; }
        .ssec h4 { margin: 0 0 6px; font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: .04em; }
        .srow { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; border-bottom: 1px solid #f3f3f3; font-size: 13px; }
        .srow .k { color: #666; }
        .srow .v { font-weight: 600; color: #222; text-align: right; white-space: nowrap; }
        .spos { background: #fafafa; border: 1px solid #eee; border-radius: 8px; padding: 9px 11px; font-size: 13px; display: grid; grid-template-columns: 1fr 1fr; gap: 5px 12px; margin-top: 12px; }

        /* график свечей в модалке */
        .chart-box { margin-top: 14px; }
        .chart-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 6px; }
        .chart-bar .sep { flex-basis: 100%; height: 0; }
        .chart-btn { border: 1px solid #ccc; border-radius: 6px; background: #fff; color: #333; font-size: 12px; padding: 4px 10px; cursor: pointer; }
        .chart-btn:hover { background: #f5f5f5; }
        .chart-btn.on { background: #1565c0; border-color: #1565c0; color: #fff; }
        .chart-stage { position: relative; height: 260px; border: 1px solid #e8e8e8; border-radius: 8px; overflow: hidden; touch-action: none; background: #fff; }
        .chart-stage canvas { display: block; width: 100%; height: 100%; }
        .chart-cap { font-size: 11px; color: #666; min-height: 15px; margin-top: 4px; font-variant-numeric: tabular-nums; }
        .chart-note { font-size: 11px; color: #999; margin-top: 2px; }

        .note { font-size: 12px; color: #777; line-height: 1.5; margin-top: 12px; }
        .empty { border: 2px dashed #f9a825; background: #fffde7; border-radius: 8px; padding: 14px 16px; font-size: 13px; line-height: 1.6; color: #333; }
        .empty code { background: #f0f0f0; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
        .tbl-wrap { overflow-x: auto; }

        /* ---------- мобильная адаптация ---------- */
        @media (max-width: 760px) {
            body { padding: 8px; }
            .container { padding: 10px; }
            /* на телефоне таблица не влезает: цена и % за день уже есть на мини-карточке,
               средняя/доля/P/L% доступны в карточке бумаги по тапу */
            table.pf .c-name, table.pf .c-avg, table.pf .c-price,
            table.pf .c-share, table.pf .c-plPct, table.pf .c-dailyPct { display: none; }
            table.pf { font-size: 12px; }
            table.pf td, table.pf th { padding: 5px 5px; }
            .mini { min-width: 118px; max-width: 150px; min-height: 40px; padding: 3px 6px; }
            .cards { grid-template-columns: 1fr 1fr; gap: 6px; }
            .stat { padding: 8px 9px; }
            .stat .val { font-size: 16px; }
            .legend { font-size: 11px; gap: 3px 10px; }
            .nav { font-size: 12px; gap: 5px; }
            .nav a { padding: 4px 10px; }
            .chart-stage { height: 220px; }
            .spos { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="index.html" id="stocksLink">Акции</a>
        <a href="bonds.html" id="bondsLink">Облигации</a>
        <a href="favorites.html" id="favLink">Избранное</a>
        <a href="news.html" id="newsLink">Новости</a>
        <a href="otc.html?type=ru" id="otcLink">Внебиржа</a>
        <a href="#" class="active">Портфель</a>
        <a href="#" id="logoutLink" class="logout">Выйти</a>
    </div>
    <div class="header">
        <strong>Портфель БКС</strong>
        <button id="reloadBtn" title="Перезагрузить данные">Обновить</button>
        <span id="status" class="status"></span>
    </div>
    <div id="root"></div>
    <div class="note">
        Данные выгружает GitHub Actions через БКС Trade API (токен «только для чтения») примерно каждые 30 минут
        в торговые часы и кладёт в <code>data/bcs_portfolio.json</code>. Это снимок, а не реальное время.
        Денежный остаток API отдаёт без вычета комиссии за сегодняшние сделки, поэтому может на копейки
        отличаться от приложения брокера.
    </div>
</div>

<!-- модалка расширенной информации по бумаге -->
<div id="secModal" class="smodal" hidden>
    <div class="ssheet">
        <div class="ssheet-head">
            <div>
                <div class="ssheet-title" id="smTitle"></div>
                <div class="ssheet-sub" id="smSub"></div>
            </div>
            <button class="ssheet-close" id="smClose" title="Закрыть">✕</button>
        </div>
        <div id="smBody"></div>
    </div>
</div>

<script>
'use strict';
//@import shared/core.js

const VERSION = 'v1';
const DATA_URL = 'data/bcs_portfolio.json';
const AUTO_RELOAD_MS = 5 * 60 * 1000;

const statusEl = document.getElementById('status');
const root = document.getElementById('root');
const { mk, fetchJson, fmtNum, fmtRub, fmtMoney, fmtPct, fmtSignedRub, fmtQty, humanDateTime, plClass, setStatus } = Core;

let sortKey = 'share';
let sortDir = -1;
let lastData = null;

const COLS = [
    { key: 'ticker',   label: 'Тикер' },
    { key: 'name',     label: 'Название' },
    { key: 'qty',      label: 'Кол-во' },
    { key: 'avg',      label: 'Ср. цена' },
    { key: 'price',    label: 'Цена' },
    { key: 'value',    label: 'Стоимость' },
    { key: 'share',    label: 'Доля, %' },
    { key: 'pl',       label: 'P/L, ₽' },
    { key: 'plPct',    label: 'P/L, %' },
    { key: 'dailyPct', label: 'За день, %' }
];

function positionRow(p) {
    return {
        ticker: p.ticker || '?',
        name: p.displayName || '',
        qty: p.quantity,
        avg: p.balancePrice,
        price: p.currentPrice,
        value: p.currentValueRub,
        share: p.portfolioShare,
        pl: p.unrealizedPL,
        plPct: p.unrealizedPercentPL,
        dailyPct: p.dailyPercentPL,
        currency: p.currency || 'RUB',
        type: p.instrumentType || p.upperType || ''
    };
}

/* ---------- валюты ---------- */
const CUR_SYM = { RUB: '₽', SUR: '₽', USD: '$', EUR: '€', HKD: 'HK$', CNY: '¥', GBP: '£', CHF: '₣', KZT: '₸' };
function curSym(cur) { return CUR_SYM[cur] || (cur ? String(cur) + ' ' : '₽'); }
function priceDec(v) { const a = Math.abs(v); return (a > 0 && a < 1) ? 4 : 2; }
function fmtCur(v, cur) {
    if (!Number.isFinite(v)) return '—';
    return fmtNum(v, priceDec(v)) + ' ' + curSym(cur);
}
function fmtCurSigned(v, cur) {
    if (!Number.isFinite(v)) return '—';
    return (v > 0 ? '+' : '−') + fmtNum(Math.abs(v), priceDec(v)) + ' ' + curSym(cur);
}
/* облигации котируются в процентах от номинала, а не в рублях */
function isBond(r) { return r.type === 'BONDS'; }
function fmtPrice(v, r) {
    if (!Number.isFinite(v)) return '—';
    return isBond(r) ? fmtNum(v, 2) + ' %' : fmtCur(v, r.currency);
}
function fmtPriceSigned(v, r) {
    if (!Number.isFinite(v)) return '—';
    return isBond(r) ? (v > 0 ? '+' : '−') + fmtNum(Math.abs(v), 2) + ' %' : fmtCurSigned(v, r.currency);
}

function statCard(label, valueHtml, subHtml) {
    const el = mk('div', 'stat');
    el.append(mk('div', 'lbl', label));
    const v = mk('div', 'val'); v.innerHTML = valueHtml; el.append(v);
    if (subHtml) { const s = mk('div', 'sub'); s.innerHTML = subHtml; el.append(s); }
    return el;
}

function renderSummary(d) {
    const cards = mk('div', 'cards');
    const s = d.summary || {};
    cards.append(statCard('Оценка портфеля', fmtMoney(s.currentValueRub),
        s.accountName ? String(s.accountName) : ''));
    const dRub = s.dailyChangeRub, dPct = s.dailyChangePct;
    cards.append(statCard('Изменение за день',
        `<span class="${plClass(dRub)}">${fmtSignedRub(dRub)}</span>`,
        `<span class="${plClass(dPct)}">${fmtPct(dPct)}</span>`));
    const tRub = s.totalChangeRub, tPct = s.totalChangePct;
    cards.append(statCard('За всё время',
        `<span class="${plClass(tRub)}">${fmtSignedRub(tRub)}</span>`,
        `<span class="${plClass(tPct)}">${fmtPct(tPct)}</span>`));
    const cash = (d.cash || []).filter(c => c && Number.isFinite(c.sum));
    const cashRub = cash.filter(c => c.currency === 'RUB' || c.currency === 'SUR').reduce((a, c) => a + c.sum, 0);
    const other = cash.filter(c => c.currency !== 'RUB' && c.currency !== 'SUR');
    cards.append(statCard('Свободные деньги', fmtMoney(cashRub),
        other.map(c => `${fmtNum(c.sum)} ${c.currency}`).join(' · ') || ''));
    if (s.stabilityStatus) {
        cards.append(statCard('Устойчивость счёта', String(s.stabilityStatus),
            s.marginOn ? 'Маржинальная торговля включена' : 'Без маржиналки'));
    }
    return cards;
}

const HUES = [210, 120, 30, 280, 0, 180, 330, 60, 240, 90];
function segColor(i) { return `hsl(${HUES[i % HUES.length]},55%,45%)`; }

function renderAlloc(rows) {
    const box = mk('div');
    const bar = mk('div', 'alloc');
    const withShare = rows.filter(r => Number.isFinite(r.share) && r.share > 0)
        .sort((a, b) => b.share - a.share);
    const top = withShare.slice(0, 10);
    const rest = withShare.slice(10);
    top.forEach((r, i) => {
        const seg = document.createElement('span');
        seg.style.width = r.share + '%';
        seg.style.background = segColor(i);
        seg.title = `${r.name || r.ticker}: ${fmtNum(r.share, 1)} %`;
        bar.append(seg);
    });
    if (rest.length) {
        const seg = document.createElement('span');
        const restShare = rest.reduce((a, r) => a + r.share, 0);
        seg.style.width = restShare + '%';
        seg.style.background = '#bdbdbd';
        seg.title = `Прочие (${rest.length}): ${fmtNum(restShare, 1)} %`;
        bar.append(seg);
    }
    box.append(bar);

    // легенда с цветными маркерами: название бумаги и её доля
    const legend = mk('div', 'legend');
    top.forEach((r, i) => {
        const li = mk('span', 'li');
        const dot = mk('span', 'dot'); dot.style.background = segColor(i);
        li.append(dot, mk('span', null, `${r.name || r.ticker} — ${fmtNum(r.share, 1)} %`));
        legend.append(li);
    });
    if (rest.length) {
        const li = mk('span', 'li');
        const dot = mk('span', 'dot'); dot.style.background = '#bdbdbd';
        li.append(dot, mk('span', null, `Прочие (${rest.length}) — ${fmtNum(rest.reduce((a, r) => a + r.share, 0), 1)} %`));
        legend.append(li);
    }
    box.append(legend);
    return box;
}

function compare(a, b, key) {
    const x = a[key], y = b[key];
    if (typeof x === 'string' || typeof y === 'string') return String(x).localeCompare(String(y), 'ru');
    const nx = Number.isFinite(x) ? x : -Infinity, ny = Number.isFinite(y) ? y : -Infinity;
    return nx - ny;
}

/* ---------- тепловые мини-карточки тикеров ---------- */

let miniCards = {};

/* шкала цвета — как на тепловой карте акций */
function getBgClass(change) {
    if (!Number.isFinite(change) || Math.round(change * 100) / 100 === 0) return 'bg-neutral';
    const abs = Math.abs(change);
    const level = abs >= 5 ? 5 : abs >= 2 ? 4 : abs >= 1 ? 3 : abs >= 0.5 ? 2 : 1;
    return (change > 0 ? 'bg-pos-' : 'bg-neg-') + level;
}

function buildMiniCard(r) {
    if (r.type === 'CURRENCY') return null;
    const card = mk('div', 'mini ' + getBgClass(r.dailyPct));
    card.tabIndex = 0;
    card.setAttribute('role', 'button');
    card.title = `${r.name || r.ticker} — нажмите для подробной информации`;

    const left = mk('div', 'mini-left');
    // у внебиржи БКС тикер — служебный код (O.30303M1027), показываем название бумаги
    const label = (r.ticker.startsWith('O.') && r.name) ? r.name : r.ticker;
    const nameEl = mk('div', 'mini-name', label);
    nameEl.title = `${r.name} (${r.ticker})`;
    const priceEl = mk('div', 'mini-price', fmtPrice(r.price, r));
    left.append(nameEl, priceEl);

    const right = mk('div', 'mini-right');
    const changeEl = mk('div', 'mini-change', fmtPct(r.dailyPct));
    const deltaEl = mk('div', 'mini-delta', '');
    right.append(changeEl, deltaEl);
    card.append(left, right);

    // клик раскрывает карточку бумаги прямо здесь, в разделе «Портфель»
    const open = () => openSecurityModal(r);
    card.addEventListener('click', open);
    card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });
    miniCards[r.ticker] = { card, priceEl, changeEl, deltaEl, row: r };
    return card;
}

/* БКС отдаёт dailyPL = 0 вне сессии — дотягиваем живое изменение за день с MOEX ISS
   (только биржевые бумаги: акции TQBR, облигации TQRD; внебиржа БКС на ISS отсутствует). */
async function enrichFromMoex(rows) {
    const groups = [
        ['shares', 'TQBR', rows.filter(r => r.type === 'STOCK').map(r => r.ticker)],
        ['bonds', 'TQRD', rows.filter(r => r.type === 'BONDS').map(r => r.ticker)]
    ];
    for (const [market, board, tickers] of groups) {
        if (!tickers.length) continue;
        try {
            const url = `https://iss.moex.com/iss/engines/stock/markets/${market}/boards/${board}/securities.json` +
                `?iss.meta=off&iss.only=securities,marketdata` +
                `&securities.columns=SECID,PREVPRICE` +
                `&marketdata.columns=SECID,LAST,CHANGE,LASTTOPREVPRICE` +
                `&securities=${tickers.map(encodeURIComponent).join(',')}`;
            const data = await Core.fetchJson(url, { retries: 1, timeout: 10000 });
            const si = Object.fromEntries(data.securities.columns.map((c, i) => [c, i]));
            const mi = Object.fromEntries(data.marketdata.columns.map((c, i) => [c, i]));
            const prevByTicker = {};
            for (const s of data.securities.data || []) prevByTicker[s[si.SECID]] = s[si.PREVPRICE];
            for (const md of data.marketdata.data || []) {
                const ticker = md[mi.SECID];
                const els = miniCards[ticker];
                if (!els) continue;
                const price = md[mi.LAST], delta = md[mi.CHANGE];
                let pct = md[mi.LASTTOPREVPRICE];
                // LASTTOPREVPRICE бывает 0 при нуле сделок — считаем от PREVPRICE, если есть LAST
                const prev = prevByTicker[ticker];
                if ((!Number.isFinite(pct) || pct === 0) && Number.isFinite(price) && Number.isFinite(prev) && prev)
                    pct = (price - prev) / prev * 100;
                if (Number.isFinite(price)) els.priceEl.textContent = fmtPrice(price, els.row);
                els.changeEl.textContent = Number.isFinite(pct) ? fmtPct(pct) : '—';
                els.deltaEl.textContent = Number.isFinite(delta) && delta !== 0
                    ? (delta > 0 ? '+' : '−') + fmtNum(Math.abs(delta), priceDec(delta)) : '';
                els.card.className = 'mini ' + getBgClass(pct);
                // колонка «За день, %» в таблице — БКС отдаёт нули, тянем отсюда же
                if (els.dailyTd && Number.isFinite(pct)) {
                    els.dailyTd.textContent = fmtPct(pct);
                    els.dailyTd.className = 'c-dailyPct ' + plClass(pct);
                }
            }
        } catch (e) { /* ISS недоступен — карточки остаются нейтральными */ }
    }
}

/* ---------- расширенная карточка бумаги (модалка прямо в разделе «Портфель») ---------- */
const smodal = document.getElementById('secModal');
const smBody = document.getElementById('smBody');

document.getElementById('smClose').addEventListener('click', closeSecModal);
smodal.addEventListener('click', e => { if (e.target === smodal) closeSecModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !smodal.hidden) closeSecModal(); });

function closeSecModal() {
    smodal.hidden = true;
    document.body.style.overflow = '';
}

function srow(k, vHtml) {
    const d = mk('div', 'srow');
    d.append(mk('span', 'k', k));
    const v = mk('span', 'v'); v.innerHTML = vHtml; d.append(v);
    return d;
}

function marketOf(r) {
    if (r.type === 'STOCK') return ['shares', 'TQBR'];
    if (r.type === 'BONDS') return ['bonds', 'TQRD'];
    return null;
}

async function fetchSecLive(r) {
    const mb = marketOf(r); if (!mb) return null;
    const [market, board] = mb;
    const url = `https://iss.moex.com/iss/engines/stock/markets/${market}/boards/${board}/securities/${encodeURIComponent(r.ticker)}.json` +
        '?iss.meta=off&iss.only=securities,marketdata' +
        '&securities.columns=SECID,SHORTNAME,PREVPRICE,LOTSIZE,FACEVALUE,ISIN' +
        '&marketdata.columns=SECID,LAST,CHANGE,OPEN,LOW,HIGH,VOLTODAY,NUMTRADES,LASTTOPREVPRICE,SYSTIME';
    const data = await Core.fetchJson(url, { retries: 1, timeout: 12000 });
    const si = Object.fromEntries(data.securities.columns.map((c, i) => [c, i]));
    const mi = Object.fromEntries(data.marketdata.columns.map((c, i) => [c, i]));
    const s = (data.securities.data || [])[0], m = (data.marketdata.data || [])[0];
    if (!s) return null;
    const gs = k => s[si[k]], gm = k => (m ? m[mi[k]] : null);
    return {
        name: gs('SHORTNAME'), prev: gs('PREVPRICE'), lot: gs('LOTSIZE'),
        face: gs('FACEVALUE'), isin: gs('ISIN'),
        last: gm('LAST'), change: gm('CHANGE'), open: gm('OPEN'), low: gm('LOW'),
        high: gm('HIGH'), vol: gm('VOLTODAY'), trades: gm('NUMTRADES'),
        pct: gm('LASTTOPREVPRICE'), time: gm('SYSTIME')
    };
}

/* месячные свечи за всю историю — исторические мин/макс; дневная история — неделя/месяц */
async function fetchSecHistory(r) {
    const mb = marketOf(r); if (!mb) return null;
    const [market, board] = mb;
    const t = encodeURIComponent(r.ticker);
    const candlesBase = `https://iss.moex.com/iss/engines/stock/markets/${market}/boards/${board}/securities/${t}`;
    const histBase = `https://iss.moex.com/iss/history/engines/stock/markets/${market}/boards/${board}/securities/${t}`;
    let hi = null, lo = null;
    for (let start = 0; start < 800; start += 100) {
        const data = await Core.fetchJson(
            `${candlesBase}/candles.json?from=2000-01-01&interval=31&start=${start}&iss.meta=off&iss.only=candles&candles.columns=begin,high,low`,
            { retries: 0, timeout: 12000 });
        const idx = Object.fromEntries(data.candles.columns.map((c, i) => [c, i]));
        const rows = data.candles.data || [];
        for (const c of rows) {
            const h = c[idx.high], l = c[idx.low], d = String(c[idx.begin]).slice(0, 10);
            if (Number.isFinite(h) && (!hi || h > hi.v)) hi = { v: h, d };
            if (Number.isFinite(l) && l > 0 && (!lo || l < lo.v)) lo = { v: l, d };
        }
        if (rows.length < 100) break;
    }
    const out = { hi, lo, weekClose: null, monthClose: null };
    try {
        const from = new Date(Date.now() - 45 * 864e5).toISOString().slice(0, 10);
        const data = await Core.fetchJson(
            `${histBase}.json?from=${from}&iss.meta=off&iss.only=history&history.columns=TRADEDATE,CLOSE`,
            { retries: 0, timeout: 12000 });
        const idx = Object.fromEntries(data.history.columns.map((c, i) => [c, i]));
        const d7 = new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 10);
        const d30 = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
        for (const x of data.history.data || []) {
            const dt = x[idx.TRADEDATE], cl = x[idx.CLOSE];
            if (!Number.isFinite(cl)) continue;
            if (dt <= d7) out.weekClose = cl;
            if (dt <= d30) out.monthClose = cl;
        }
    } catch (e) { /* история не критична */ }
    return out;
}

async function openSecurityModal(r) {
    smodal.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('smTitle').textContent = r.name ? `${r.name} (${r.ticker})` : r.ticker;
    const typeLabel = r.type === 'STOCK' ? 'Акция' : r.type === 'BONDS' ? 'Облигация' : 'Внебиржевой инструмент БКС';
    document.getElementById('smSub').textContent = typeLabel;
    smBody.replaceChildren();

    // позиция из портфеля (снимок БКС)
    const pos = mk('div', 'spos');
    const plCell = mk('div');
    plCell.innerHTML = `P/L: <span class="${plClass(r.pl)}">${fmtSignedRub(r.pl)} (${fmtPct(r.plPct)})</span>`;
    pos.append(
        mk('div', null, `Кол-во: ${fmtQty(r.qty)}`),
        mk('div', null, `Средняя: ${fmtPrice(r.avg, r)}`),
        mk('div', null, `Стоимость: ${fmtRub(r.value, 2)}`),
        plCell
    );
    const liveBox = mk('div');
    liveBox.append(mk('div', 'note', 'Загружаю данные MOEX…'));
    smBody.append(pos, liveBox);

    let live = null, hist = null;
    try { live = await fetchSecLive(r); } catch (e) { }
    try { hist = await fetchSecHistory(r); } catch (e) { }
    liveBox.replaceChildren();

    document.getElementById('smSub').textContent = typeLabel +
        (live && live.isin ? ' · ISIN ' + live.isin : '') +
        (isBond(r) ? ' · цена в % от номинала' : '') +
        (!live && !marketOf(r) ? ' · на MOEX не торгуется' : '');

    if (!live) {
        liveBox.append(mk('div', 'note',
            'Биржевые данные MOEX по этому инструменту недоступны — это внебиржевая бумага БКС, ' +
            'по ней есть только снимок из портфеля выше.'));
        return;
    }

    
    const price = Number.isFinite(live.last) ? live.last : live.prev;
    let pct = Number.isFinite(live.pct) && live.pct !== 0 ? live.pct : null;
    if (pct === null && Number.isFinite(price) && Number.isFinite(live.prev) && live.prev)
        pct = (price - live.prev) / live.prev * 100;
    const delta = Number.isFinite(live.change) && live.change !== 0 ? live.change
        : (Number.isFinite(price) && Number.isFinite(live.prev) ? price - live.prev : null);
    const pctVs = base => (Number.isFinite(price) && Number.isFinite(base) && base)
        ? (price - base) / base * 100 : null;
    // мин/макс считаются по месячным свечам — честно подписываем месяц, а не «первое число»
    const MONTHS = ['январь', 'февраль', 'март', 'апрель', 'май', 'июнь',
        'июль', 'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь'];
    const fmtMonth = d => {
        const [y, m] = String(d).split('-');
        return `${MONTHS[Math.max(1, Math.min(12, +m)) - 1]} ${y}`;
    };

    const sec = mk('div', 'ssec');
    sec.append(mk('h4', null, 'Сегодня' + (live.time ? ' · ' + String(live.time).slice(11, 16) + ' МСК' : '')));
    sec.append(srow('Цена сейчас', fmtPrice(price, r)));
    let chHtml = `<span class="${plClass(pct)}">${fmtPct(pct)}</span>`;
    if (Number.isFinite(delta) && delta !== 0) chHtml += ` · <span class="${plClass(delta)}">${fmtPriceSigned(delta, r)}</span>`;
    sec.append(srow('Изменение за день', chHtml));
    if (Number.isFinite(live.open)) sec.append(srow('Цена открытия', fmtPrice(live.open, r)));
    if (Number.isFinite(live.prev)) sec.append(srow('Закрытие предыдущего дня', fmtPrice(live.prev, r)));
    if (Number.isFinite(live.low) && Number.isFinite(live.high))
        sec.append(srow('Мин / макс за день', `${fmtPrice(live.low, r)} — ${fmtPrice(live.high, r)}`));
    if (Number.isFinite(live.vol) && live.vol > 0) sec.append(srow('Объём, шт', fmtQty(live.vol)));
    if (Number.isFinite(live.trades) && live.trades > 0) sec.append(srow('Сделок', fmtQty(live.trades)));
    if (Number.isFinite(live.lot)) sec.append(srow('Размер лота', fmtQty(live.lot)));
    if (r.type === 'BONDS' && Number.isFinite(live.face)) sec.append(srow('Номинал', fmtNum(live.face, 2) + ' ₽'));
    if (hist) {
        const w = pctVs(hist.weekClose), m = pctVs(hist.monthClose);
        if (w !== null) sec.append(srow('Изменение за неделю', `<span class="${plClass(w)}">${fmtPct(w)}</span>`));
        if (m !== null) sec.append(srow('Изменение за месяц', `<span class="${plClass(m)}">${fmtPct(m)}</span>`));
    }
    liveBox.append(sec);

    if (hist && (hist.hi || hist.lo)) {
        const hsec = mk('div', 'ssec');
        hsec.append(mk('h4', null, 'Исторические минимум и максимум'));
        if (hist.lo) hsec.append(srow('Минимум за всё время',
            `${fmtPrice(hist.lo.v, r)} <span style="color:#888">(${fmtMonth(hist.lo.d)})</span>`));
        if (hist.hi) hsec.append(srow('Максимум за всё время',
            `${fmtPrice(hist.hi.v, r)} <span style="color:#888">(${fmtMonth(hist.hi.d)})</span>`));
        if (hist.lo && hist.hi && Number.isFinite(price)) {
            hsec.append(srow('Отступ от минимума', `<span class="pos">+${fmtNum((price / hist.lo.v - 1) * 100, 1)} %</span>`));
            hsec.append(srow('Отступ от максимума', `<span class="neg">${fmtNum((price / hist.hi.v - 1) * 100, 1)} %</span>`));
        }
        liveBox.append(hsec);
    }

    // график свечей — грузим в фоне, чтобы модалка открывалась мгновенно
    if (marketOf(r)) liveBox.append(createChartSection(r));
}

/* ---------- график свечей (как в разделе «Акции», компактная версия) ---------- */
/* ISS умеет свечи 1 / 10 / 60 мин, день, неделя, месяц; 5м и 15м собираем из минутных. */
const CHART_TF = [
    { key: '1m',  label: '1м',     kind: 'intra',  agg: 1,  days: 1 },
    { key: '5m',  label: '5м',     kind: 'intra',  agg: 5,  days: 2 },
    { key: '15m', label: '15м',    kind: 'intra',  agg: 15, days: 3 },
    { key: '1h',  label: '1ч',     kind: 'native', interval: 60, days: 30 },
    { key: '1d',  label: 'День',   kind: 'native', interval: 24, days: 1100 },
    { key: '1w',  label: 'Неделя', kind: 'native', interval: 7,  days: 3650 },
    { key: '1M',  label: 'Месяц',  kind: 'native', interval: 31, days: 20000 }
];
const CHART_VISIBLE = { '1m': 120, '5m': 90, '15m': 80, '1h': 80, '1d': 90, '1w': 104, '1M': 60 };

function mskToday() {
    return new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Moscow' }).format(new Date());
}
function shiftDays(dateStr, days) {
    const d = new Date(dateStr + 'T12:00:00Z');
    d.setUTCDate(d.getUTCDate() + days);
    return d.toISOString().slice(0, 10);
}

async function fetchCandlePages(base, query) {
    const out = [];
    let start = 0;
    for (let page = 0; page < 14; page++) {
        const url = `${base}/candles.json?${query}&start=${start}&iss.meta=off&iss.only=candles` +
            '&candles.columns=begin,open,close,high,low,value,volume';
        const data = await Core.fetchJson(url, { retries: 1, timeout: 15000 });
        const c = data.candles;
        if (!c || !Array.isArray(c.data)) break;
        const idx = Object.fromEntries(c.columns.map((x, i) => [x, i]));
        for (const row of c.data) {
            const o = row[idx.open], cl = row[idx.close], h = row[idx.high], l = row[idx.low];
            if (![o, cl, h, l].every(Number.isFinite)) continue;
            out.push({ t: String(row[idx.begin]).replace('T', ' '), o, c: cl, h, l,
                v: row[idx.volume] || 0, val: row[idx.value] || 0 });
        }
        if (c.data.length < 500) break; // ISS отдаёт максимум 500 свечей за запрос
        start += c.data.length;
    }
    return out;
}

function aggregateCandles(rows, agg) {
    const out = [];
    let cur = null, curKey = null;
    for (const r of rows) {
        const day = r.t.slice(0, 10);
        const mins = Number(r.t.slice(11, 13)) * 60 + Number(r.t.slice(14, 16));
        const key = `${day}#${Math.floor(mins / agg)}`;
        if (key !== curKey) {
            const bm = Math.floor(mins / agg) * agg;
            const hh = String(Math.floor(bm / 60)).padStart(2, '0');
            const mm = String(bm % 60).padStart(2, '0');
            cur = { t: `${day} ${hh}:${mm}:00`, o: r.o, c: r.c, h: r.h, l: r.l, v: r.v, val: r.val };
            out.push(cur);
            curKey = key;
        } else {
            cur.h = Math.max(cur.h, r.h);
            cur.l = Math.min(cur.l, r.l);
            cur.c = r.c;
            cur.v += r.v;
            cur.val += r.val;
        }
    }
    return out;
}

async function loadChartData(r, tf) {
    const [market, board] = marketOf(r);
    const base = `https://iss.moex.com/iss/engines/stock/markets/${market}/boards/${board}/securities/${encodeURIComponent(r.ticker)}`;
    const today = mskToday();
    const enc = encodeURIComponent;

    if (tf.kind === 'intra') {
        const chunks = [];
        let found = 0;
        for (let i = 0; i < 10 && found < tf.days; i++) {
            const d = shiftDays(today, -i);
            const rows = await fetchCandlePages(base, `interval=1&from=${enc(d + ' 00:00:00')}&till=${enc(d + ' 23:59:59')}`);
            if (rows.length) { chunks.unshift(rows); found++; }
        }
        let rows = chunks.flat();
        if (tf.agg > 1) rows = aggregateCandles(rows, tf.agg);
        const what = tf.agg > 1 ? `Свечи ${tf.agg} мин собраны из минутных` : 'Минутные свечи';
        return { candles: rows, note: `${what}: ${found} торг. дн. (последние). Время московское.` };
    }
    const from = shiftDays(today, -tf.days);
    const rows = await fetchCandlePages(base, `interval=${tf.interval}&from=${from}&till=${enc(today + ' 23:59:59')}`);
    const span = tf.key === '1h' ? '30 дней' : tf.key === '1d' ? '~3 года' : tf.key === '1w' ? '~10 лет' : 'вся история';
    return { candles: rows, note: `Свечи MOEX (${span}). Время московское.` };
}

function createChartSection(r) {
    const box = mk('div', 'chart-box');
    box.append(mk('h4', null, 'График'));
    const bar = mk('div', 'chart-bar');
    const stage = mk('div', 'chart-stage');
    const canvas = document.createElement('canvas');
    stage.append(canvas);
    const cap = mk('div', 'chart-cap', '');
    const note = mk('div', 'chart-note', 'Загружаю свечи…');
    box.append(bar, stage, cap, note);

    const UP = '#2e7d32', DOWN = '#c62828';
    let data = [], tfKey = '1d', mode = 'candles';
    let visible = CHART_VISIBLE['1d'], end = 0; // end — индекс ПОСЛЕДНЕЙ видимой свечи
    let hover = -1, drag = null;

    const tfButtons = {};
    CHART_TF.forEach(tf => {
        const b = mk('button', 'chart-btn' + (tf.key === tfKey ? ' on' : ''), tf.label);
        b.addEventListener('click', () => load(tf.key));
        tfButtons[tf.key] = b;
        bar.append(b);
    });
    const modeBtn = mk('button', 'chart-btn', 'Свечи');
    modeBtn.addEventListener('click', () => {
        mode = mode === 'candles' ? 'line' : 'candles';
        modeBtn.textContent = mode === 'candles' ? 'Свечи' : 'Линия';
        draw();
    });
    const zoomOut = mk('button', 'chart-btn', '−');
    const zoomIn = mk('button', 'chart-btn', '+');
    const resetBtn = mk('button', 'chart-btn', '⟲');
    zoomOut.title = 'Отдалить'; zoomIn.title = 'Приблизить'; resetBtn.title = 'Сбросить масштаб';
    zoomOut.addEventListener('click', () => { visible = Math.min(data.length + 6, Math.round(visible * 1.3)); clampView(); draw(); });
    zoomIn.addEventListener('click', () => { visible = Math.max(8, Math.round(visible / 1.3)); clampView(); draw(); });
    resetBtn.addEventListener('click', () => { visible = CHART_VISIBLE[tfKey] || 90; end = data.length; clampView(); draw(); });
    bar.append(modeBtn, zoomOut, zoomIn, resetBtn);

    function clampView() {
        visible = Math.max(8, Math.min(visible, data.length + 6));
        end = Math.max(visible, Math.min(end, data.length));
        if (end < 1) end = data.length;
    }

    function dims() {
        const dpr = window.devicePixelRatio || 1;
        const w = stage.clientWidth || 320, h = stage.clientHeight || 240;
        // размер канвы задаём явно и в style — надёжнее, чем CSS 100% (был глюк с половинной шириной)
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        const pw = Math.round(w * dpr), ph = Math.round(h * dpr);
        if (canvas.width !== pw || canvas.height !== ph) { canvas.width = pw; canvas.height = ph; }
        return { w, h, dpr };
    }

    function fmtAxis(v) {
        const a = Math.abs(v);
        const dec = a >= 1000 ? 0 : a >= 1 ? 2 : 4;
        return fmtNum(v, dec);
    }
    function fmtAxisDate(t, intraday) {
        return intraday ? t.slice(11, 16) : t.slice(8, 10) + '.' + t.slice(5, 7) + '.' + t.slice(2, 4);
    }

    function draw() {
        const { w, h, dpr } = dims();
        const ctx = canvas.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        if (!data.length) return;
        clampView();
        const view = data.slice(Math.max(0, end - visible), end);
        if (!view.length) return;

        const padR = 52, padL = 4, padT = 8, padB = 16;
        const plotW = w - padL - padR;
        const priceH = Math.round((h - padT - padB) * 0.74);
        const volTop = padT + priceH + 6;
        const volH = h - padB - volTop;

        let mn = Infinity, mx = -Infinity, mxV = 0;
        view.forEach(c => { mn = Math.min(mn, c.l); mx = Math.max(mx, c.h); mxV = Math.max(mxV, c.v || 0); });
        if (!(mx > mn)) { mx = mn + Math.abs(mn || 1) * 0.01; }
        const pad = (mx - mn) * 0.06;
        mn -= pad; mx += pad;
        const X = i => padL + (i + 0.5) * plotW / view.length;
        const Y = v => padT + (mx - v) / (mx - mn) * priceH;
        const intraday = tfKey === '1m' || tfKey === '5m' || tfKey === '15m' || tfKey === '1h';

        // сетка и подписи цен
        ctx.strokeStyle = '#eee'; ctx.fillStyle = '#999'; ctx.font = '10px Arial';
        ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
        for (let g = 0; g <= 4; g++) {
            const v = mn + (mx - mn) * g / 4;
            const y = Y(v);
            ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); ctx.stroke();
            ctx.fillText(fmtAxis(v), w - padR + 5, y);
        }
        // даты
        ctx.textAlign = 'center'; ctx.textBaseline = 'top';
        const ticks = Math.min(4, view.length);
        for (let g = 0; g < ticks; g++) {
            const i = Math.round((view.length - 1) * g / (ticks - 1 || 1));
            ctx.fillText(fmtAxisDate(view[i].t, intraday), X(i), h - padB + 4);
        }

        // объёмы
        if (mxV > 0) {
            const bw = Math.min(24, Math.max(1, plotW / view.length * 0.62));
            view.forEach((c, i) => {
                ctx.fillStyle = c.c >= c.o ? 'rgba(46,125,50,.35)' : 'rgba(198,40,40,.35)';
                const vh = (c.v || 0) / mxV * volH;
                ctx.fillRect(X(i) - bw / 2, volTop + volH - vh, bw, vh);
            });
        }

        // свечи или линия
        const bw = Math.min(24, Math.max(1, plotW / view.length * 0.62));
        if (mode === 'candles') {
            view.forEach((c, i) => {
                const up = c.c >= c.o;
                ctx.strokeStyle = up ? UP : DOWN;
                ctx.fillStyle = up ? UP : DOWN;
                const x = X(i);
                ctx.beginPath(); ctx.moveTo(x, Y(c.h)); ctx.lineTo(x, Y(c.l)); ctx.stroke();
                const y1 = Y(Math.max(c.o, c.c)), y2 = Y(Math.min(c.o, c.c));
                ctx.fillRect(x - bw / 2, y1, bw, Math.max(1, y2 - y1));
            });
        } else {
            ctx.strokeStyle = '#1565c0'; ctx.lineWidth = 1.6;
            ctx.beginPath();
            view.forEach((c, i) => { const x = X(i), y = Y(c.c); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); });
            ctx.stroke();
            ctx.lineWidth = 1;
        }

        // последняя цена
        const last = view[view.length - 1];
        const ly = Y(last.c);
        if (ly >= padT && ly <= padT + priceH) {
            ctx.strokeStyle = last.c >= last.o ? UP : DOWN;
            ctx.setLineDash([4, 3]);
            ctx.beginPath(); ctx.moveTo(padL, ly); ctx.lineTo(w - padR, ly); ctx.stroke();
            ctx.setLineDash([]);
            ctx.fillStyle = last.c >= last.o ? UP : DOWN;
            const label = fmtAxis(last.c);
            const lw = ctx.measureText(label).width + 8;
            ctx.fillRect(w - padR + 1, ly - 8, Math.max(lw, padR - 3), 15);
            ctx.fillStyle = '#fff';
            ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
            ctx.fillText(label, w - padR + 5, ly);
        }

        // кроссхаир
        if (hover >= 0 && hover < view.length) {
            const c = view[hover];
            const x = X(hover);
            ctx.strokeStyle = 'rgba(0,0,0,.35)';
            ctx.setLineDash([3, 3]);
            ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, h - padB); ctx.stroke();
            ctx.setLineDash([]);
            cap.textContent = `${c.t.slice(0, 16)} · О ${fmtAxis(c.o)} · Макс ${fmtAxis(c.h)} · Мин ${fmtAxis(c.l)} · З ${fmtAxis(c.c)}` +
                (c.v ? ` · Об ${fmtQty(c.v)}` : '');
        }
    }

    function hoverFromEvent(e) {
        const rect = stage.getBoundingClientRect();
        const x = e.clientX - rect.left - 4;
        const plotW = rect.width - 4 - 52;
        const i = Math.floor(x / plotW * Math.min(visible, data.length));
        hover = (i >= 0 && i < Math.min(visible, data.length)) ? i : -1;
    }

    stage.addEventListener('pointerdown', e => {
        drag = { x: e.clientX, end };
        stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', e => {
        if (drag) {
            const rect = stage.getBoundingClientRect();
            const perPx = visible / (rect.width - 56);
            end = drag.end + Math.round((drag.x - e.clientX) * perPx);
            clampView();
            hover = -1;
        } else {
            hoverFromEvent(e);
        }
        draw();
    });
    stage.addEventListener('pointerup', () => { drag = null; });
    window.addEventListener('resize', draw);
    stage.addEventListener('pointerleave', () => { if (!drag) { hover = -1; cap.textContent = ''; draw(); } });
    stage.addEventListener('wheel', e => {
        e.preventDefault();
        visible = Math.max(8, Math.min(data.length + 6, Math.round(visible * (e.deltaY > 0 ? 1.2 : 1 / 1.2))));
        clampView(); draw();
    }, { passive: false });

    let loadSeq = 0;
    async function load(key) {
        tfKey = key;
        Object.values(tfButtons).forEach(b => b.classList.remove('on'));
        tfButtons[key].classList.add('on');
        const tf = CHART_TF.find(t => t.key === key);
        const seq = ++loadSeq;
        note.textContent = 'Загружаю свечи…';
        try {
            const res = await loadChartData(r, tf);
            if (seq !== loadSeq) return; // юзер уже переключил таймфрейм
            data = res.candles;
            visible = CHART_VISIBLE[key] || 90;
            end = data.length;
            hover = -1;
            note.textContent = data.length
                ? `${res.note} Свечей: ${data.length}. Колесо — масштаб, перетаскивание — сдвиг, наведение — подробности.`
                : 'Свечей нет — по бумаге сегодня не было сделок либо история недоступна.';
            draw();
        } catch (e) {
            if (seq !== loadSeq) return;
            note.textContent = 'Не удалось загрузить свечи: ' + String(e.message || e);
        }
    }

    load('1d');
    return box;
}

function renderTable(rows) {
    miniCards = {};
    const table = mk('table', 'pf');
    const head = mk('tr');
    COLS.forEach(c => {
        const cls = `c-${c.key}` + (c.key === sortKey ? ' sorted' : '');
        const th = mk('th', cls, c.label + (c.key === sortKey ? (sortDir < 0 ? ' ↓' : ' ↑') : ''));
        th.addEventListener('click', () => {
            if (sortKey === c.key) sortDir = -sortDir; else { sortKey = c.key; sortDir = -1; }
            render(lastData);
        });
        head.append(th);
    });
    table.append(head);

    const sorted = rows.slice().sort((a, b) => sortDir * compare(a, b, sortKey));
    let totVal = 0, totPl = 0;
    sorted.forEach(r => {
        if (Number.isFinite(r.value)) totVal += r.value;
        if (Number.isFinite(r.pl)) totPl += r.pl;
        const isCur = r.type === 'CURRENCY'; // деньгам — копейки, а не округление
        const tr = mk('tr');
        const tkTd = mk('td', 'tk c-ticker');
        const mini = buildMiniCard(r);
        if (mini) tkTd.append(mini); else tkTd.textContent = r.ticker;
        tr.append(tkTd);
        tr.append(mk('td', 'nm c-name', r.name));
        tr.append(mk('td', 'c-qty', isCur ? fmtNum(r.qty, 2) : fmtQty(r.qty)));
        tr.append(mk('td', 'c-avg', isCur ? fmtNum(r.avg, 2) : fmtPrice(r.avg, r)));
        tr.append(mk('td', 'c-price', isCur ? fmtNum(r.price, 2) : fmtPrice(r.price, r)));
        tr.append(mk('td', 'c-value', fmtRub(r.value, isCur ? 2 : 0)));
        tr.append(mk('td', 'c-share', fmtNum(r.share, 1)));
        tr.append(mk('td', 'c-pl ' + plClass(r.pl), fmtSignedRub(r.pl)));
        tr.append(mk('td', 'c-plPct ' + plClass(r.plPct), fmtPct(r.plPct)));
        const dailyTd = mk('td', 'c-dailyPct ' + plClass(r.dailyPct), fmtPct(r.dailyPct));
        tr.append(dailyTd);
        const els = miniCards[r.ticker];
        if (els) els.dailyTd = dailyTd;
        table.append(tr);
    });

    if (sorted.length) {
        const tr = mk('tr', 'total');
        tr.append(mk('td', 'c-ticker', 'Итого'));
        tr.append(mk('td', 'c-name'));
        tr.append(mk('td', 'c-qty')); tr.append(mk('td', 'c-avg')); tr.append(mk('td', 'c-price'));
        tr.append(mk('td', 'c-value', fmtRub(totVal, 0)));
        tr.append(mk('td', 'c-share', '100'));
        tr.append(mk('td', 'c-pl ' + plClass(totPl), fmtSignedRub(totPl)));
        tr.append(mk('td', 'c-plPct')); tr.append(mk('td', 'c-dailyPct'));
        table.append(tr);
    }
    const wrap = mk('div', 'tbl-wrap');
    wrap.append(table);
    return wrap;
}

function renderEmpty(err) {
    const box = mk('div', 'empty');
    box.innerHTML =
        '<b>Данные портфеля пока не выгружены.</b><br>' +
        (err ? `Ошибка загрузки: ${String(err.message || err)}.<br>` : '') +
        'Чтобы страница ожила:<br>' +
        '1. Выпустите в «БКС Мир инвестиций» токен API <b>«только для чтения»</b> (Профиль → счёт → Токены API).<br>' +
        '2. Добавьте его в секреты репозитория: Settings → Secrets and variables → Actions → <code>BCS_API_KEY_READ</code>.<br>' +
        '3. Запустите workflow <b>BCS API</b> вручную (Actions → BCS API → Run workflow) или дождитесь расписания.<br>' +
        '4. Для автообновления токена при ротации добавьте секрет <code>GH_PAT</code> (personal access token с правом на изменение секретов репозитория).<br>' +
        '5. Чтобы данные портфеля не лежали в открытом виде, добавьте секреты <code>MX_LOGIN</code> и <code>MX_PASSWORD</code> ' +
        '(те же, что у страниц) — workflow будет шифровать JSON, а страница расшифрует его после входа.';
    return box;
}

function render(d) {
    lastData = d;
    root.replaceChildren();
    if (!d || !Array.isArray(d.positions)) { root.append(renderEmpty(null)); return; }
    root.append(renderSummary(d));
    const rows = d.positions.map(positionRow);
    if (!rows.length && !(d.cash || []).length) { root.append(renderEmpty(null)); return; }
    root.append(renderAlloc(rows));
    root.append(renderTable(rows));
    enrichFromMoex(rows); // подкрасит мини-карточки живым изменением за день
    if (Number.isFinite(d.tokenExpiresInDays)) {
        const note = mk('div', 'note');
        const cls = d.tokenExpiresInDays < 10 ? 'neg' : '';
        note.innerHTML =
            `Refresh-токен БКС протухнет примерно через <span class="${cls}">${d.tokenExpiresInDays} дн.</span> — ` +
            'перевыпустите его в личном кабинете и обновите секрет <code>BCS_API_KEY_READ</code>.';
        root.append(note);
    }
}

/* Данные могут быть зашифрованы тем же ключом, что и страницы (AES-256-GCM,
   ключ от пароля уже лежит в sessionStorage после входа). Открытый JSON тоже поддерживаем. */
function fromB64(s) { const b = atob(s), a = new Uint8Array(b.length); for (let i = 0; i < b.length; i++) a[i] = b.charCodeAt(i); return a; }

async function fetchPortfolioData(manual) {
    const r = await Core.fetchWithTimeout(`${DATA_URL}?t=${Date.now()}`, { timeout: 12000 });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const text = (await r.text()).trim();
    if (text.startsWith('{')) return JSON.parse(text); // открытый JSON (шифрование выключено)

    const keyB64 = sessionStorage.getItem('mx_k');
    if (!keyB64) throw new Error('данные зашифрованы — выйдите и войдите под своим паролем ещё раз');
    const key = await crypto.subtle.importKey('raw', fromB64(keyB64), 'AES-GCM', false, ['decrypt']);
    const bytes = fromB64(text.replace(/\s+/g, ''));
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes.slice(0, 12) }, key, bytes.slice(12));
    return JSON.parse(new TextDecoder().decode(plain));
}

async function load(manual) {
    setStatus(statusEl, 'loading', 'Загрузка данных портфеля...');
    try {
        let d = null, lastErr = null;
        for (let i = 0; i <= (manual ? 1 : 2); i++) {
            try { d = await fetchPortfolioData(manual); break; }
            catch (e) { lastErr = e; if (i < 2) await new Promise(res => setTimeout(res, 800 * (i + 1))); }
        }
        if (!d) throw lastErr;
        render(d);
        setStatus(statusEl, 'ok', `Обновлено: ${humanDateTime(d.updated)} · ${VERSION}`);
    } catch (e) {
        root.replaceChildren(renderEmpty(e));
        setStatus(statusEl, 'error', 'Нет данных: ' + (e.message || e));
    }
}

document.getElementById('reloadBtn').addEventListener('click', () => load(true));
document.getElementById('logoutLink').addEventListener('click', e => {
    e.preventDefault();
    try { new BroadcastChannel('mx_auth').postMessage({ t: 'logout' }); } catch (_) { /* ignore */ }
    try { sessionStorage.removeItem('mx_k'); } catch (_) { /* ignore */ }
    location.reload();
});

load(false);
setInterval(() => load(false), AUTO_RELOAD_MS);
</script>
</body>
</html>
