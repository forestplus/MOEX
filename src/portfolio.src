<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Портфель БКС — аналитика</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; background: #f0f0f0; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .container { width: 100%; max-width: 1200px; background: #fff; padding: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.1); }
        .nav { display: flex; gap: 8px; margin-bottom: 10px; font-size: 14px; flex-wrap: wrap; }
        .nav a { padding: 4px 14px; border: 1px solid #ccc; border-radius: 16px; color: #333; text-decoration: none; background: #fff; }
        .nav a.active { background: #2e7d32; color: #fff; border-color: #2e7d32; }
        .nav a.logout { margin-left: auto; color: #777; }
        .header { display: flex; align-items: center; margin-bottom: 10px; font-size: 14px; color: #333; flex-wrap: wrap; gap: 10px; }
        .header button { padding: 4px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; background: #fff; cursor: pointer; }
        .header button:hover { background: #f5f5f5; }
        .status { font-size: 12px; color: #666; }
        .status.error { color: #c00; font-weight: bold; }
        .status.ok { color: #2e7d32; }
        .status.loading { color: #f57c00; }

        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px; margin-bottom: 12px; }
        .stat { border: 1px solid #eee; border-radius: 8px; padding: 10px 12px; background: #fafafa; }
        .stat .lbl { font-size: 11px; color: #777; margin-bottom: 4px; }
        .stat .val { font-size: 18px; font-weight: bold; color: #222; }
        .stat .sub { font-size: 12px; margin-top: 2px; }
        .pos { color: #2e7d32; font-weight: bold; }
        .neg { color: #c62828; font-weight: bold; }

        .alloc { display: flex; height: 14px; border-radius: 7px; overflow: hidden; background: #eee; margin: 4px 0 2px; }
        .alloc span { display: block; height: 100%; }
        .alloc-cap { font-size: 11px; color: #777; margin-bottom: 12px; }

        table.pf { width: 100%; border-collapse: collapse; font-size: 13px; }
        table.pf th { text-align: right; font-size: 11px; color: #777; padding: 6px 8px; border-bottom: 2px solid #e0e0e0; cursor: pointer; user-select: none; white-space: nowrap; }
        table.pf th:first-child, table.pf td:first-child { text-align: left; }
        table.pf th.sorted { color: #1565c0; }
        table.pf td { text-align: right; padding: 7px 8px; border-bottom: 1px solid #f0f0f0; white-space: nowrap; }
        table.pf tr:hover td { background: #f7fbff; }
        table.pf td.tk { font-weight: bold; color: #1565c0; }
        table.pf td.nm { max-width: 220px; overflow: hidden; text-overflow: ellipsis; color: #555; font-weight: normal; }
        table.pf tr.cash td { background: #fbfbf6; font-style: italic; }
        table.pf tr.total td { border-top: 2px solid #e0e0e0; border-bottom: none; font-weight: bold; }

        /* тепловые мини-карточки в колонке «Тикер» (палитра как на тепловой карте) */
        .mini { display: flex; justify-content: space-between; align-items: stretch; gap: 6px;
                min-width: 150px; max-width: 200px; min-height: 44px; padding: 4px 7px; border-radius: 6px;
                color: #fff; font-size: 12px; line-height: 1.25; cursor: pointer;
                transition: filter .1s ease, transform .1s ease; -webkit-tap-highlight-color: transparent; }
        .mini:hover { filter: brightness(1.12); transform: scale(1.02); }
        .mini:focus-visible { outline: 2px solid #1565c0; outline-offset: -1px; }
        .mini-left { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; overflow: hidden; }
        .mini-right { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end; text-align: right; white-space: nowrap; }
        .mini-name { font-weight: bold; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .mini-price { font-size: 11px; opacity: .95; font-variant-numeric: tabular-nums; }
        .mini-change { font-size: 12px; font-weight: bold; font-variant-numeric: tabular-nums; }
        .mini-delta { font-size: 10px; opacity: .9; font-variant-numeric: tabular-nums; }
        .bg-pos-5 { background-color: #2e7d32; }
        .bg-pos-4 { background-color: #388e3c; }
        .bg-pos-3 { background-color: #43a047; }
        .bg-pos-2 { background-color: #81c784; color: #1a1a1a; }
        .bg-pos-1 { background-color: #c8e6c9; color: #1a1a1a; }
        .bg-neg-1 { background-color: #ef9a9a; color: #1a1a1a; }
        .bg-neg-2 { background-color: #e57373; color: #1a1a1a; }
        .bg-neg-3 { background-color: #d32f2f; }
        .bg-neg-4 { background-color: #c62828; }
        .bg-neg-5 { background-color: #8e0000; }
        .bg-neutral { background-color: #9e9e9e; color: #fff; }

        .note { font-size: 12px; color: #777; line-height: 1.5; margin-top: 12px; }
        .empty { border: 2px dashed #f9a825; background: #fffde7; border-radius: 8px; padding: 14px 16px; font-size: 13px; line-height: 1.6; color: #333; }
        .empty code { background: #f0f0f0; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
        @media (max-width: 760px) {
            table.pf td.nm { display: none; }
            table.pf th:nth-child(2) { display: none; }
            body { padding: 8px; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="index.html" id="stocksLink">Акции</a>
        <a href="bonds.html" id="bondsLink">Облигации</a>
        <a href="favorites.html" id="favLink">Избранное</a>
        <a href="news.html" id="newsLink">Новости</a>
        <a href="otc.html?type=ru" id="otcLink">Внебиржа</a>
        <a href="#" class="active">Портфель</a>
        <a href="#" id="logoutLink" class="logout">Выйти</a>
    </div>
    <div class="header">
        <strong>Портфель БКС</strong>
        <button id="reloadBtn" title="Перезагрузить данные">Обновить</button>
        <span id="status" class="status"></span>
    </div>
    <div id="root"></div>
    <div class="note">
        Данные выгружает GitHub Actions через БКС Trade API (токен «только для чтения») примерно каждые 30 минут
        в торговые часы и кладёт в <code>data/bcs_portfolio.json</code>. Это снимок, а не реальное время.
        Денежный остаток API отдаёт без вычета комиссии за сегодняшние сделки, поэтому может на копейки
        отличаться от приложения брокера.
    </div>
</div>
<script>
'use strict';
//@import shared/core.js

const VERSION = 'v1';
const DATA_URL = 'data/bcs_portfolio.json';
const AUTO_RELOAD_MS = 5 * 60 * 1000;

const statusEl = document.getElementById('status');
const root = document.getElementById('root');
const { mk, fetchJson, fmtNum, fmtRub, fmtMoney, fmtPct, fmtSignedRub, fmtQty, humanDateTime, plClass, setStatus } = Core;

let sortKey = 'share';
let sortDir = -1;
let lastData = null;

const COLS = [
    { key: 'ticker',   label: 'Тикер' },
    { key: 'name',     label: 'Название' },
    { key: 'qty',      label: 'Кол-во' },
    { key: 'avg',      label: 'Ср. цена' },
    { key: 'price',    label: 'Цена' },
    { key: 'value',    label: 'Стоимость' },
    { key: 'share',    label: 'Доля, %' },
    { key: 'pl',       label: 'P/L, ₽' },
    { key: 'plPct',    label: 'P/L, %' },
    { key: 'dailyPct', label: 'За день, %' }
];

function positionRow(p) {
    return {
        ticker: p.ticker || '?',
        name: p.displayName || '',
        qty: p.quantity,
        avg: p.balancePrice,
        price: p.currentPrice,
        value: p.currentValueRub,
        share: p.portfolioShare,
        pl: p.unrealizedPL,
        plPct: p.unrealizedPercentPL,
        dailyPct: p.dailyPercentPL,
        currency: p.currency || 'RUB',
        type: p.instrumentType || p.upperType || ''
    };
}

function statCard(label, valueHtml, subHtml) {
    const el = mk('div', 'stat');
    el.append(mk('div', 'lbl', label));
    const v = mk('div', 'val'); v.innerHTML = valueHtml; el.append(v);
    if (subHtml) { const s = mk('div', 'sub'); s.innerHTML = subHtml; el.append(s); }
    return el;
}

function renderSummary(d) {
    const cards = mk('div', 'cards');
    const s = d.summary || {};
    cards.append(statCard('Оценка портфеля', fmtMoney(s.currentValueRub),
        s.accountName ? String(s.accountName) : ''));
    const dRub = s.dailyChangeRub, dPct = s.dailyChangePct;
    cards.append(statCard('Изменение за день',
        `<span class="${plClass(dRub)}">${fmtSignedRub(dRub)}</span>`,
        `<span class="${plClass(dPct)}">${fmtPct(dPct)}</span>`));
    const tRub = s.totalChangeRub, tPct = s.totalChangePct;
    cards.append(statCard('За всё время',
        `<span class="${plClass(tRub)}">${fmtSignedRub(tRub)}</span>`,
        `<span class="${plClass(tPct)}">${fmtPct(tPct)}</span>`));
    const cash = (d.cash || []).filter(c => c && Number.isFinite(c.sum));
    const cashRub = cash.filter(c => c.currency === 'RUB' || c.currency === 'SUR').reduce((a, c) => a + c.sum, 0);
    const other = cash.filter(c => c.currency !== 'RUB' && c.currency !== 'SUR');
    cards.append(statCard('Свободные деньги', fmtMoney(cashRub),
        other.map(c => `${fmtNum(c.sum)} ${c.currency}`).join(' · ') || ''));
    if (s.stabilityStatus) {
        cards.append(statCard('Устойчивость счёта', String(s.stabilityStatus),
            s.marginOn ? 'Маржинальная торговля включена' : 'Без маржиналки'));
    }
    return cards;
}

function renderAlloc(rows) {
    const box = mk('div');
    const bar = mk('div', 'alloc');
    const HUES = [210, 120, 30, 280, 0, 180, 330, 60, 240, 90];
    const top = rows.filter(r => Number.isFinite(r.share) && r.share > 0)
        .sort((a, b) => b.share - a.share).slice(0, 10);
    top.forEach((r, i) => {
        const seg = document.createElement('span');
        seg.style.width = r.share + '%';
        seg.style.background = `hsl(${HUES[i % HUES.length]},55%,45%)`;
        seg.title = `${r.ticker}: ${fmtNum(r.share, 1)} %`;
        bar.append(seg);
    });
    box.append(bar);
    box.append(mk('div', 'alloc-cap', 'Структура портфеля: ' +
        top.slice(0, 5).map(r => `${r.ticker} ${fmtNum(r.share, 1)} %`).join(' · ') + (top.length > 5 ? ' · …' : '')));
    return box;
}

function compare(a, b, key) {
    const x = a[key], y = b[key];
    if (typeof x === 'string' || typeof y === 'string') return String(x).localeCompare(String(y), 'ru');
    const nx = Number.isFinite(x) ? x : -Infinity, ny = Number.isFinite(y) ? y : -Infinity;
    return nx - ny;
}

/* ---------- тепловые мини-карточки тикеров ---------- */

let miniCards = {};

/* шкала цвета — как на тепловой карте акций */
function getBgClass(change) {
    if (!Number.isFinite(change) || Math.round(change * 100) / 100 === 0) return 'bg-neutral';
    const abs = Math.abs(change);
    const level = abs >= 5 ? 5 : abs >= 2 ? 4 : abs >= 1 ? 3 : abs >= 0.5 ? 2 : 1;
    return (change > 0 ? 'bg-pos-' : 'bg-neg-') + level;
}

/* куда ведёт клик: та же карточка бумаги, что и на страницах «Акции»/«Облигации» (?open=) */
function targetFor(r) {
    if (r.type === 'STOCK') return `index.html?open=${encodeURIComponent(r.ticker)}`;
    if (r.type === 'BONDS') return `bonds.html?open=${encodeURIComponent(r.ticker)}`;
    if (r.type && r.type.startsWith('OTC')) return 'otc.html?type=foreign'; // БКС-внебиржа, своей модалки нет
    return null;
}

function buildMiniCard(r) {
    if (r.type === 'CURRENCY') return null;
    const url = targetFor(r);
    const card = mk('div', 'mini ' + getBgClass(r.dailyPct));
    card.tabIndex = 0;
    card.setAttribute('role', 'button');
    card.title = `${r.name || r.ticker} — открыть карточку бумаги`;

    const left = mk('div', 'mini-left');
    const nameEl = mk('div', 'mini-name', r.ticker);
    nameEl.title = `${r.name} (${r.ticker})`;
    const priceEl = mk('div', 'mini-price', fmtNum(r.price));
    left.append(nameEl, priceEl);

    const right = mk('div', 'mini-right');
    const changeEl = mk('div', 'mini-change', fmtPct(r.dailyPct));
    const deltaEl = mk('div', 'mini-delta', '');
    right.append(changeEl, deltaEl);
    card.append(left, right);

    if (url) {
        const go = () => { location.href = url; };
        card.addEventListener('click', go);
        card.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
        });
    }
    miniCards[r.ticker] = { card, priceEl, changeEl, deltaEl };
    return card;
}

/* БКС отдаёт dailyPL = 0 вне сессии — дотягиваем живое изменение за день с MOEX ISS
   (только биржевые бумаги: акции TQBR, облигации TQRD; внебиржа БКС на ISS отсутствует). */
async function enrichFromMoex(rows) {
    const COLS = 'SECID,LAST,CHANGE,LASTTOPREVPRICE';
    const groups = [
        ['shares', 'TQBR', rows.filter(r => r.type === 'STOCK').map(r => r.ticker)],
        ['bonds', 'TQRD', rows.filter(r => r.type === 'BONDS').map(r => r.ticker)]
    ];
    for (const [market, board, tickers] of groups) {
        if (!tickers.length) continue;
        try {
            const url = `https://iss.moex.com/iss/engines/stock/markets/${market}/boards/${board}/securities.json` +
                `?iss.meta=off&iss.only=marketdata&marketdata.columns=${COLS}` +
                `&securities=${tickers.map(encodeURIComponent).join(',')}`;
            const data = await Core.fetchJson(url, { retries: 1, timeout: 10000 });
            const idx = Object.fromEntries(data.marketdata.columns.map((c, i) => [c, i]));
            for (const md of data.marketdata.data || []) {
                const els = miniCards[md[idx.SECID]];
                if (!els) continue;
                const price = md[idx.LAST], pct = md[idx.LASTTOPREVPRICE], delta = md[idx.CHANGE];
                if (Number.isFinite(price)) els.priceEl.textContent = fmtNum(price);
                els.changeEl.textContent = Number.isFinite(pct) ? fmtPct(pct) : '—';
                els.deltaEl.textContent = Number.isFinite(delta) && delta !== 0
                    ? (delta > 0 ? '+' : '−') + fmtNum(Math.abs(delta)) : '';
                els.card.className = 'mini ' + getBgClass(pct);
            }
        } catch (e) { /* ISS недоступен — карточки остаются нейтральными */ }
    }
}

function renderTable(rows) {
    miniCards = {};
    const table = mk('table', 'pf');
    const head = mk('tr');
    COLS.forEach(c => {
        const th = mk('th', c.key === sortKey ? 'sorted' : '', c.label + (c.key === sortKey ? (sortDir < 0 ? ' ↓' : ' ↑') : ''));
        th.addEventListener('click', () => {
            if (sortKey === c.key) sortDir = -sortDir; else { sortKey = c.key; sortDir = -1; }
            render(lastData);
        });
        head.append(th);
    });
    table.append(head);

    const sorted = rows.slice().sort((a, b) => sortDir * compare(a, b, sortKey));
    let totVal = 0, totPl = 0;
    sorted.forEach(r => {
        if (Number.isFinite(r.value)) totVal += r.value;
        if (Number.isFinite(r.pl)) totPl += r.pl;
        const isCur = r.type === 'CURRENCY'; // деньгам — копейки, а не округление
        const tr = mk('tr');
        const tkTd = mk('td', 'tk');
        const mini = buildMiniCard(r);
        if (mini) tkTd.append(mini); else tkTd.textContent = r.ticker;
        tr.append(tkTd);
        tr.append(mk('td', 'nm', r.name));
        tr.append(mk('td', null, isCur ? fmtNum(r.qty, 2) : fmtQty(r.qty)));
        tr.append(mk('td', null, fmtNum(r.avg)));
        tr.append(mk('td', null, fmtNum(r.price)));
        tr.append(mk('td', null, fmtRub(r.value, isCur ? 2 : 0)));
        tr.append(mk('td', null, fmtNum(r.share, 1)));
        tr.append(mk('td', plClass(r.pl), fmtSignedRub(r.pl)));
        tr.append(mk('td', plClass(r.plPct), fmtPct(r.plPct)));
        tr.append(mk('td', plClass(r.dailyPct), fmtPct(r.dailyPct)));
        table.append(tr);
    });

    if (sorted.length) {
        const tr = mk('tr', 'total');
        tr.append(mk('td', null, 'Итого'));
        tr.append(mk('td'));
        tr.append(mk('td')); tr.append(mk('td')); tr.append(mk('td'));
        tr.append(mk('td', null, fmtRub(totVal, 0)));
        tr.append(mk('td', null, '100'));
        tr.append(mk('td', plClass(totPl), fmtSignedRub(totPl)));
        tr.append(mk('td')); tr.append(mk('td'));
        table.append(tr);
    }
    return table;
}

function renderEmpty(err) {
    const box = mk('div', 'empty');
    box.innerHTML =
        '<b>Данные портфеля пока не выгружены.</b><br>' +
        (err ? `Ошибка загрузки: ${String(err.message || err)}.<br>` : '') +
        'Чтобы страница ожила:<br>' +
        '1. Выпустите в «БКС Мир инвестиций» токен API <b>«только для чтения»</b> (Профиль → счёт → Токены API).<br>' +
        '2. Добавьте его в секреты репозитория: Settings → Secrets and variables → Actions → <code>BCS_API_KEY_READ</code>.<br>' +
        '3. Запустите workflow <b>BCS API</b> вручную (Actions → BCS API → Run workflow) или дождитесь расписания.<br>' +
        '4. Для автообновления токена при ротации добавьте секрет <code>GH_PAT</code> (personal access token с правом на изменение секретов репозитория).<br>' +
        '5. Чтобы данные портфеля не лежали в открытом виде, добавьте секреты <code>MX_LOGIN</code> и <code>MX_PASSWORD</code> ' +
        '(те же, что у страниц) — workflow будет шифровать JSON, а страница расшифрует его после входа.';
    return box;
}

function render(d) {
    lastData = d;
    root.replaceChildren();
    if (!d || !Array.isArray(d.positions)) { root.append(renderEmpty(null)); return; }
    root.append(renderSummary(d));
    const rows = d.positions.map(positionRow);
    if (!rows.length && !(d.cash || []).length) { root.append(renderEmpty(null)); return; }
    root.append(renderAlloc(rows));
    root.append(renderTable(rows));
    enrichFromMoex(rows); // подкрасит мини-карточки живым изменением за день
    if (Number.isFinite(d.tokenExpiresInDays)) {
        const note = mk('div', 'note');
        const cls = d.tokenExpiresInDays < 10 ? 'neg' : '';
        note.innerHTML =
            `Refresh-токен БКС протухнет примерно через <span class="${cls}">${d.tokenExpiresInDays} дн.</span> — ` +
            'перевыпустите его в личном кабинете и обновите секрет <code>BCS_API_KEY_READ</code>.';
        root.append(note);
    }
}

/* Данные могут быть зашифрованы тем же ключом, что и страницы (AES-256-GCM,
   ключ от пароля уже лежит в sessionStorage после входа). Открытый JSON тоже поддерживаем. */
function fromB64(s) { const b = atob(s), a = new Uint8Array(b.length); for (let i = 0; i < b.length; i++) a[i] = b.charCodeAt(i); return a; }

async function fetchPortfolioData(manual) {
    const r = await Core.fetchWithTimeout(`${DATA_URL}?t=${Date.now()}`, { timeout: 12000 });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const text = (await r.text()).trim();
    if (text.startsWith('{')) return JSON.parse(text); // открытый JSON (шифрование выключено)

    const keyB64 = sessionStorage.getItem('mx_k');
    if (!keyB64) throw new Error('данные зашифрованы — выйдите и войдите под своим паролем ещё раз');
    const key = await crypto.subtle.importKey('raw', fromB64(keyB64), 'AES-GCM', false, ['decrypt']);
    const bytes = fromB64(text.replace(/\s+/g, ''));
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes.slice(0, 12) }, key, bytes.slice(12));
    return JSON.parse(new TextDecoder().decode(plain));
}

async function load(manual) {
    setStatus(statusEl, 'loading', 'Загрузка данных портфеля...');
    try {
        let d = null, lastErr = null;
        for (let i = 0; i <= (manual ? 1 : 2); i++) {
            try { d = await fetchPortfolioData(manual); break; }
            catch (e) { lastErr = e; if (i < 2) await new Promise(res => setTimeout(res, 800 * (i + 1))); }
        }
        if (!d) throw lastErr;
        render(d);
        setStatus(statusEl, 'ok', `Обновлено: ${humanDateTime(d.updated)} · ${VERSION}`);
    } catch (e) {
        root.replaceChildren(renderEmpty(e));
        setStatus(statusEl, 'error', 'Нет данных: ' + (e.message || e));
    }
}

document.getElementById('reloadBtn').addEventListener('click', () => load(true));
document.getElementById('logoutLink').addEventListener('click', e => {
    e.preventDefault();
    try { new BroadcastChannel('mx_auth').postMessage({ t: 'logout' }); } catch (_) { /* ignore */ }
    try { sessionStorage.removeItem('mx_k'); } catch (_) { /* ignore */ }
    location.reload();
});

load(false);
setInterval(() => load(false), AUTO_RELOAD_MS);
</script>
</body>
</html>
